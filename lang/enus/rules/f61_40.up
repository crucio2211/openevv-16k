# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule normalize_eng_letters takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local h_rcx
  place p104c87
  place p104cca
  place p104cfd
  set h_rcx to -6
  call get_parm addr c140 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c130 arg 2 h_rcx
  call push_ptr_init addr c100
  call push_ptr_init addr c110
  call push_ptr_init addr c120
  call fence 0 sym eti_null
  call startloop 1
  call copyvar addr c100 addr c140
  call copyvar addr c120 addr c130
  call forall_to_test addr c100 addr c120
  if answer is not 0
    go to p104f6b
  end
  place p104da9
  place t104da9_11 on 11
  call bspush_ca 3
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p104f6b
  end
  place p104dce
  call bspush_ca_scan 4
  set h_rcx to 5
  call testFldeq 1 0 h_rcx
  if answer is not 0
    go to p104f6b
  end
  place p104df1
  place t104df1_5 on 5
  call advance_tok
  if answer is not 0
    go to p104f6b
  end
  place p104e01
  place t104e01_7 on 7
  call savescptr 7 addr c110
  place p104e13
  place t104e13_2 on 2
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p104e45
  end
  place p104e29
  set h_rcx to sym eti_s_1be01c
  call test_string_s 1 1 h_rcx
  if answer is 0
    go to p104f1d
  end
  place p104e45
  place t104e45_8 on 8
  call starttest 10
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p104eb4
  end
  place p104e66
  set h_rcx to sym eti_s_1be01d
  call test_string_s 1 1 h_rcx
  if answer is not 0
    go to p104eb4
  end
  place p104e7e
  call lpta_rpta_loadp addr c100 addr c110
  set h_rcx to sym eti_s_1be01e
  call insert_2pt_s 1 2 h_rcx 0
  if answer is 0
    go to p104f3e
  end
  place p104eb4
  place t104eb4_10 on 10
  call starttest 3
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p104f3e
  end
  place p104ed5
  set h_rcx to sym eti_s_1be020
  call test_string_s 1 1 h_rcx
  if answer is not 0
    go to p104f3e
  end
  place p104eed
  call lpta_rpta_loadp addr c100 addr c110
  set h_rcx to sym eti_s_1be021
  call insert_2pt_s 1 2 h_rcx 0
  go to p104f3e
  place p104f1d
  call starttest_e 9
  call mark_u_con addr c100 addr c110
  place p104f3e
  place t104f3e_3 on 3
  place t104f3e_9 on 9
  set h_rcx to addr c120
  set h_rcx to 11
  call forto_adv_r 1 2 h_rcx 1 addr c100 addr c120
  if answer is 0
    match
  end
  place p104f6b
  set unwind to 0
  backtrack
  place p104faa
  place t104faa_4 on 4
  call bspush_ca_scan 6
  set h_rcx to 143
  go to p104fd1
  place p104fc5
  place t104fc5_6 on 6
  set h_rcx to 145
  place p104fd1
  call testFldeq 1 0 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p104fda
  go to p104df1
  place tm_1 on 1
  match
end

rule mark_u_con takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_rcx
  local h_rdx
  local s10514a
  local s105209
  place p105048
  place p105087
  go to p1050ed
  place p1050b6
  place t1050b6_5 on 5
  set h_rcx to 94
  give up
  place p1050ed
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c110 h_rdx h_rcx
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c120 h_rdx h_rcx
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  call starttest 1
  set h_rdx to 1
  call lpta_loadp addr c110
  call setscan_l h_rdx
  set s10514a to answer
  set h_rcx to 0
  if s10514a is not 0
    match
  end
  place p105159
  place p105167
  place t105167_2 on 2
  set h_rdx to addr c100
  call savescptr 2 h_rdx
  set h_rdx to 1
  set h_rcx to sym eti_s_1be023
  call test_string_s 1 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p105196
  set h_rdx to 1
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1051ac
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1051b8
  call bspush_ca_scan 3
  set h_rdx to 4
  set h_rcx to 1
  place p1051cf
  call testFldeq 1 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1051d8
  place t1051d8_4 on 4
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1051e4
  set h_rdx to addr c120
  call lpta_rpta_loadp addr c110 h_rdx
  set h_rdx to 4
  set h_rcx to 2
  call mark_s 1 h_rdx h_rcx 0
  set s105209 to answer
  set h_rcx to 0
  if s105209 is 0
    match
  end
  set unwind to 0
  backtrack
  place p105247
  place t105247_3 on 3
  set h_rdx to 0
  set h_rcx to 30
  go to p1051cf
  place p105258
  place t105258_1 on 1
  set h_rcx to 0
  match
end

