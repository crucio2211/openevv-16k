# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule generate_durations takes 1
  instead
  place pa61f
  place pa652
  place pa681
  call fence 0 sym eti_null
  call insert_transitions
  call insert_pause_durs
  call find_nucleus
  call find_acoustic_nuc
  call assign_phone_durs
  call set_syll_offset_vals
  match
end

rule insert_transitions takes 1
  instead
  local cf0 bytes 8
  local c128 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local v110 word
  local v118 word
  local v130 word
  variable g300 word 420
  variable g310 word 428
  variable g404 word 600
  variable g4c8 word 708
  variable g4d8 word 716
  variable g578 word 796
  variable g628 word 884
  variable g638 word 892
  variable g648 word 900
  variable g658 word 908
  place pa6e8
  place pa721
  place pa787
  set cell cf0 kind to 65532
  call push_ptr_init addr c150
  call push_ptr_init addr c140
  call push_ptr_init addr c128
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  set vf8 to addr g300
  set cell c150 value to global word 424
  set cell c140 value to global word 432
  set v118 to addr g310
  call lpta_loadpn addr g310
  call rpta_loadpn addr g4d8
  call compare_ptas
  if answer is not 0
    go to pa86f
  end
  place pa828
  call testneq
  if answer is not 0
    go to pa86f
  end
  place pa834
  call lpta_loadp addr g310
  call setscan_r 7
  if answer is not 0
    go to pa86f
  end
  place pa84a
  call advanc
  if answer is not 0
    go to pa86f
  end
  place pa856
  go to pa85d
  place pa85d
  place ta85d_2 on 2
  call savescptr 2 addr c140
  place pa86f
  set v130 to addr g4c8
  set v110 to addr g648
  set v108 to addr g404
  set v100 to addr g658
  place pa8c0
  place ta8c0_1 on 1
  call lpta_loadpn addr g300
  call rpta_loadpn addr g4c8
  call compare_ptas
  if answer is not 0
    go to paa11
  end
  place pa8ee
  call testeq
  if answer is not 0
    go to paa11
  end
  place pa8fe
  set cell c150 value to global word 800
  call starttest 3
  call lpta_loadp addr g300
  call setscan_r 2
  if answer is not 0
    go to paa11
  end
  place pa931
  place ta931_4 on 4
  call savescptr 4 addr c128
  call testFldeq 2 10 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pa95c
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pa96c
  call lpta_loadp addr c128
  call setscan_l 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pa986
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pa996
  call lpta_loadp addr g578
  call test_ptr
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pa9c0
  place ta9c0_5 on 5
  call savescptr 5 addr g648
  call get_h_dur addr g648 addr g300 addr cf0
  place pa9f1
  place ta9f1_6 on 6
  call insert_dur addr cf0 addr g648 addr g300 addr g404
  place paa11
  place taa11_3 on 3
  call startloop 7
  call lpta_loadpn addr c150
  call lpta_mover 2
  call lpta_storep addr g628
  call lpta_loadpn addr c140
  call lpta_mover 2
  call lpta_storep addr c128
  call forall_to_test addr g628 addr c128
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place paa8a
  place taa8a_15 on 15
  call bspush_ca 9
  call lpta_loadp addr g628
  call setscan_r 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place paaab
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place paabb
  place taabb_10 on 10
  call savescptr 10 addr g638
  place paac9
  place taac9_8 on 8
  call lpta_loadp addr g638
  call setscan_r 2
  if answer is not 0
    go to paafe
  end
  place paadb
  call advanc
  if answer is not 0
    go to paafe
  end
  place paae7
  place taae7_12 on 12
  call savescptr 12 addr g658
  go to pabab
  place paafe
  place taafe_11 on 11
  call lpta_loadp addr g638
  call insert_r 2 1 sym eti_s_1b9058 0
  call rpta_storep addr g658
  call lpta_loadpn addr g638
  call rpta_loadpn addr g310
  call compare_ptas
  if answer is not 0
    go to pabab
  end
  place pab65
  call testeq
  if answer is not 0
    go to pabab
  end
  place pab71
  call lpta_loadp addr g638
  call rpta_loadp addr g658
  call proj_r 7
  place pabab
  place tabab_13 on 13
  call get_trans_dur addr cf0
  place pabb6
  place tabb6_14 on 14
  call starttest 9
  call insert_dur addr cf0 addr g638 addr g658 addr g404
  place pabdd
  place tabdd_9 on 9
  call forto_adv_upto_r 7 8 15 2 addr g628 addr c128
  if answer is 0
    go to pac3a
  end
  set unwind to 0
  backtrack
  place pac3a
  match
  place tm_7 on 7
  match
end

rule insert_pause_durs takes 1
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c108 bytes 8
  local c118 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c170 bytes 18
