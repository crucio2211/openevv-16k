  variable g320 word 436
  variable g340 word 452
  variable g350 word 460
  variable g658 word 908
  place pb3ec
  place pb421
  place pb481
  set cell cf0 kind to 65532
  call push_ptr_init addr c110
  set h_rax to answer
  set cf4 to 65532
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  if global half 3346 is 0
    go to pb4d5
  end
  place pb4bd
  place tb4bd_1 on 1
  set h_rax to global word 480
  set global word 456 to h_rax
  and 0 into global half 3346
