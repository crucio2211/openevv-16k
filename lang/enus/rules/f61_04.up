  place pb02a
  place tb02a_11 on 11
  set h_r14 to unwind
  set h_rcx to h_r14
  place pb02d
  set h_r14 to h_rcx
  call savescptr 11 addr c108
  set h_rax to answer
  set h_rcx to sym eti_s_1b905a
