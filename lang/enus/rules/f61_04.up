  place paee8
  place taee8_24 on 24
  set h_r14 to unwind
  set h_rcx to h_r14
  go to pae8b
  place paeed
  place taeed_5 on 5
  set h_r14 to unwind
  set h_rcx to h_r14
  place paef0
  set h_r14 to h_rcx
  call savescptr 5 addr c118
  set h_rax to answer
  place paf05
  place taf05_3 on 3
  set h_r14 to unwind
  and 0 into cell cf0 field
  call starttest 6
  set h_rax to answer
