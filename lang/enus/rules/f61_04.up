  end
  place pafa3
  set h_rcx to global half 2514
  set nafaa_0 to h_rcx
  shift left 16 into nafaa_0
  shift right 16 into nafaa_0
  set nafaa_1 to h_rax
  shift left 16 into nafaa_1
  shift right 16 into nafaa_1
  if nafaa_0 is at most nafaa_1
