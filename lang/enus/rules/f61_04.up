rule setdur takes 3
  instead
  local ce0 bytes 8
  local cf0 bytes 8
  local h_xmm0
  local sd4ec
  place pd3e8
  place pd421
  place pd47f
  call get_parm addr cf0 arg 1 -5
  call get_parm addr ce0 arg 2 -4
  call fence 0 sym eti_null
  set h_xmm0 to global word 2964
  scale h_xmm0 by cell cf0 value over 10000
  set global word 2964 to h_xmm0
  call npush_v addr cf0
  set h_xmm0 to 10000
  call npush_f h_xmm0
  call if_testgt
  set sd4ec to answer
  set h_xmm0 to cell ce0 field
  multiply 10000 into h_xmm0
  if sd4ec is 0
    go to pd523
  end
  place pd506
  if h_xmm0 is at least global word 2964
    match
  end
  place pd50c
  set global word 2964 to h_xmm0
  match
  place pd523
  if global word 2964 is less than h_xmm0
    go to pd50c
  end
  match
end

rule delete_voice_change_pause takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_r13
  local fd681
  place pd530
