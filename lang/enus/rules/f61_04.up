  and 0 into cell c128 half 0
  set c128 to -65528
  set cell cf0 kind to 65532
  call push_ptr_init addr c100
  set h_rax to answer
  call push_ptr_init addr c110
  set h_rax to answer
  call push_ptr_init addr c148
  set h_rax to answer
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  call startloop 1
  set h_rax to answer
