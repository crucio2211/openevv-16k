  set h_rax to answer
  call lpta_mover 8
  set h_rax to answer
  call lpta_storep addr c100
  set h_rax to answer
  call lpta_loadpn addr c138
  set h_rax to answer
  call lpta_mover 8
  set h_rax to answer
  call lpta_storep addr c148
  set h_rax to answer
  call forall_to_test addr c100 addr c148
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pd22d
  go to pd234
  place pd234
  place td234_7 on 7
  call bspush_ca 3
  set h_rax to answer
  call lpta_loadp addr c100
  call setscan_r 8
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pd259
  call npush_fld 8 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pd26e
  call npush_v addr geb4
  set h_rax to answer
  call if_testgt
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pd28d
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pd29d
  call savetok addr c128
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pd2b4
  place td2b4_4 on 4
  call savescptr 4 addr c110
  set h_rax to answer
  place pd2c6
  place td2c6_2 on 2
  call lpta_loadp addr c100
  call setscan_r 2
  set h_rax to answer
  if h_rax is not 0
    go to pd2f1
  end
  place pd2dc
  call advanc
  set h_rax to answer
  if h_rax is not 0
    go to pd2f1
  end
  place pd2e8
  set h_rax to global half 2522
  go to pd2f8
  place pd2f1
  place td2f1_5 on 5
  set h_rax to global half 2518
  place pd2f8
  set cell cf0 field to h_rax
  place pd302
  place td302_6 on 6
  call starttest 3
  set h_rax to answer
  and 0 into cell c128 field
  call npush_v addr c128
  set h_rax to answer
  call npush_v addr cf0
  set h_rax to answer
  call if_testgt
  set h_rax to answer
  if h_rax is not 0
    go to pd366
  end
  place pd33c
  call lpta_rpta_loadp addr c100 addr c110
  set h_rax to answer
  call insert_2ptv 8 addr cf0 0
  set h_rax to answer
  place pd366
  place td366_3 on 3
  call forto_adv_upto_r 1 2 7 8 addr c100 addr c148
  set h_rax to answer
