  set h_rax to answer
  place pb266
  place tb266_23 on 23
  set h_r14 to unwind
  call copyvar addr cf4 addr cf0
  set h_rax to answer
  place pb275
  place tb275_4 on 4
  set h_r14 to unwind
  set h_rcx to h_r14
