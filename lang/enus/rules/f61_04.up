  end
  place pb1a9
  go to pb307
  place pb1ae
  place tb1ae_16 on 16
  set h_r14 to unwind
  set h_rcx to h_r14
  place pb1b1
  set h_r14 to h_rcx
  call savescptr 16 addr c190
  set h_rax to answer
  place pb1c6
  place tb1c6_15 on 15
  set h_r14 to unwind
  call lpta_rpta_loadp addr c108 addr c190
  set h_rax to answer
  set h_rcx to addr geb0
  call mark_v 2 11 h_rcx 0
  set sb1eb to answer
  set h_rax to sb1eb
  set h_rcx to h_r14
  if h_rax is not 0
