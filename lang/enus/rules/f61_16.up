  call lpta_storep addr g588
  call lpta_loadpn addr c100
  call lpta_ctxtl 4
  call lpta_movel 4
  call lpta_storep addr g598
  call lpta_loadp addr g588
  call proj_def 5
  call lpta_loadp addr g598
  call proj_def 5
  match
end

