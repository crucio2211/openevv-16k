rule insert_phrase_pause takes 3
  instead
  local c108 bytes 8
  local c128 bytes 18
  local c138 bytes 8
  local vf8 word
  local h_r14
  variable gea8 word 2504
  place p2bf1c
  set h_r14 to arg 2
  place p2bf57
  place p2bfb7
  call get_parm addr c138 arg 1 -6
  call get_parm addr c108 arg 2 -6
  set cell c128 word 0 to 0
  set cell c128 word 4 to 0
  set cell c128 word 6 to 0
  set cell c128 word 10 to 0
  set c128 to -65534
  call fence 0 sym eti_null
  call fence 1 sym eti_s_1b90c3
  if global half 2506 is 0
    match
  end
  place p2c030
  set vf8 to addr gea8
  set h_r14 to 0
  place p2c053
  place t2c053_1 on 1
  set h_r14 to unwind
  call starttest 2
  call bspush_ca_boa 3
  call lpta_loadp addr c108
  call lpta_tstctxtl 2
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p2c08f
  call setscan_l 2
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p2c09e
  call testFldeq 2 0 51
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p2c0b2
  call testFldeq 2 4 8
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p2c0c7
  call advance_tok
  if answer is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place p2c0fb
  place t2c0fb_3 on 3
  set h_r14 to unwind
  call bspop_boa
  call lpta_rpta_loadp addr c138 addr c108
  call settvar_s addr c128 51
  set cell c128 field to 11
  call copyvar addr c128 addr gea8
  call insert_2ptv 2 addr c128 0
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p2c156
  go to p2c16e
  place p2c16e
  place t2c16e_2 on 2
  set h_r14 to unwind
  set global half 2506 to global half 2224
  match
end

rule reset_phrase_vars takes 1
  instead
  variable gab0 word 1572
  variable gcc8 word 2108
  variable gcd0 word 2112
  place p2c190
