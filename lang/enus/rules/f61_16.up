  call set_phrase_defaults addr gab0
  match
end

rule assign_unpuncted_phr_vals takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  variable gcd0 word 2112
  place p2c27a
  place p2c2b3
  place p2c311
  call get_parm addr cf0 arg 1 -6
