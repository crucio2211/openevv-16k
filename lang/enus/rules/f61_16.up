# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule build_phrases takes 3
  instead
  local c108 bytes 8
  local c118 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local vf8 word
  local v120 word
  local h_r14
  local h_rsi
  local s2524a
  local s25272
  local s25285
  local s252ec
  variable g578 word 796
  variable g588 word 804
  variable g598 word 812
  place p24f3c
  place p24f77
  place p24fd7
  set h_r14 to addr c118
  set h_rsi to addr c118
  call get_parm h_rsi arg 1 -6
  set h_rsi to addr c140
  call get_parm h_rsi arg 2 -6
  set h_rsi to addr c108
  call push_ptr_init h_rsi
  set h_rsi to addr c150
  call push_ptr_init h_rsi
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to addr g578
  call lpta_loadpn h_rsi
  set h_rsi to addr c118
  call rpta_loadpn h_rsi
  set h_rsi to 4
  call rpta_ctxtl h_rsi
  call compare_ptas
  if answer is not 0
    go to p2508b
  end
  place p2507b
  call testeq
  if answer is 0
    give up
  end
  place p2508b
  set vf8 to addr g588
  set v120 to addr g598
  set h_rsi to 2
  set h_r14 to 0
  place p250bc
  call starttest h_rsi
  set h_rsi to 3
  call bspush_ca_boa h_rsi
  call lpta_loadp addr c118
  set h_rsi to 5
  call lpta_tstctxtl h_rsi
  if answer is not 0
    go to p25124
  end
  place p250f8
  set h_rsi to 5
  call lpta_tstmovel h_rsi
  if answer is not 0
    go to p25124
  end
  place p25107
  set h_rsi to 4
  call setscan_r h_rsi
  if answer is not 0
    go to p25124
  end
  place p25116
  call advance_tok
  if answer is 0
    set h_r14 to 1
  end
  place p25124
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place p25160
  place t25160_2 on 2
  set h_r14 to unwind
  if global signed half 1634 is more than global signed half 1566
    go to p25186
  end
  place p25170
  set h_rsi to addr c118
  call delimit_sentence h_rsi addr c140
  place p25186
  place t25186_4 on 4
  set h_r14 to unwind
  set h_rsi to addr c118
  call delimit_major_phrase h_rsi
  place p25195
  place t25195_5 on 5
  set h_r14 to unwind
  call mark_word_categories
  place p2519d
  place t2519d_6 on 6
  set h_r14 to unwind
  call apply_comma_phr_rules
  place p251a5
  place t251a5_7 on 7
  set h_r14 to unwind
  set h_rsi to addr c118
  call insert_major_phrase h_rsi addr c140
  place p251bb
  place t251bb_8 on 8
  set h_r14 to unwind
  if global half 3650 is global half 3626
    go to p252fc
  end
  place p251cf
  if global half 3662 is global half 3626
    go to p252fc
  end
  place p251dc
  set h_rsi to 9
  call startloop h_rsi
  set h_rsi to addr g588
  call lpta_loadpn h_rsi
  set h_rsi to 5
  call lpta_mover h_rsi
  set h_rsi to addr c108
  call lpta_storep h_rsi
  set h_rsi to addr g598
  call lpta_loadpn h_rsi
  set h_rsi to 5
  call lpta_mover h_rsi
  set h_rsi to addr c130
  call lpta_storep h_rsi
  set h_rsi to addr c108
  call forall_to_test h_rsi addr c130
  set s2524a to answer
  set h_rsi to h_r14
  if s2524a is not 0
    set unwind to h_rsi
    backtrack
  end
  place p2525a
  place t2525a_13 on 13
  set h_r14 to unwind
  set h_rsi to 11
  call bspush_ca h_rsi
  set h_rsi to addr c108
  call lpta_loadp h_rsi
  call setscan_r 5
  set s25272 to answer
  set h_rsi to h_r14
  if s25272 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p25282
  call advance_tok
  set s25285 to answer
  set h_rsi to h_r14
  if s25285 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p25295
  place t25295_12 on 12
  set h_r14 to unwind
  set h_rsi to 12
  call savescptr h_rsi addr c150
  place p252a7
  place t252a7_10 on 10
  set h_r14 to unwind
  set h_rsi to 11
  call starttest h_rsi
  set h_rsi to addr c108
  call adjust_words_in_phrase h_rsi addr c150
  place p252c8
  place t252c8_11 on 11
  set h_r14 to unwind
  set h_rsi to 9
  call forto_adv_upto_r h_rsi 10 13 5 addr c108 addr c130
  set s252ec to answer
  set h_rsi to h_r14
  if s252ec is not 0
    set unwind to h_rsi
    backtrack
  end
  place p252fc
  place t252fc_9 on 9
  set h_r14 to unwind
  set h_rsi to 14
  call starttest h_rsi
  set h_rsi to addr c140
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    match
  end
  place p2531d
  place t2531d_16 on 16
  set h_r14 to unwind
  set h_rsi to 15
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_1b90b8
  if answer is 0
    go to p2531d
  end
  place p2533d
  go to p25124
  place p25342
  place t25342_1 on 1
  set h_r14 to unwind
  set h_rsi to 2
  go to p250bc
  place p2534a
  place t2534a_3 on 3
  set h_r14 to unwind
  call bspop_boa
  give up
  place p25357
  place t25357_15 on 15
  set h_r14 to unwind
  set h_rsi to 15
  call savescptr h_rsi addr g588
  match
  place tm_14 on 14
  match
end

rule delimit_sentence takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  variable g4c8 word 708
  variable g4d8 word 716
  variable g4e8 word 724
  place p253c0
  place p253fb
  place p2545b
  call get_parm addr c130 arg 1 -6
  call get_parm addr c120 arg 2 -6
  call push_ptr_init addr c110
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  set global half 1460 to 1
  call lpta_loadpn addr c130
  call lpta_ctxtl 4
  call lpta_movel 4
  call lpta_storep addr g4d8
  call lpta_loadpn addr g4c8
  call lpta_mover 4
  call lpta_storep addr g4c8
  call lpta_loadp addr g4c8
  call proj_def 5
  call lpta_loadp addr g4d8
  call proj_def 5
  set global word 728 to cell c120 value
  call lpta_loadp addr c120
  call proj_def_mult 8 sym eti_s_1b90b9 addr g4e8
  call starttest 1
  call bspush_ca_boa 2
  call lpta_loadp addr g4e8
  call setscan_l 0
  if answer is 0
    set unwind to 1
  end
  if answer is not 0
    set unwind to 0
  end
  backtrack
  place p2560b
  place t2560b_2 on 2
  call bspop_boa
  call divide_char_count_token addr g4e8
  place p2561e
  place t2561e_1 on 1
  set global word 760 to global word 2320
  set global word 768 to global word 2320
  set cell c110 value to global word 2320
  set cell c100 value to global word 2320
  match
end

rule delimit_major_phrase takes 2
  instead
  local c100 bytes 8
  variable g588 word 804
  variable g598 word 812
  place p25655
  place p25695
  place p256c8
  call get_parm addr c100 arg 1 -6
