  place p11fc9
  set n11fc9_1 to h_rax
  and 65535 into n11fc9_1
  if global half 2296 is not n11fc9_1
    go to p11fda
  end
  place p11fd2
  call nucl_high_star_low_tone
  set h_rax to answer
  place p11fda
  place t11fda_4 on 4
  place t11fda_5 on 5
  place t11fda_7 on 7
  place t11fda_9 on 9
  place t11fda_11 on 11
  place t11fda_13 on 13
  place t11fda_14 on 14
  call starttest 15
  set h_rax to answer
  call lpta_loadp addr g280
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p12086
  end
  place p11ffb
  set h_rcx to 1
  call testFldeq 4 9 h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p12010
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p1201c
  call starttest_l 15
  set h_rax to answer
  call move_i addr cf0 3
  set h_rax to answer
  call modulate_pwind addr cf0
  set h_rax to answer
  if h_rax is 0
    go to p12086
  end
  set unwind to 0
  backtrack
  place p12086
  place t12086_15 on 15
  set h_rax to global word 432
  set global word 496 to h_rax
  match
end

rule first_postnucl_accent takes 1
  instead
  local h_rax
  local n121d8_0
  place p1210c
  place p12145
  place p12178
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to global half 554
  if h_rax is not global half 526
    give up
  end
  place p12199
  place p121ab
  place t121ab_1 on 1
  set h_rax to global half 590
  if h_rax is global half 510
    give up
  end
  place p121bb
  place t121bb_2 on 2
  call starttest 3
  set h_rax to answer
  call bspush_ca 4
  set h_rax to answer
  set h_rax to global half 3630
  place p121d8
  set n121d8_0 to h_rax
  and 65535 into n121d8_0
  if n121d8_0 is global half 3626
    go to p12243
  end
  set unwind to 0
  backtrack
  place p1220d
  place t1220d_4 on 4
  set h_rax to global half 3642
  go to p121d8
  place p12243
  place t12243_5 on 5
  call eng_first_postnucl_accent
  set h_rax to answer
  match
  place tm_3 on 3
  place tm_6 on 6
  match
end

