# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule generate_intonation takes 1
  instead
  place p11528
  place p1155d
  place p115bd
  call fence 0 sym eti_null
  if global half 514 is not 1
    go to p115e0
  end
  place p115d8
  call add_f0_for_new_voice
  place p115e0
  place p115f2
  place t115f2_1 on 1
  if global half 518 is not 1
    go to p11604
  end
  place p115fc
  call init_phrase_inton_vars
  place p11604
  place t11604_2 on 2
  if global half 514 is not 1
    go to p11616
  end
  place p1160e
  call init_word_inton_vars
  place p11616
  place t11616_3 on 3
  call init_syll_inton_vars
  place p1161e
  place t1161e_4 on 4
  if global half 518 is not 1
    go to p11630
  end
  place p11628
  call phr_initial_F0
  place p11630
  place t11630_5 on 5
  call is_target_syll
  if answer is not 0
    go to p116de
  end
  place p11640
  if global half 550 is global half 526
    go to p1171d
  end
  place p11654
  place t11654_7 on 7
  call starttest 9
  call bspush_ca 10
  if global half 554 is global half 526
    go to p116d6
  end
  set unwind to 0
  backtrack
  place p116aa
  place t116aa_10 on 10
  if global half 1570 is not global half 2244
    set unwind to 0
    backtrack
  end
  place p116ba
  go to p116d6
  place p116bc
  place t116bc_9 on 9
  if global half 542 is not global half 526
    go to p116d6
  end
  place p116cc
  call prenucl_f0
  go to p116de
  place p116d6
  place t116d6_11 on 11
  place t116d6_13 on 13
  call postnucl_f0
  place p116de
  place t116de_6 on 6
  place t116de_8 on 8
  place t116de_12 on 12
  place t116de_14 on 14
  call first_postnucl_accent
  place p116e6
  place t116e6_15 on 15
  call insert_target_t3
  place p116ee
  place t116ee_16 on 16
  call insert_phrase_final_tones
  place p116f6
  place t116f6_17 on 17
  if global half 1402 is not global half 502
    match
  end
  place p11706
  call add_f0_for_next_voice
  match
  place p1171d
  call nucl_f0
  go to p116de
  place tm_18 on 18
  match
end

rule add_f0_for_new_voice takes 1
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c118 bytes 8
  local v100 word
  local v108 word
  variable g1330 word 3372
  variable g1370 word 3424
  variable g300 word 420
  place p11774
  place p117ad
  place p11810
  call push_ptr_init addr c118
  set cf4 to 65532
  set cf0 to 65532
  call fence 0 sym eti_null
  call lpta_loadp addr g300
  call setscan_l 4
  if answer is not 0
    match
  end
  place p1185e
  call advance_tok
  if answer is not 0
    match
  end
  place p1186e
  set v108 to addr g300
  call starttest_l 1
  call bspush_ca 2
  set global half 3374 to 10
  set v100 to addr g1330
  call npush_v addr g1330
  set global half 3426 to 10
  call npush_v addr g1370
  call if_testneq
  if answer is not 0
    go to p1197e
  end
  place p118d8
  go to p118df
  place p118df
  place t118df_3 on 3
  call init_voice_vars
  place p118e7
  place t118e7_4 on 4
  call lpta_loadp addr g300
  call setscan_l 2
  if answer is not 0
    match
  end
  place p11901
  call test_string_s 2 1 sym eti_s_1b9060
  if answer is not 0
    match
  end
  place p1191e
  place t1191e_5 on 5
  call savescptr 5 addr c118
  call starttest_l 1
  call move_i addr cf4 95
  call move_i addr cf0 50
  call insert_f0 addr c118 addr cf4 addr cf0
  if answer is 0
    match
  end
  place p1197e
  set unwind to 0
  backtrack
  place p119b8
  place t119b8_2 on 2
  set global half 3374 to 9
  call npush_v addr g1330
  set global half 3426 to 9
  call npush_v addr g1370
  call if_testneq
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p119ee
  go to p118df
  place tm_1 on 1
  match
end

rule init_phrase_inton_vars takes 1
  instead
  local cf0 bytes 8
  variable g15c0 word 3808
  variable g278 word 328
  variable g5a8 word 820
  variable g5b8 word 828
  place p11a10
  place p11a43
  place p11aa1
  call push_ptr_init addr cf0
  call fence 0 sym eti_null
  set global half 706 to global half 1406
  set global half 390 to global half 542
  set global half 526 to global half 542
  and 0 into global half 3614
  or -1 into global half 3530
  set global half 3602 to 1
  set global half 3534 to 25
  set cell cf0 value to global word 832
  call estimate_nsylls addr g5a8 addr cf0 addr g15c0
  call init_voice_vars
  call init_nuclwrd_vars
  if global half 1570 is not global half 2244
    match
  end
  place p11b54
  call num_words_in_range addr g5a8 addr g5b8 addr g278
  match
end

rule init_word_inton_vars takes 1
  instead
  local h_rcx
  variable g280 word 332
  variable g788 word 1060
  place p11b82
  place p11baf
  place p11c07
  call fence 0 sym eti_null
  if global half 3642 is not global half 3626
    go to p11c36
  end
  place p11c28
  set global word 676 to global word 2320
  place p11c36
  set h_rcx to global half 558
  if global half 550 is not global half 390
    go to p11c56
  end
  place p11c4d
  set global half 390 to h_rcx
  match
  place p11c56
  if h_rcx is global half 390
    match
  end
  place p11c5b
  call lpta_loadpn addr g280
  call rpta_loadpn addr g788
  call compare_ptas
  if answer is not 0
    match
  end
  place p11c85
  call testeq
  if answer is 0
    go to p11ca0
  end
  match
  place p11ca0
  set h_rcx to global half 550
  go to p11c4d
end

rule init_syll_inton_vars takes 1
  instead
  local h_rcx
  place p11cae
  place p11cdb
  place p11d33
  call fence 0 sym eti_null
  set global word 660 to global word 2320
  set global word 668 to global word 2320
  set h_rcx to global half 526
  if global half 550 is not h_rcx
    go to p11d77
  end
  place p11d73
  set h_rcx to global half 554
  go to p11d99
  place p11d77
  if global half 554 is not h_rcx
    go to p11d85
  end
  place p11d7c
  set h_rcx to global half 558
  go to p11d99
  place p11d85
  if global half 550 is not global half 390
    match
  end
  place p11d8e
  set h_rcx to global half 550
  if global half 550 is not global half 530
    match
  end
  place p11d99
  set global half 526 to h_rcx
  match
end

rule is_target_syll takes 1
  instead
  place p11db4
  place p11de1
  place p11e10
  call fence 0 sym eti_null
  if global half 522 is not 1
    give up
  end
  place p11e2b
  if global half 550 is not global half 390
    match
  end
  place p11e3b
  if global half 550 is not global half 530
    give up
  end
  match
end

rule nucl_f0 takes 1
  instead
  local cf0 bytes 8
  local h_rax
  local h_rcx
  local n11f5b_1
  local n11f77_1
  local n11f93_1
  local n11faf_1
