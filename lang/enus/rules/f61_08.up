  place p11f9c
  call nucl_low_star_high_tone
  set h_rax to answer
  go to p11fda
  place p11fa6
  place t11fa6_10 on 10
  set h_rax to global half 2244
  place p11fad
  set h_rcx to h_rax
  set n11faf_1 to h_rax
  and 65535 into n11faf_1
  if global half 2300 is not n11faf_1
    go to p11fc9
  end
  place p11fb8
  call nucl_high_low_star_tone
  set h_rax to answer
  go to p11fda
  place p11fc2
