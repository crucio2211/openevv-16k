  call push_ptr_init addr c140
  call push_ptr_init addr c130
  call push_ptr_init addr c170
  call fence 0 sym eti_null
  call startloop 1
  call lpta_loadpn addr c160
  call lpta_mover 2
  call lpta_storep addr c100
  call lpta_loadpn addr c120
  call lpta_mover 2
  call lpta_storep addr c180
  place p1735f7
  place t1735f7_6 on 6
  call forall_to_test addr c100 addr c180
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p17360d
  place t17360d_7 on 7
  call bspush_ca 3
  call lpta_loadp addr c100
  call setscan_r 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p17362e
  call testFldeq 2 1 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p173642
  call advance_tok
  if answer is 0
    go to p173819
  end
  set unwind to 0
  backtrack
  place p173681
  place t173681_3 on 3
  call forto_adv_upto_r 1 2 7 2 addr c100 addr c180
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1736a7
  place t1736a7_1 on 1
  set cell c170 value to cell c120 value
  call lpta_loadp addr c120
  call proj_def 7
  call startloop 8
  call copyvar addr c170 addr c120
  call copyvar addr c180 addr c160
  go to p17372e
  place p173704
  place t173704_10 on 10
  call forto_adv_l 8 9 15 7 addr c170 addr c180
  if answer is not 0
    set unwind to 0
    backtrack
  end
  match
  place p17372e
  place t17372e_14 on 14
  call forall_to_test addr c170 addr c180
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p173744
  place t173744_15 on 15
  call bspush_ca 10
  call lpta_loadp addr c170
  call setscan_l 7
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p173765
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p173775
  place t173775_11 on 11
  call savescptr 11 addr c110
  place p173787
  place t173787_9 on 9
  call starttest 12
  if global half 2666 is not 1
    go to p1737ca
  end
  place p17379c
  call lpta_rpta_loadp addr c110 addr c170
  call insert_2pt_i 7 2 sym eti_s_1beeda 0
  if answer is 0
    go to p1737fc
  end
  place p1737ca
  place t1737ca_12 on 12
  call lpta_rpta_loadp addr c110 addr c170
  call insert_2pt_i 7 2 sym eti_s_1fe2d8 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1737fc
  place t1737fc_13 on 13
  call forall_cont_from 8 9 0 addr c170 addr c110
  go to p17372e
  place p173819
  place t173819_4 on 4
  call savescptr 4 addr c150
  place p17382b
  place t17382b_2 on 2
  call assign_eng_syll_init_con addr c100 addr c140
  place p173841
  place t173841_5 on 5
  call lpta_loadp addr c140
  call proj_def 7
  increment global half 2666
  call lpta_loadpn addr c150
  call lpta_mover 2
  call lpta_storep addr c130
  call forall_cont_from 1 2 0 addr c100 addr c130
  go to p1735f7
  place tm_8 on 8
  match
end

