# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule create_eng_syllables takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  variable g668 word 916
  place p172ff4
  place p17302f
  place p17308f
  call get_parm addr c160 arg 1 -6
  call get_parm addr c150 arg 2 -6
  call push_ptr_init addr c100
  call push_ptr_init addr c140
  call push_ptr_init addr c130
  call push_ptr_init addr c120
  call push_ptr_init addr c110
  call fence 0 sym eti_null
  call fence 1 sym eti_s_1beed8
  set cell c100 value to cell c160 value
  and 0 into global half 2666
  if global half 2682 is 0
    go to p1732c8
  end
  place p173153
  call startloop 1
  call copyvar addr c100 addr c160
  call copyvar addr c120 addr c150
  go to p173191
  place p173191
  place t173191_6 on 6
  call forall_to_test addr c100 addr c120
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1731af
  place t1731af_7 on 7
  call bspush_ca 3
  call lpta_loadp addr c100
  call setscan_r 3
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1731d0
  call test_string_s 3 1 sym eti_s_1beed9
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1731e9
  place t1731e9_4 on 4
  call savescptr 4 addr c140
  place p1731fb
  place t1731fb_2 on 2
  call break_into_eng_syllables addr c100 addr c140
  place p173211
  place t173211_5 on 5
  call forall_cont_from 1 2 0 addr c100 addr c140
  go to p173191
  place p173267
  place t173267_3 on 3
  call forto_adv_r 1 2 7 3 addr c100 addr c120
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p17328d
  go to p1732c8
  place p17328f
  place t17328f_10 on 10
  call forto_adv_r 8 9 16 3 addr c110 addr c120
  if answer is not 0
    set unwind to 0
    backtrack
  end
  match
  place p1732c8
  place t1732c8_1 on 1
  call startloop 8
  call copyvar addr c110 addr c160
  call copyvar addr c120 addr c150
  go to p173345
  place p173301
  place t173301_12 on 12
  call savescptr 12 addr c130
  place p173313
  place t173313_9 on 9
  call break_into_eng_syllables addr g668 addr c130
  place p173329
  place t173329_14 on 14
  call forall_cont_from 8 9 0 addr c110 addr c130
  place p173345
  place t173345_15 on 15
  call forall_to_test addr c110 addr c120
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p173363
  place t173363_16 on 16
  call bspush_ca 10
  call lpta_loadp addr c110
  call setscan_r 3
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p173388
  place t173388_11 on 11
  call savescptr 11 addr g668
  call testFldeq 3 0 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1733b2
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1733c2
  place t1733c2_13 on 13
  place p1733cd
  call bspush_ca_scan 12
  call testFldeq 3 0 3
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1733f1
  call advance_tok
  if answer is 0
    go to p1733cd
  end
  place p1733fd
  set unwind to 0
  backtrack
  place tm_8 on 8
  match
end

rule break_into_eng_syllables takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
