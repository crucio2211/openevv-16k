# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule init_vars takes 1
  instead
  variable g168 word 192
  variable g568 word 788
  variable gc9c word 2064
  variable gcf0 word 2126
  variable gd10 word 2140
  variable gef0 word 2552
  variable gf30 word 2604
  place p79e4
  place p7a21
  place p7a54
  call fence 0 sym eti_null
  set global half 2606 to 7
  call copyvar addr gf30 addr gc9c
  set global half 2128 to 5
  call move_i addr gcf0 1
  call npush_s 1
  set global half 2142 to 1
  call npop addr gd10
  set global half 2142 to 5
  call move_i addr gd10 1
  set global half 1846 to 1
  set global half 2002 to global half 1950
  and 0 into global half 1438
  set global half 1770 to global half 1774
  set global half 2208 to global half 1394
  set global half 3822 to global half 1394
  set global half 3826 to global half 1394
  set global half 3830 to global half 1394
  and 0 into global half 1790
  and 0 into global half 1766
  set global word 1412 to global word 188
  set global word 800 to global word 188
  call rpta_loadp addr g168
  call insert_l 1 1 sym eti_s_1b904b 0
  call lpta_storep addr g568
  call lpta_loadp addr g568
  call proj_def_mult 9 sym eti_s_1b904c addr g568
  set global word 1532 to global word 800
  set global word 728 to global word 792
  and 0 into global half 1496
  set global half 2378 to global half 2382
  call settvar_i addr gef0 1
  set global half 2746 to 4
  and 0 into global half 2354
  and 0 into global half 2934
  set global word 3332 to global word 800
  set global word 2628 to 1000000
  call init_lang_vars
  match
end

