  and 0 into global half 1492
  and 0 into global half 1460
  and 0 into global half 1638
  and 0 into global half 1642
  call lpta_loadp addr g158
  call setscan_r 1
  if answer is not 0
    go to p8a86
  end
  place p8a69
  call bspush_ca_scan 2
  call savescptr 3 addr g9d8
  place p8a86
  call copyvar addr ged0 addr gf30
  set global half 2536 to 1
