  call reset_lang_sent_vars
  set global word 808 to global word 712
  call reset_phrase_vars
  call increment_output_file_number
  match
end

rule increment_output_file_number takes 1
  instead
  local h_rax
  local h_rcx
  local n8c1f_0
  local n8c2d_0
  place p8b79
  place p8ba8
  place p8bfe
  call fence 0 sym eti_null
  set h_rax to answer
  set h_rax to global half 2798
  if h_rax is 0
    match
  end
  place p8c1f
  set n8c1f_0 to h_rax
  shift left 16 into n8c1f_0
  shift right 16 into n8c1f_0
  if n8c1f_0 is less than 999
    go to p8c34
  end
  place p8c25
  set h_rcx to h_rax
  add -1999 to h_rcx
  set n8c2d_0 to h_rcx
  and 65535 into n8c2d_0
  if n8c2d_0 is below 64538
    match
  end
  place p8c34
  increment h_rax
  set global half 2798 to h_rax
  match
end

rule init_symbolic_vars takes 1
  instead
  place p8c4f
  place p8c82
  place p8cb1
  call fence 0 sym eti_null
  and 0 into global half 2690
  set global word 2752 to global word 712
  set global word 2768 to global word 712
  match
end

rule init_tm_vars takes 1
  instead
  variable g1018 word 2756
  variable g1038 word 2772
  variable g290 word 340
  place p8d0f
  place p8d3e
  place p8d98
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr g290
  call setscan_r 4
  if answer is not 0
    match
  end
  place p8dce
  call bspush_ca_scan 2
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p8de5
  go to p8dec
  place p8dec
  place t8dec_2 on 2
  call savescptr 2 addr g1038
  call bspush_ca_scan 3
  call advance_tok
  if answer is 0
    go to p8e46
  end
  set unwind to 0
  backtrack
  place p8e46
  place t8e46_3 on 3
  call savescptr 3 addr g1018
  match
  place tm_1 on 1
  match
end

rule init_word_ptrs takes 1
  instead
  place p8e5d
  place p8e90
  place p8ebf
  call fence 0 sym eti_null
  call init_current_word_ptrs
  call init_adjacent_word_ptrs
  match
end

