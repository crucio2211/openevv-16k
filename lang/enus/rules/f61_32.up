rule set_first_postnuc_value takes 2
  instead
  local ce0 bytes 8
  local h_rax
  variable g788 word 1060
  place p89eb8
  place p89eec
  place p89f48
  call get_parm addr ce0 arg 1 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call fence 1 sym eti_s_1bd665
  set h_rax to answer
  set h_rax to 70
  if global half 2280 is global half 2248
    go to p8a044
  end
  place p89f9c
  set h_rax to 65511
  if global signed half 2256 is more than 2
    go to p8a044
  end
  place p89fae
  set h_rax to global half 1618
  if h_rax is not global half 2240
    go to p89fec
  end
  place p89fbe
  call lpta_loadp addr g788
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p89fec
  end
  place p89fd4
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p89fec
  end
  place p89fe0
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p8a060
  end
  place p89fec
  set h_rax to 25
  if global half 2256 is not 2
    go to p8a044
  end
  place p89ffa
  call lpta_loadp addr g788
  call setscan_r 7
  set h_rax to answer
  if h_rax is not 0
    go to p8a040
  end
  place p8a010
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p8a040
  end
  place p8a01c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p8a040
  end
  place p8a028
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p8a040
  end
  place p8a034
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p8a066
  end
  place p8a040
  set h_rax to 10
  place p8a044
  set cell ce0 field to h_rax
  put h_rax into arg 1 at 2 half
  match
  place p8a060
  set h_rax to 45
  go to p8a044
  place p8a066
  set h_rax to 35
  go to p8a044
end

rule eng_prenucl_f0 takes 1
  instead
  place p8a071
  place p8a0a0
  place p8a0f6
  call fence 0 sym eti_null
  if global signed half 2074 is at least global signed half 398
    match
  end
  place p8a11b
  call eng_position_t_ptrs
  call realize_prenucl_tone
  match
end

