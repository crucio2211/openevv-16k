  call setscan_l 5
  if answer is not 0
    give up
  end
  place p8c3bc
  call testFldeq 5 1 1
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p8c3d0
  call advance_tok
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_2 on 2
  match
end

