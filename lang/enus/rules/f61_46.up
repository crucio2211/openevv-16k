  set h_r13 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_r14 to 1
  set h_rsi to 1
  call startloop h_rsi
  set h_rax to answer
  set h_rsi to 1
  set h_r14 to 0
  place p1581fe
  call bspush_ca h_rsi
  set h_rax to answer
  set vee to h_r14
  set n158211_0 to h_r14
  shift left 16 into n158211_0
  shift right 16 into n158211_0
  if n158211_0 is more than 1
    go to p15822e
  end
  place p158218
  set h_rsi to addr c118
  call lpta_loadp h_rsi
  call setscan_l 1
  set h_rax to answer
  if h_rax is 0
    go to p158237
  end
  place p15822e
  go to p158277
  place p158237
  set h_rsi to 3
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 1
  set h_rcx to sym eti_s_1bea17
  call test_string_s h_rsi 2 h_rcx
  set s158252 to answer
  set h_rax to s158252
  set h_rcx to h_r13
  if h_rax is not 0
    go to p158277
  end
  place p158265
  go to p158357
  place p15826a
  place t15826a_12 on 12
  set h_r13 to unwind
  set h_rsi to 1
  set h_r14 to vee
  go to p1581fe
  place p158277
  set h_rsi to h_r13
  set unwind to h_rsi
  backtrack
  place p1582ac
  place t1582ac_3 on 3
  set h_r13 to unwind
  set h_rsi to 5
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 1
  set h_rcx to sym eti_s_1bea19
  go to p158312
  place p1582c9
  place t1582c9_5 on 5
  set h_r13 to unwind
  set h_rsi to 1
  set h_rcx to sym eti_s_1bea1a
  call test_string_s h_rsi 1 h_rcx
  set s1582d9 to answer
  set h_rax to s1582d9
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p1582e5
  set h_rsi to 6
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 1
  set h_rcx to sym eti_s_1bea1b
  go to p158312
  place p158302
  place t158302_6 on 6
  set h_r13 to unwind
  set h_rsi to 1
  set h_rcx to sym eti_s_1bea1c
  place p158312
  call test_string_s h_rsi 1 h_rcx
  set s158312 to answer
  set h_rax to s158312
  set h_rcx to h_r13
  set h_rsi to h_r13
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p158325
  go to p158357
  place p158327
  place t158327_9 on 9
  set h_r13 to unwind
  set h_rax to cell c108 value
  call lpta_loadp addr c108
  call test_ptr
  set h_rax to answer
  if h_rax is 0
    set h_r13 to 1
  end
  go to p158277
  place p158354
  place t158354_4 on 4
  set h_r13 to unwind
  set h_rcx to h_r13
  place p158357
  set h_r13 to h_rcx
  set h_rsi to 1
  set h_rcx to sym eti_s_1bea14
  call test_string_s h_rsi 1 h_rcx
  set s15836a to answer
  set h_rax to s15836a
  set h_rcx to h_r13
  if h_rax is not 0
    go to p158277
  end
  place p15837a
  go to p15837f
  place p15837c
  place t15837c_7 on 7
  set h_r13 to unwind
  set h_rcx to h_r13
  place p15837f
  set h_r13 to h_rcx
  set h_rsi to 7
  call savescptr h_rsi addr c108
  set h_rax to answer
  set h_rsi to 1
  set h_rcx to 1
  call testFldeq h_rsi 3 h_rcx
  set h_rax to answer
  if h_rax is not 0
    go to p158277
  end
  place p1583ad
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p158277
  end
  place p1583bd
  set h_rsi to 8
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c128
  call lpta_loadp h_rsi
  call setscan_r 1
  set s1583d5 to answer
  set h_rax to s1583d5
  set h_rcx to h_r13
  if h_rax is not 0
    go to p158277
  end
  place p1583e5
  go to p158446
  place p1583e7
  place t1583e7_8 on 8
  set h_r13 to unwind
  call bspop_boa
  set h_rax to answer
  place p1583ef
  place t1583ef_2 on 2
  set h_r13 to unwind
  set h_rsi to addr c108
  set h_rcx to addr c128
  call clitics h_rsi addr c118 h_rcx addr c138
  set h_rax to answer
  place p158413
  place t158413_11 on 11
  set h_r13 to unwind
  set h_rax to vee
  increment h_rax
  set h_r14 to h_rax
  set h_rax to cell c108 value
  set cell c118 value to h_rax
  set h_rsi to 1
  call while_iterate h_rsi 2
  set h_rax to answer
  set h_rsi to 1
  go to p1581fe
  place p158443
  place t158443_10 on 10
  set h_r13 to unwind
  set h_rcx to h_r13
  place p158446
  set h_r13 to h_rcx
  place p158449
  set h_rsi to 1
  set h_rcx to 16
  call testFldeq h_rsi 0 h_rcx
  set h_rax to answer
  if h_rax is not 0
    go to p158277
  end
  place p158461
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to p158277
  end
  place p158471
  set h_rsi to 9
  call bspush_ca_scan h_rsi
  set h_rax to answer
  go to p158449
  place p15847e
  place t15847e_1 on 1
  set h_r13 to unwind
  set h_rax to cell c118 value
  set h_rcx to arg 2
  put h_rax into arg 2 at 4
  match
end

