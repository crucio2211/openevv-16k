# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule strip_eng_clitics takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  place p157c84
  place p157cca
  place p157cfd
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call get_parm addr c120 arg 3 -6
  call fence 0 sym eti_null
  call strip_possessive addr c110 addr c100 addr c120
  if answer is 0
    go to p157d92
  end
  place p157d75
  call strip_contractions addr c110 addr c100 addr c120
  place p157d92
  put cell c100 value into arg 2 at 4
  match
end

rule strip_possessive takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local h_rax
  place p157dd5
  place p157e1b
  place p157e7f
  call get_parm addr c138 arg 1 -6
  set h_rax to answer
  call get_parm addr c100 arg 2 -6
  set h_rax to answer
  call get_parm addr c110 arg 3 -6
  set h_rax to answer
  and 0 into cell c128 half 0
  set cell c128 byte 2 to 0
  set c128 to -65533
  call fence 0 sym eti_null
  set h_rax to answer
  call fence 1 sym eti_s_1bea11
  set h_rax to answer
  call starttest 1
  set h_rax to answer
  call lpta_loadp addr c110
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p157f76
  end
  place p157f22
  call test_string_s 1 2 sym eti_s_1bea12
  set h_rax to answer
  if h_rax is not 0
    go to p157f76
  end
  place p157f3b
  go to p157f42
  place p157f42
  place t157f42_2 on 2
  call savescptr 2 addr c100
  set h_rax to answer
  call testFldeq 1 3 1
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p157f6c
  call advance_tok
  set h_rax to answer
  go to p157fdd
  place p157f76
  place t157f76_1 on 1
  call starttest 4
  set h_rax to answer
  call lpta_loadp addr c110
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p157f9b
  call test_string_s 1 1 sym eti_s_1bea14
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p157fb7
  place t157fb7_5 on 5
  call savescptr 5 addr c100
  set h_rax to answer
  call test_string_s 1 1 sym eti_s_1bea15
  set h_rax to answer
  place p157fdd
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p157fe5
  place t157fe5_3 on 3
  call lpta_rpta_loadp addr c100 addr c110
  set h_rax to answer
  call insert_2pt_s 2 1 sym eti_s_1bea16 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p158017
  call lpta_rpta_loadp addr c100 addr c110
  set h_rax to answer
  call settvar_s addr c128 3
  set h_rax to answer
  call npush_s 1
  set h_rax to answer
  set cell c128 field to 1
  call npop addr c128
  set h_rax to answer
  call insert_2ptv 3 addr c128 0
  set h_rax to answer
  if h_rax is 0
    go to p1580b1
  end
  set unwind to 0
  backtrack
  place p1580b1
  set h_rax to cell c100 value
  put h_rax into arg 2 at 4
  match
end

rule strip_contractions takes 4
  instead
  local c108 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local vee half
  local vf8 word
  local h_r13
  local h_r14
  local h_rax
  local h_rcx
  local h_rsi
  local s158252
  local s1582d9
  local s158312
  local s15836a
  local s1583d5
  local n158211_0
  place p1580d8
  set h_r14 to arg 3
  set vf8 to arg 2
  place p15811a
  place p15817a
  set h_rsi to addr c128
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rax to answer
  set h_rsi to addr c118
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rax to answer
  set h_rsi to addr c138
  set h_rcx to -6
