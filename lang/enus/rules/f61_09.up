# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule doF takes 4
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local cf8 bytes 8
  local cfc bytes 8
  local h_rax
  local h_rcx
  local h_xmm0
  local n14c88_0
  variable g608 word 868
  variable g618 word 876
  variable g628 word 884
  variable g638 word 892
  variable g910 word 1316
  variable g920 word 1324
  place p14b67
  place p14ba5
  place p14c09
  set h_rcx to -4
  call get_parm addr cf8 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf4 arg 2 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf0 arg 3 h_rcx
  set h_rax to answer
  set cfc to 65532
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  if h_rax is at most 0
    go to p14d4d
  end
  place p14c6f
  set h_xmm0 to global word 2348
  if h_xmm0 is at least 160000
    go to p14cb8
  end
  place p14c81
  set h_rcx to cell cf0 field
  set n14c88_0 to h_rcx
  shift left 16 into n14c88_0
  shift right 16 into n14c88_0
  if n14c88_0 is at most 0
    go to p14cb8
  end
  place p14c8d
  set h_rcx to h_rcx
  add h_rax to h_rcx
  set h_xmm0 to h_rcx
  multiply 10000 into h_xmm0
  scale h_xmm0 by 5000 over 10000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf4 field to h_rax
  or -1 into cell cf0 field
  go to p14cb8
  go to p14cb8
  place t14cb8_2 on 2
  place p14cb8
  set h_rcx to addr g910
  set h_rax to addr g618
  call add_filtered_val addr cf8 addr cf4 h_rcx addr g910 addr g628 addr g618
  set h_rax to answer
  go to p14cec
  place t14cec_3 on 3
  place p14cec
  call starttest 1
  set h_rax to answer
  call c_assvar addr cfc
  set h_rax to answer
  or -1 into cell cfc field
  if cell cf0 field is not 65535
    set unwind to 0
    backtrack
  end
  place p14d19
  set h_rcx to addr g920
  set h_rax to addr g638
  call add_filtered_val addr cf8 addr cf4 h_rcx addr g920 addr g608 addr g638
  set h_rax to answer
  go to p14d4d
  place t14d4d_1 on 1
  place p14d4d
  if cell cf0 field is at most 0
    match
  end
  place p14d5e
  call starttest 5
  set h_rax to answer
  call c_assvar addr cfc
  set h_rax to answer
  or -1 into cell cfc field
  if cell cf4 field is 65535
    go to p14dfc
  end
  set unwind to 0
  backtrack
  go to p14dc3
  place t14dc3_5 on 5
  place p14dc3
  set h_rcx to addr g920
  set h_rax to addr g638
  call add_filtered_val addr cf8 addr cf0 h_rcx addr g920 addr g608 addr g638
  set h_rax to answer
  match
  place p14dfc
  set h_rcx to addr g910
  set h_rax to addr g638
  call add_filtered_val addr cf8 addr cf0 h_rcx addr g920 addr g628 addr g638
  set h_rax to answer
  match
  place tm_4 on 4
  place tm_6 on 6
  match
end

