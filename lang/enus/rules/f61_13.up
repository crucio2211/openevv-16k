    backtrack
  end
  place p209ed
  go to p20a94
  place p209f2
  place t209f2_9 on 9
  set h_r13 to unwind
  set h_rsi to 1
  set h_rdx to 3
  set h_rcx to 1
  call testFldeq h_rsi h_rdx h_rcx
  set s209fe to answer
  set h_rsi to h_r13
  if s209fe is not 0
    set unwind to h_rsi
    backtrack
  end
  place p20a0e
