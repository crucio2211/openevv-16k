  set s20a11 to answer
  set h_rcx to h_r13
  set h_rsi to h_r13
  if s20a11 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p20a24
  go to p20ab2
  place p20a29
  place t20a29_11 on 11
