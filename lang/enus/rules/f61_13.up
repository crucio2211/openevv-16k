rule insert_userdict_root takes 3
  instead
  local c100 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local h_rax
  place p20bbc
  place p20bfb
  place p20c5e
  call get_parm addr c128 arg 1 -6
  set h_rax to answer
  call get_parm addr c100 arg 2 -6
  set h_rax to answer
  and 0 into cell c118 half 0
  set cell c118 byte 2 to 0
  set c118 to -65533
  call fence 0 sym eti_null
  set h_rax to answer
  set global half 2726 to 1
  set h_rax to global half 3654
  if h_rax is global half 3626
    go to p20ce5
  end
  place p20ccf
  call convert_to_lowercase addr c128 addr c100
  set h_rax to answer
  place p20ce5
  go to p20cf7
  place t20cf7_1 on 1
  place p20cf7
  call starttest 2
  set h_rax to answer
  if global half 2694 is not 1
    go to p20d77
  end
  place p20d0c
  call lpta_rpta_loadp addr c128 addr c100
  set h_rax to answer
  call settvar_s addr c118 2
  set h_rax to answer
  call npush_s 6
  set h_rax to answer
  set cell c118 field to 2
  call npop addr c118
  set h_rax to answer
  call insert_2ptv 3 addr c118 0
  set h_rax to answer
  go to p20de7
  go to p20d77
  place t20d77_2 on 2
  place p20d77
  call starttest 4
  set h_rax to answer
  call internal_dict_lookup addr c128 addr c100
  set h_rax to answer
  if h_rax is 0
    match
  end
  go to p20d98
  place t20d98_4 on 4
  place p20d98
  call lpta_rpta_loadp addr c128 addr c100
  set h_rax to answer
  call insert_2pt_s 3 1 sym eti_s_1b909f 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p20dc2
  call lpta_rpta_loadp addr c128 addr c100
  set h_rax to answer
  call mark_s 3 2 1 0
  set h_rax to answer
  place p20de7
  if h_rax is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_3 on 3
  match
end

rule internal_dict_lookup takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p20e4c
  place p20e8f
  place p20ec2
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  if global half 3630 is not global half 3626
    give up
  end
  place p20f15
  call starttest_l 2
  call bspush_ca 3
  call eng_words_dict_lookup addr c110 addr c100
  if answer is 0
    match
  end
  place p20f45
  set unwind to 0
  backtrack
  place p20f75
  place t20f75_3 on 3
  call eng_internal_dict_lookup addr c110 addr c100
  if answer is not 0
    set unwind to 0
    backtrack
  end
  match
  place tm_4 on 4
  match
end

