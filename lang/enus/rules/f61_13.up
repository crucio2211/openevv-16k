  set h_r13 to unwind
  set h_rsi to 1
  set h_rdx to 0
  set h_rcx to 51
  place p209d9
  call testFldeq h_rsi h_rdx h_rcx
  set s209da to answer
  set h_rcx to h_r13
  set h_rsi to h_r13
  if s209da is not 0
