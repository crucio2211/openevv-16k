# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule user_rootdict takes 3
  instead
  local c108 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local vf8 word
  local h_r15
  local h_rax
  local h_rcx
  local h_rsi
  variable g1084 word 2816
  variable gafc word 1648
  place p203a0
  set h_r15 to arg 1
  place p203db
  place p2043b
  set h_rsi to addr c118
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rax to answer
  set h_rsi to addr c108
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rax to answer
  set h_rsi to addr c128
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  if global half 3830 is 0
    give up
  end
  place p20497
  set h_rax to addr g1084
  set vf8 to addr g1084
  set h_r15 to 0
  place p204bd
  place t204bd_1 on 1
  set h_r15 to unwind
  if global half 2726 is 1
    give up
  end
  place p204cb
  place t204cb_2 on 2
  set h_r15 to unwind
  set h_rsi to 3
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c118
  call lpta_loadp h_rsi
  call setscan_r 3
  set h_rax to answer
  if h_rax is 0
    go to p2051b
  end
  place p204e8
  place t204e8_3 on 3
  set h_r15 to unwind
  set h_rsi to 5
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 6
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rax to 0
  set h_rsi to addr g1084
  set h_rcx to addr c108
  call callUserDictLookup h_rsi addr c118 h_rcx
  set h_rax to answer
  go to p2052e
  place p2051b
  set h_rsi to 4
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  call advanc
  set h_rax to answer
  place p2052e
  set h_rcx to 1
  if h_rax is 0
    set h_r15 to 1
  end
  set h_rsi to h_r15
  set unwind to h_rsi
  backtrack
  place p2056c
  place t2056c_4 on 4
  set h_r15 to unwind
  call bspop_boa
  set h_rax to answer
  set h_rsi to 3
  set h_rcx to 6
  call testFldeq h_rsi 2 h_rcx
  set h_rax to answer
  set h_rsi to h_r15
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p2058c
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r15
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  give up
  place p205a0
  place t205a0_5 on 5
  set h_r15 to unwind
  set h_rsi to addr c118
  call is_spr h_rsi addr c128
  set h_rax to answer
  if h_rax is not 0
    go to p205f9
  end
  place p205b6
  set h_rsi to 8
  call starttest_l h_rsi
  set h_rax to answer
  set h_rsi to 9
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c118
  set h_rcx to addr c108
  call handle_SPR h_rsi addr c128 h_rcx addr gafc
  set h_rax to answer
  set h_rcx to 1
  if h_rax is 0
    go to p205f2
  end
  place p205ef
  set h_rcx to h_r15
  place p205f2
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place p205f9
  place t205f9_7 on 7
  set h_r15 to unwind
  set h_rsi to addr c118
  call isLegalWord h_rsi addr c108
  set h_rax to answer
  if h_rax is not 0
    go to p2065f
  end
  place p20613
  set h_rsi to addr c118
  call insert_userdict_root h_rsi addr c108
  set h_rax to answer
  place p20629
  place t20629_8 on 8
  place t20629_11 on 11
  place t20629_13 on 13
  set h_r15 to unwind
  set h_rax to 1
  set global half 2726 to 1
  set global half 4178 to 1
  match
  place p2064a
  place t2064a_6 on 6
  set h_r15 to unwind
  call bspop_boa
  set h_rax to answer
  give up
  place p20657
  place t20657_9 on 9
  set h_r15 to unwind
  call bspop_boa
  set h_rax to answer
  place p2065f
  place t2065f_12 on 12
  set h_r15 to unwind
  set h_rsi to addr c118
  set h_rcx to addr g1084
  call user_dict_error h_rsi addr c108 h_rcx
  set h_rax to answer
  give up
end

rule user_dict_error takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  place p206bc
  place p206fa
  place p2075a
  call get_parm addr c100 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call get_parm addr cf0 arg 3 -4
  call fence 0 sym eti_null
  call callInsertLastDictString addr cf0 addr c100 addr c110
  if global half 2822 is not cell cf0 field
    match
  end
  place p207db
  set global half 1646 to 1
  match
end

rule isLegalWord takes 3
  instead
