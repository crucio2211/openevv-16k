# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule strip_nonlex_prefixes takes 1
  instead
  local h_r15
  local h_rax
  local h_rsi
  place p1525c8
  place p1525fd
  place p15265d
  set h_r15 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_rsi to 1
  call fence h_rsi sym eti_s_1be896
  set h_rax to answer
  and 0 into global half 4170
  call strip_single_nonlex_prefix
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p1526a0
  place p1526ab
  call strip_scientific_prefixes
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p1526bb
  call strip_pname_prefix
  set h_rax to answer
  if h_rax is 0
    match
  end
  go to p1526c7
  place t1526c7_4 on 4
  set h_rax to unwind
  set h_r15 to unwind
  place p1526c7
  set h_rsi to 5
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 6
  call bspush_ca_boa h_rsi
  set h_rax to answer
  call strip_outer_prefixes
  set h_rax to answer
  set h_rsi to 1
  if h_rax is 0
    set unwind to h_rsi
    backtrack
  end
  place p1526ec
  set h_rsi to h_r15
  set unwind to h_rsi
  backtrack
  go to p152728
  place t152728_3 on 3
  set h_rax to unwind
  set h_r15 to unwind
  place p152728
  set h_r15 to h_rax
  go to p1526bb
  go to p15272d
  place t15272d_1 on 1
  set h_rax to unwind
  set h_r15 to unwind
  place p15272d
  set h_r15 to h_rax
  go to p1526ab
  go to p152735
  place t152735_5 on 5
  set h_rax to unwind
  set h_r15 to unwind
  place p152735
  call strip_medial_prefix
  set h_rax to answer
  match
  go to p15274c
  place t15274c_6 on 6
  set h_rax to unwind
  set h_r15 to unwind
  place p15274c
  call bspop_boa
  set h_rax to answer
  give up
  place tm_2 on 2
  match
end

