rule insert_prefix takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  place p1572cc
  place p157312
  place p157345
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call get_parm addr cf0 arg 3 -4
  and 0 into cell c128 half 0
  set cell c128 byte 2 to 0
  set c128 to -65533
  call fence 0 sym eti_null
  call lpta_rpta_loadp addr c110 addr c100
  call settvar_s addr c128 1
  call insert_2ptv 3 addr c128 0
  if answer is 0
    go to p1573fb
  end
  set unwind to 0
  backtrack
  place p1573fb
  if cell cf0 field is not 1
    go to p157440
  end
  place p157405
  call lpta_rpta_loadp addr c110 addr c100
  call mark_s 3 1 5 0
  go to p157440
  place p157440
  place t157440_1 on 1
  set global half 4170 to 1
  increment global half 2682
  set cell c110 value to cell c100 value
  put cell c100 value into arg 1 at 4
  match
end

