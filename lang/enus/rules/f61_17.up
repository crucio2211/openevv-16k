  variable g168 word 192
  variable g4e8 word 724
  variable g568 word 788
  variable g830 word 1126
  variable ga20 word 1470
  variable ga28 word 1478
  place p2d534
  place p2d569
  place p2d5c9
  call push_ptr_init addr c120
  set h_rax to answer
  call push_ptr_init addr c140
  set h_rax to answer
  call fence 0 sym eti_null
  call resetStreamArrayC
  set h_rax to answer
  set h_rax to addr g158
  set vf8 to addr g158
  set h_rax to addr g4e8
  set v108 to addr g4e8
  set h_rax to addr g830
  set v110 to addr g830
  set h_rax to addr ga28
