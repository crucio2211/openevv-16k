  end
  place p2d699
  call lpta_loadp addr g4e8
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p2d6d9
  end
  place p2d6af
  set h_rax to global word 792
  call lpta_loadp addr g568
  call test_ptr
  set h_rax to answer
  if h_rax is 0
