  end
  place p2d6d9
  place t2d6d9_2 on 2
  set h_rax to global half 1398
  if h_rax is not global half 2378
    go to p2d738
  end
  place p2d6e9
  call lpta_loadp addr g4e8
  call setscan_l 0
  set h_rax to answer
  if h_rax is not 0
    go to p2d71a
  end
  place p2d6ff
  call savetok addr g830
  set h_rax to answer
  if h_rax is not 0
