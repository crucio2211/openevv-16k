  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d7db
  call lpta_rpta_loadp addr g158 addr g568
  set h_rax to answer
  call delete_2pt 6 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d807
  call lpta_rpta_loadp addr g158 addr g568
  set h_rax to answer
  call delete_2pt 7 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d833
  call lpta_rpta_loadp addr g158 addr g568
  set h_rax to answer
  call delete_2pt 8 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d85f
  call lpta_rpta_loadp addr g158 addr g4e8
  set h_rax to answer
  call delete_2pt 0 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d88c
  call lpta_rpta_loadp addr g158 addr g568
  set h_rax to answer
  call delete_2pt 2 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d8b8
  go to p2d8cd
  place p2d8ba
  call starttest_l 7
  set h_rax to answer
  call delete_2_more
  set h_rax to answer
  place p2d8cd
  place t2d8cd_7 on 7
  place t2d8cd_8 on 8
  call lpta_rpta_loadp addr g158 addr g4e8
  set h_rax to answer
  call delete_2pt 1 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d8f9
  set h_rax to global word 2320
  set global word 1412 to h_rax
  and 0 into global half 1472
  call startloop 9
  set h_rax to answer
  call lpta_loadpn addr g4e8
  set h_rax to answer
  call lpta_mover 0
  set h_rax to answer
  call lpta_storep addr c120
  set h_rax to answer
  place p2d943
  place t2d943_14 on 14
  call bspush_ca 11
  set h_rax to answer
  call lpta_loadp addr c120
  call setscan_r 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d968
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d978
  place t2d978_12 on 12
  call savescptr 12 addr c140
  set h_rax to answer
  call savetok addr g830
  set h_rax to answer
  if h_rax is not 0
