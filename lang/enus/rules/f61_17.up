  end
  place p2d712
  call advance_tok
  set h_rax to answer
  place p2d71a
  place t2d71a_5 on 5
  and 0 into global half 1128
  call copyvar addr ga28 addr g830
  set h_rax to answer
  place p2d738
  place t2d738_4 on 4
  call starttest 6
  set h_rax to answer
  set h_rax to global half 1398
  if h_rax is not global half 2378
    go to p2d8ba
  end
  place p2d757
  place t2d757_6 on 6
  call lpta_rpta_loadp addr g158 addr g568
  set h_rax to answer
  call delete_2pt 3 0
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2d783
  call lpta_rpta_loadp addr g158 addr g568
  set h_rax to answer
  call delete_2pt 4 0
  set h_rax to answer
  if h_rax is not 0
