# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule pre_syll_phone_adjustments takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  place p116f58
  place p116f93
  place p116ff7
  call get_parm addr c140 arg 1 -6
  call get_parm addr c120 arg 2 -6
  call push_ptr_init addr c110
  call push_ptr_init addr c100
  call push_ptr_init addr c130
  call fence 0 sym eti_null
  call startloop 1
  call copyvar addr c110 addr c140
  call copyvar addr c130 addr c120
  call forall_to_test addr c110 addr c130
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1170ac
  go to p1170b3
  place p1170b3
  place t1170b3_9 on 9
  call bspush_ca 3
  call lpta_loadp addr c110
  call setscan_r 3
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1170d8
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1170e8
  place t1170e8_4 on 4
  call savescptr 4 addr c100
  place p1170fa
  place t1170fa_2 on 2
  call adjust_plur_poss_pronunc addr c110 addr c100
  if answer is 0
    go to p117150
  end
  place p117114
  place t117114_5 on 5
  call adjust_past_tense_pronunc addr c110 addr c100
  if answer is 0
    go to p117150
  end
  place p11712e
  place t11712e_7 on 7
  call adjust_final_y addr c100
  if answer is 0
    go to p117150
  end
  place p117141
  place t117141_8 on 8
  call adjust_mc_prefix addr c100
  place p117150
  place t117150_6 on 6
  call starttest 3
  call lpta_loadpn addr c100
  call rpta_loadpn addr c120
  call compare_ptas
  if answer is not 0
    go to p117199
  end
  place p117185
  call testeq
  if answer is not 0
    go to p117199
  end
  match
  place p117199
  place t117199_3 on 3
  call forto_adv_r 1 2 9 3 addr c110 addr c130
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_1 on 1
  match
end

rule adjust_plur_poss_pronunc takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_rcx
  local h_rdx
  place p117218
  place p117257
  place p1172ba
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c100 h_rdx h_rcx
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c110 h_rdx h_rcx
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_1be353
  call fence 1 h_rdx
  set h_rdx to 2
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is 0
    go to p117329
  end
  give up
  place p117329
  set h_rcx to sym eti_s_1be354
  set h_rdx to 1
  call test_string_s 2 h_rdx h_rcx
  if answer is not 0
    give up
  end
  place p117346
  call lpta_loadp addr c110
  call test_ptr
  if answer is 0
    go to p117374
  end
  give up
  place p117374
  call starttest 2
  set h_rdx to 3
  call lpta_loadp addr c100
  call setscan_l h_rdx
  if answer is 0
    go to p1173ce
  end
  place p117395
  place t117395_2 on 2
  call starttest 6
  set h_rdx to 2
  call lpta_loadp addr c100
  call setscan_l h_rdx
  if answer is not 0
    go to p11747d
  end
  place p1173ba
  call bspush_ca_scan 7
  set h_rcx to sym eti_s_1be354
  go to p11743d
  place p1173ce
  set h_rdx to 1
  set h_rcx to 4
  call testFldeq 3 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1173e7
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1173f7
  set h_rdx to addr c110
  call delete_morph_from_left addr c100 h_rdx
  go to p117414
  place p117414
  place t117414_3 on 3
  set h_rdx to addr c110
  call delete_phone_from_left addr c100 h_rdx
  place p11742a
  place t11742a_4 on 4
  set cell c100 value to cell c110 value
  go to p117595
  place p11743d
  set h_rdx to 1
  call test_string_s 2 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117453
  place t117453_8 on 8
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rcx to sym eti_s_1be35a
  set h_rdx to 2
  go to p1174ea
  place p11747d
  place t11747d_6 on 6
  call starttest 5
  set h_rdx to 2
  call lpta_loadp addr c100
  call setscan_l h_rdx
  if answer is not 0
    go to p117595
  end
  place p1174a2
  set h_rdx to 2
  set h_rcx to 0
  call testFldeq 2 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1174b5
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1174c1
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rcx to sym eti_s_1be356
  set h_rdx to 1
  place p1174ea
  call insert_2pt_s 2 h_rdx h_rcx 0
  if answer is 0
    go to p117595
  end
  set unwind to 0
  backtrack
  place p11752d
  place t11752d_7 on 7
  call bspush_ca_scan 9
  set h_rcx to sym eti_s_1be355
  go to p11743d
  place p117544
  place t117544_9 on 9
  call bspush_ca_scan 10
  set h_rcx to sym eti_s_1be356
  go to p11743d
  place p11755b
  place t11755b_10 on 10
  call bspush_ca_scan 11
  set h_rcx to sym eti_s_1be357
  go to p11743d
  place p117572
  place t117572_11 on 11
  call bspush_ca_scan 12
  set h_rcx to sym eti_s_1be358
  go to p11743d
  place p117589
  place t117589_12 on 12
  set h_rcx to sym eti_s_1be359
  go to p11743d
  place p117595
  place t117595_5 on 5
  place t117595_13 on 13
  put cell c100 value into arg 1 at 4
  match
end

rule adjust_past_tense_pronunc takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_r12
  local h_r14
  local h_r15
  local h_rcx
  local h_rdx
  local h_rsi
  local s1176fd
  local s117750
  local s117777
  local s1177bd
  local s117870
  local s11788f
  local s1178c4
  place p1175d8
  set h_r14 to arg 2
  set h_r15 to arg 1
  set h_r12 to 94
  place p117617
  place p11767a
  set h_r12 to addr c100
  set h_rsi to addr c100
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rsi to addr c110
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rdx to sym eti_null
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rdx to sym eti_s_1be353
  set h_rsi to 1
  call fence h_rsi h_rdx
  set h_rdx to 2
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  if answer is 0
    go to p1176e9
  end
  give up
  place p1176e9
  set h_rcx to sym eti_s_1be35c
  set h_rsi to 2
  set h_r15 to 1
  set h_rdx to 1
  call test_string_s h_rsi h_rdx h_rcx
  set s1176fd to answer
  set h_r14 to 94
  if s1176fd is not 0
    give up
  end
  place p11770e
  call lpta_loadp addr c110
  call test_ptr
  if answer is not 0
    give up
  end
  place p117738
  set h_rsi to 2
  call starttest h_rsi
  set h_rsi to addr c100
  set h_rdx to 2
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  set s117750 to answer
  set h_r14 to 0
  if s117750 is not 0
    go to p1177d5
  end
  place p11775c
  set h_rsi to 3
  call bspush_ca_scan h_rsi
  set h_rcx to sym eti_s_1be353
  set h_rsi to 2
  set h_rdx to 1
  call test_string_s h_rsi h_rdx h_rcx
  set s117777 to answer
  set h_rcx to 0
  set h_rdx to 0
  if s117777 is not 0
    go to p11781d
  end
  place p117788
  go to p11778f
  place p11778f
  set h_r15 to h_rcx
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rcx to sym eti_s_1be35d
  set h_rdx to 2
  set h_r14 to 0
  set h_rsi to 2
  call insert_2pt_s h_rsi h_rdx h_rcx 0
  set s1177bd to answer
  set h_rdx to h_r15
  if s1177bd is not 0
    go to p11781d
  end
  match
  place p1177ce
  place t1177ce_2 on 2
  set h_r12 to unwind
  set h_r14 to h_r12
  set h_r15 to 1
  place p1177d5
  set h_rsi to 5
  call starttest h_rsi
  set h_rsi to addr c100
  set h_rdx to 2
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  if answer is not 0
    match
  end
  place p1177fa
  set h_rsi to 6
  call bspush_ca_scan_boa h_rsi
  set h_rdx to 2
  set h_rcx to 0
  set h_rsi to 2
  call testFldeq h_rsi h_rdx h_rcx
  if answer is 0
    set h_r14 to 1
  end
  set h_rdx to h_r14
  place p11781d
  set h_rsi to h_rdx
  set h_r14 to 0
  set unwind to h_rsi
  backtrack
  place p117860
  place t117860_3 on 3
  set h_r12 to unwind
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_1be35c
  call test_string_s h_rsi h_rdx h_rcx
  set s117870 to answer
  set h_rcx to h_r12
  set h_rsi to h_r12
  if s117870 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p11787f
  go to p11778f
  place p117884
  place t117884_6 on 6
  set h_r12 to unwind
  call bspop_boa
  call advance_tok
  set s11788f to answer
  set h_rsi to h_r12
  if s11788f is not 0
    set unwind to h_rsi
    backtrack
  end
  place p11789b
  set h_rsi to addr c100
  set h_rdx to addr c110
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 2
  set h_rdx to 1
  set h_rcx to sym eti_s_1be353
  call insert_2pt_s h_rsi h_rdx h_rcx 0
  set s1178c4 to answer
  set h_rsi to h_r12
  if s1178c4 is not 0
    set unwind to h_rsi
    backtrack
  end
  match
  place p1178e1
  place t1178e1_4 on 4
  set h_r12 to unwind
  set h_rcx to h_r12
  go to p11778f
  place tm_5 on 5
  place tm_7 on 7
  match
end

rule adjust_final_y takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_rcx
  local h_rdx
  place p117904
  place p117944
  place p117977
  set h_rcx to -6
  set h_rdx to arg 1
  call get_parm addr c110 h_rdx h_rcx
  call push_ptr_init addr c100
  call push_ptr_init addr c120
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_1be353
  call fence 1 h_rdx
  set h_rdx to 1
  call lpta_loadp addr c110
  call setscan_l h_rdx
  if answer is not 0
    give up
  end
  place p1179e6
  set h_rcx to sym eti_s_1be35f
  set h_rdx to 1
  call test_string_s 1 h_rdx h_rcx
  if answer is 0
    go to p117a32
  end
  give up
  place p117a32
  call starttest 2
  set h_rdx to 1
  call lpta_loadp addr c110
  call setscan_l h_rdx
  if answer is not 0
    match
  end
  place p117a56
  place p117a61
  place t117a61_3 on 3
  set h_rdx to addr c120
  call savescptr 3 h_rdx
  place p117a73
  place t117a73_4 on 4
  set h_rdx to 2
  call chstream 4 h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117a89
  set h_rdx to 1
  set h_rcx to sym eti_s_1be360
  call test_string_s 2 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117aa6
  place t117aa6_5 on 5
  set h_rdx to addr c100
  call savescptr 5 h_rdx
  set h_rdx to 1
  call lpta_loadp addr c120
  call setscan_r h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117ad2
  call bspush_ca_scan 6
  set h_rdx to 2
  set h_rcx to sym eti_s_1be361
  place p117aed
  call test_string_s 1 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117afa
  place t117afa_7 on 7
  set h_rdx to 1
  set h_rcx to sym eti_s_1be35c
  call test_synch 7 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117b17
  call starttest 9
  set h_rdx to 2
  call lpta_loadp addr c100
  call setscan_l h_rdx
  if answer is 0
    go to p117b72
  end
  place p117b38
  place t117b38_9 on 9
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 1
  set h_rcx to sym eti_s_1be370
  place p117b61
  call insert_2pt_s 2 h_rdx h_rcx 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  match
  place p117b72
  call bspush_ca_scan 10
  set h_rdx to 1
  set h_rcx to sym eti_s_1be36a
  place p117b8d
  call test_string_s 2 h_rdx h_rcx
  if answer is 0
    go to p117c73
  end
  set unwind to 0
  backtrack
  place p117bc9
  place t117bc9_6 on 6
  call bspush_ca_scan 8
  set h_rdx to 3
  set h_rcx to sym eti_s_1be363
  go to p117aed
  place p117be9
  place t117be9_8 on 8
  set h_rdx to 4
  set h_rcx to sym eti_s_1be366
  go to p117aed
  place p117bfe
  place t117bfe_10 on 10
  call bspush_ca_scan 12
  set h_rdx to 1
  set h_rcx to sym eti_s_1be36b
  go to p117b8d
  place p117c1e
  place t117c1e_12 on 12
  call bspush_ca_scan 13
  set h_rdx to 1
  set h_rcx to sym eti_s_1be36c
  go to p117b8d
  place p117c3e
  place t117c3e_13 on 13
  call bspush_ca_scan 14
  set h_rdx to 1
  set h_rcx to sym eti_s_1be36d
  go to p117b8d
  place p117c5e
  place t117c5e_14 on 14
  set h_rdx to 1
  set h_rcx to sym eti_s_1be36e
  go to p117b8d
  place p117c73
  place t117c73_11 on 11
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 1
  set h_rcx to sym eti_s_1be36f
  go to p117b61
  place tm_2 on 2
  place tm_15 on 15
  match
end

rule adjust_mc_prefix takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_rcx
  place p117ce8
  place p117d28
  place p117d5b
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  call push_ptr_init addr c110
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  call fence 1 sym eti_s_1be353
  call starttest 1
  call lpta_loadp addr c120
  call setscan_l 1
  if answer is not 0
    give up
  end
  place p117dd5
  set h_rcx to sym eti_s_1be36d
  call test_string_s 1 1 h_rcx
  if answer is 0
    go to p117e21
  end
  give up
  place p117e21
  call bspush_ca_scan 2
  place p117e37
  place t117e37_3 on 3
  set h_rcx to sym eti_s_1be36e
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117e54
  place t117e54_4 on 4
  set h_rcx to sym eti_s_1be353
  call test_synch 4 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117e71
  call starttest 5
  call lpta_loadp addr c120
  call setscan_l 2
  if answer is not 0
    match
  end
  place p117e96
  place t117e96_6 on 6
  call savescptr 6 addr c100
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117eb4
  place t117eb4_7 on 7
  call savescptr 7 addr c110
  call lpta_loadp addr c100
  call setscan_r 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117edc
  call bspush_ca_scan 8
  set h_rcx to sym eti_s_1be371
  place p117ef7
  call test_string_s 2 1 h_rcx
  if answer is 0
    go to p117f5f
  end
  set unwind to 0
  backtrack
  place p117f2f
  place t117f2f_2 on 2
  set h_rcx to sym eti_s_1be36b
  call test_string_s 1 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p117f48
  go to p117e37
  place p117f4d
  place t117f4d_8 on 8
  set h_rcx to sym eti_s_1be372
  go to p117ef7
  place p117f5f
  place t117f5f_9 on 9
  call delete_phone_from_left addr c110 addr c120
  match
  place tm_5 on 5
  place tm_10 on 10
  match
end

rule post_syll_adjustments takes 3
  instead
  local c108 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local vf8 word
  local h_r14
  local h_rcx
  local s118145
  local s118181
  local s1182f0
  variable g668 word 916
  place p117fa8
  set h_r14 to arg 2
  place p117fe7
  place p11804a
  set h_rcx to -6
  call get_parm addr c148 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c138 arg 2 h_rcx
  call push_ptr_init addr c128
  call push_ptr_init addr c108
  call push_ptr_init addr c118
  set h_r14 to 0
  call fence 0 sym eti_null
  call fence 1 sym eti_s_1be353
  call copy_stress_to_phones addr c148 addr c138
  set vf8 to addr g668
  place p1180f8
  place t1180f8_1 on 1
  set h_r14 to unwind
  call diaphon_based_rules
  place p118100
  place t118100_2 on 2
  set h_r14 to unwind
  call startloop 3
  call copyvar addr c128 addr c148
  call copyvar addr c118 addr c138
  call forall_to_test addr c128 addr c118
  set s118145 to answer
  set h_rcx to h_r14
  if s118145 is not 0
    set unwind to h_r14
    backtrack
  end
  place p118155
  go to p11815a
  place p118157
  place t118157_14 on 14
  set h_r14 to unwind
  set h_rcx to h_r14
  place p11815a
  set h_r14 to h_rcx
  call bspush_ca 5
  call lpta_loadp addr c128
  call setscan_r 3
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p11817e
  call advance_tok
  set s118181 to answer
  set h_rcx to h_r14
  if s118181 is not 0
    set unwind to h_r14
    backtrack
  end
  place p118191
  set h_r14 to h_rcx
  call savescptr 6 addr c108
  place p1181a6
  place t1181a6_4 on 4
  set h_r14 to unwind
  call starttest 7
  call lpta_loadp addr c128
  call setscan_r 3
  if answer is 0
    go to p11829b
  end
  place p1181cb
  place t1181cb_7 on 7
  set h_r14 to unwind
  call morph_based_rules addr c108
  place p1181da
  place t1181da_8 on 8
  set h_r14 to unwind
  call starttest 9
  call lpta_loadp addr c128
  call setscan_r 3
  if answer is 0
    go to p1182a9
  end
  place p1181ff
  place t1181ff_9 on 9
  set h_r14 to unwind
  set global word 920 to cell c128 value
  set global word 928 to cell c108 value
  call syllable_based_rules
  place p118223
  place t118223_11 on 11
  set h_r14 to unwind
  call starttest 12
  call lpta_loadp addr g668
  call setscan_r 3
  if answer is 0
    go to p1182cf
  end
