  set unwind to 0
  backtrack
end

rule inside_orig_inp_token takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_r14
  local h_rsi
  local s3ff61
  place p3fdb0
  set h_r14 to arg 1
  place p3fdf0
  place p3fe23
  set h_rsi to addr c100
  call get_parm h_rsi arg 1 -6
  set h_r14 to addr c110
  set h_rsi to addr c110
  call push_ptr_init h_rsi
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to addr c100
  call lpta_loadpn h_rsi
  set h_rsi to 0
  call lpta_movel h_rsi
  set h_rsi to addr c110
  call lpta_storep h_rsi
  set h_rsi to 1
  call starttest_l h_rsi
  call lpta_loadp addr c110
  set h_rsi to 4
  call lpta_tstctxtr h_rsi
  if answer is not 0
    give up
  end
  place p3feb4
  set h_rsi to 4
  call setscan_r h_rsi
  if answer is 0
    go to p3fef7
  end
  give up
  place p3fef7
  set h_rsi to 2
  call bspush_ca_scan_boa h_rsi
  call lpta_loadp addr c100
  call test_ptr
  set h_rsi to 0
  if answer is 0
    set h_rsi to 1
  end
  set unwind to h_rsi
  backtrack
  place p3ff56
  place t3ff56_2 on 2
  set h_r14 to unwind
  call bspop_boa
  call advance_tok
  set s3ff61 to answer
  set h_rsi to h_r14
  set h_r14 to 0
  if s3ff61 is not 0
    set unwind to h_rsi
    backtrack
  end
  match
end

rule lowercase_and_normalize takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p3ff7c
  place p3ffbf
  place p3ffee
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call convert_to_lowercase addr c110 addr c100
  call normalize_letters addr c110 addr c100
  match
end
