# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule normalize_text takes 3
  instead
  local c100 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  local v108 word
  local v110 word
  local h_rax
  local h_rsi
  local n2e5ae_0
  variable g568 word 788
  variable ga38 word 1494
  variable ga50 word 1520
  place p2e144
  place p2e17f
  place p2e1df
  set h_rsi to addr c140
  call get_parm h_rsi arg 1 -6
  set h_rax to answer
  set h_rsi to addr c120
  call get_parm h_rsi arg 2 -6
  set h_rax to answer
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c160
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c150
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_rax to global word 2320
  set cell c130 value to h_rax
  set cell c100 value to h_rax
  if global half 1456 is not 1
    go to p2e2b9
  end
  place p2e279
  set h_rsi to addr c140
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    go to p2e2b9
  end
  place p2e28f
  set h_rax to cell c120 value
  call lpta_loadp addr c120
  call test_ptr
  set h_rax to answer
  if h_rax is 0
    go to p2e6ba
  end
  place p2e2b9
  set h_rax to addr ga38
  set v110 to addr ga38
  set h_rax to addr g568
  set v108 to addr g568
  place p2e2e3
  place t2e2e3_1 on 1
  and 0 into global half 1500
  set h_rsi to addr ga38
  call count_input h_rsi
  set h_rax to answer
  place p2e2fa
  place t2e2fa_3 on 3
  set h_rsi to 4
  call startloop h_rsi
  set h_rax to answer
  set h_rsi to addr c140
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to addr c120
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c160
  call lpta_storep h_rsi
  set h_rax to answer
  place p2e360
  place t2e360_14 on 14
  set h_rsi to addr c130
  call forall_to_test h_rsi addr c160
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2e372
  place t2e372_41 on 41
  set h_rsi to 6
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call lpta_loadp h_rsi
  call setscan_r 1
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p2e38f
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to p2e3fb
  end
  set unwind to 0
  backtrack
  place p2e3d0
  place t2e3d0_6 on 6
  set h_rsi to 4
  call forto_adv_upto_r h_rsi 5 41 1 addr c130 addr c160
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  match
  place p2e3fb
  place t2e3fb_5 on 5
  set h_rsi to addr c130
  call reset_token_vars h_rsi
  set h_rax to answer
  place p2e406
  place t2e406_7 on 7
  set h_rsi to addr c130
  call merge_adjacent_spaces h_rsi
  set h_rax to answer
  place p2e411
  place t2e411_8 on 8
  set h_rsi to addr c130
  call space h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e427
  place t2e427_9 on 9
  set h_rsi to addr c130
  call process_annotation h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e43d
  place t2e43d_11 on 11
  set h_rsi to addr c130
  call ellipsis h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e453
  place t2e453_12 on 12
  set h_rsi to addr c130
  call three_letter_extension h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2e684
  end
  place p2e466
  place t2e466_13 on 13
  set h_rsi to addr c130
  call interpret_single_char_modes h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e47c
  place t2e47c_15 on 15
  set h_rsi to addr c130
  call tok_lookup h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2e684
  end
  place p2e48f
  place t2e48f_16 on 16
  set h_rsi to addr c130
  call punctuation h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e4a5
  place t2e4a5_17 on 17
  set h_rsi to addr c130
  call parenthesis h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e4bb
  place t2e4bb_18 on 18
  set h_rsi to addr c130
  call apostrophe h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e4d1
  place t2e4d1_19 on 19
  set h_rsi to addr c130
  call email_address h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2e684
  end
  place p2e4e4
  place t2e4e4_20 on 20
  set h_rsi to addr c130
  call URL h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2e684
  end
  place p2e4f7
  place t2e4f7_21 on 21
  set h_rsi to addr c130
  call is_pathname h_rsi
  set h_rax to answer
  if h_rax is 0
    go to p2e684
  end
  place p2e50a
  place t2e50a_22 on 22
  set h_rsi to addr c130
  call letter_sequence h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e51c
  place t2e51c_23 on 23
  set h_rsi to addr c130
  call convert_digits_to_words h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e52e
  place t2e52e_24 on 24
  set h_rsi to addr c130
  call hyphen h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e540
  place t2e540_25 on 25
  set h_rsi to addr c130
  call slash h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e552
  place t2e552_26 on 26
  set h_rsi to addr c130
  call quote_mark h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e564
  place t2e564_27 on 27
  set h_rsi to addr c130
  call span_inverted_punct h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e576
  place t2e576_28 on 28
  set h_rsi to addr c130
  call bracket h_rsi addr c100
  set h_rax to answer
  if h_rax is 0
    go to p2e596
  end
  place p2e588
  place t2e588_29 on 29
  set h_rsi to addr c130
  call misc_chars h_rsi addr c100
  set h_rax to answer
  place p2e596
  place t2e596_10 on 10
  set h_rsi to addr c130
  call init_ptr_End_reproc_string h_rsi addr c100
  set h_rax to answer
  place p2e5a4
  place t2e5a4_30 on 30
  set h_rax to global half 1642
  add -10 to h_rax
  set n2e5ae_0 to h_rax
  and 65535 into n2e5ae_0
  if n2e5ae_0 is below 65527
    go to p2e5c2
  end
  place p2e5b4
  set h_rsi to addr c130
  call build_words h_rsi addr c100
  set h_rax to answer
  place p2e5c2
  place t2e5c2_31 on 31
  set h_rax to cell c100 value
  set global word 1524 to h_rax
  set h_rsi to addr c100
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to addr g568
  call rpta_loadpn h_rsi
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    go to p2e60b
  end
  place p2e5f6
  call testeq
  set h_rax to answer
  if h_rax is not 0
    go to p2e60b
  end
  place p2e602
  set global half 1500 to 1
  place p2e60b
  place t2e60b_32 on 32
  set h_rsi to addr c100
  call forced_synthesis h_rsi
  set h_rax to answer
  if h_rax is 0
    match
  end
  place p2e61e
  place t2e61e_33 on 33
  if global half 1566 is 0
    go to p2e636
  end
  place p2e628
  set h_rsi to addr c130
  call build_phrases h_rsi addr c100
  set h_rax to answer
  place p2e636
  place t2e636_34 on 34
  if global half 1500 is 1
    go to p2e69d
  end
  place p2e640
  place t2e640_35 on 35
  if global half 1460 is 1
    match
  end
  place p2e64a
  place t2e64a_40 on 40
  set h_rsi to addr c100
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 1
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c150
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to 4
  call forall_cont_from h_rsi 5 0 addr c130 addr c150
  set h_rax to answer
  go to p2e360
  place p2e684
  set h_rsi to 4
  call forall_cont_from h_rsi 5 0 addr c130 addr c130
  set h_rax to answer
  go to p2e360
  place p2e69d
  if global half 1456 is 0
    go to p2e6d8
  end
  place p2e6a7
  place t2e6a7_36 on 36
  if global half 1460 is not 0
    match
  end
  place p2e6b1
  set h_rsi to addr c100
  go to p2e6c1
  place p2e6ba
  set h_rsi to addr c120
  place p2e6c1
  call handle_end_of_delta h_rsi
  set h_rax to answer
  match
  place p2e6d8
  set h_rsi to addr ga50
  call create_final_sync h_rsi addr c100
  set h_rax to answer
  match
  place tm_2 on 2
  place tm_4 on 4
  place tm_37 on 37
  place tm_38 on 38
  place tm_39 on 39
  match
end

rule handle_end_of_delta takes 2
  instead
  local cf0 bytes 8
  local h_r14
  local s2e884
  place p2e79c
  set h_r14 to arg 1
  place p2e7d0
  place p2e82c
  call get_parm addr cf0 arg 1 -6
  set h_r14 to 0
  call fence 0 sym eti_null
  call starttest 1
  call bspush_ca_boa 2
  call lpta_loadp addr cf0
  call setscan_l 4
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p2e881
  call advance_tok
  set s2e884 to answer
  set h_r14 to 0
  set h_r14 to 0
  if s2e884 is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place p2e8c2
  place t2e8c2_1 on 1
  call create_sentence addr cf0
  match
  place p2e8d3
  place t2e8d3_2 on 2
  call bspop_boa
  set global half 1516 to 1
  match
  place tm_3 on 3
  match
end

rule reset_token_vars takes 2
  instead
  local ce0 bytes 8
  local h_rax
  place p2e8f8
  place p2e92a
  place p2e984
  call get_parm addr ce0 arg 1 -6
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into global half 1934
  set h_rax to 1
  if global half 1938 is 1
    go to p2e9d6
  end
  place p2e9c0
  if global half 1942 is not 1
    go to p2e9d4
  end
  place p2e9ca
  if global half 1642 is 0
    go to p2e9d6
  end
  place p2e9d4
  set h_rax to 0
  place p2e9d6
  set global half 1942 to h_rax
  and 0 into global half 1938
  set h_rax to global half 1642
  if h_rax is 0
    go to p2e9f8
  end
  place p2e9f1
  set global half 1638 to h_rax
  place p2e9f8
  and 0 into global half 1642
  and 0 into global half 1698
  and 0 into global half 1726
  and 0 into global half 1926
  and 0 into global half 1850
  and 0 into global half 1566
  and 0 into global half 1818
  and 0 into global half 1646
  and 0 into global half 1554
  and 0 into global half 1834
  match
end

rule merge_adjacent_spaces takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_r12
  local h_r13
  local h_rcx
  local s2eb7f
  local s2ebb7
  place p2ea5c
  place p2ea98
  place p2eafb
  set h_r13 to addr c120
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  call push_ptr_init addr c110
  call push_ptr_init addr c100
  set h_r12 to 0
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c120
  call setscan_l 1
  if answer is 0
    go to p2eb6b
  end
  match
  place p2eb6b
  set h_rcx to sym eti_s_1b90d7
  call test_string_s 1 1 h_rcx
  set s2eb7f to answer
  set h_r13 to 0
  if s2eb7f is not 0
    match
  end
  place p2eb8f
  set h_r12 to 0
  place p2eb92
  place t2eb92_2 on 2
  set h_r12 to unwind
  set h_r13 to h_r12
  call savescptr 2 addr c100
  set h_rcx to sym eti_s_1b90d7
  call test_string_s 1 1 h_rcx
  set s2ebb7 to answer
  set h_rcx to h_r12
  if s2ebb7 is not 0
    go to p2ec05
  end
  place p2ebc3
  place t2ebc3_3 on 3
  set h_r12 to unwind
  call savescptr 3 addr c110
  call starttest_l 1
  call bspush_ca_boa 4
  call lpta_loadp addr c100
  call setscan_l 0
  if answer is 0
    set h_r12 to 1
  end
  set h_rcx to h_r12
  place p2ec05
  set h_r12 to h_rcx
  set unwind to h_r12
  backtrack
  place p2ec41
  place t2ec41_4 on 4
  set h_r12 to unwind
  call bspop_boa
  call lpta_rpta_loadp addr c110 addr c120
  set h_r13 to 0
  set h_rcx to sym eti_s_1b90d7
  call insert_2pt_s 1 1 h_rcx 0
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  match
  place tm_1 on 1
  match
end

rule space takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p2eca0
  place p2ece3
  place p2ed16
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p2ed6b
  call test_string_s 1 1 sym eti_s_1b90d7
  if answer is not 0
    give up
  end
  place p2ed83
  call savescptr 2 addr c100
  put cell c100 value into arg 2 at 4
  match
end

rule ellipsis takes 3
  instead
  local c100 bytes 8
  local c118 bytes 8
  local v108 word
  place p2edd5
  set v108 to arg 2
  place p2ee18
  place p2ee47
  call get_parm addr c118 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  if global half 1782 is not global half 1770
    go to p2eecb
  end
  give up
  place p2eecb
  place p2eede
  place t2eede_1 on 1
  call starttest 3
  call lpta_loadp addr c118
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p2eeff
  call bspush_ca_scan 4
  call test_string_s 1 2 sym eti_s_1b9107
  if answer is 0
    go to p2f09d
  end
  set unwind to 0
  backtrack
  place p2ef5c
  place t2ef5c_5 on 5
  place t2ef5c_7 on 7
  place t2ef5c_9 on 9
  call savescptr 7 addr c100
  set global half 1642 to global half 1686
  call lpta_loadp addr c118
  call lpta_tstctxtl 4
  if answer is not 0
    go to p2efb8
  end
  place p2efa5
  call setscan_l 5
  if answer is 0
    go to p2f149
  end
  place p2efb8
  place t2efb8_11 on 11
  call skip_delimiters addr c100
  place p2efc7
  place t2efc7_14 on 14
  call starttest 15
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p2f0bb
  end
  place p2efec
  call testFldeq 1 3 4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2f005
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2f015
  go to p2f0f9
  place p2f01a
  call bspush_ca_scan 7
  place p2f025
  place t2f025_8 on 8
  call test_string_s 1 1 sym eti_s_1b910e
  if answer is 0
    go to p2f01a
  end
  place p2f03e
  set unwind to 0
  backtrack
  place p2f043
  place t2f043_4 on 4
  call bspush_ca_scan 8
  call test_string_s 1 3 sym eti_s_1b9109
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p2f06b
  go to p2f078
  place p2f06d
  call bspush_ca_scan 9
  place p2f078
  place t2f078_10 on 10
  call test_string_s 1 2 sym eti_s_1b910c
  if answer is 0
    go to p2f06d
  end
  place p2f08d
  set unwind to 0
  backtrack
  place p2f092
  call bspush_ca_scan 5
  place p2f09d
  place t2f09d_6 on 6
  call test_string_s 1 1 sym eti_s_1b90de
  if answer is 0
    go to p2f092
  end
  place p2f0b6
  set unwind to 0
  backtrack
  place p2f0bb
  place t2f0bb_15 on 15
  call build_phrase_final_structure addr c100
  place p2f0ca
  place t2f0ca_17 on 17
  set global half 1794 to global half 1798
  place p2f0d8
  place t2f0d8_2 on 2
  place t2f0d8_12 on 12
  place t2f0d8_13 on 13
  place t2f0d8_16 on 16
  put cell c100 value into arg 2 at 4
  match
  place p2f0f9
  call lpta_loadp addr c100
  call setscan_r 1
  if answer is not 0
    go to p2f0d8
  end
  place p2f10f
  call test_string_s 1 1 sym eti_s_1b9102
  if answer is not 0
    go to p2f0d8
  end
  place p2f127
  set global half 1794 to global half 1798
  call punctuation addr c100 addr c100
  go to p2f0d8
  place p2f149
  call skip_punct_and_delimiters addr c100
  go to p2f0d8
end

rule three_letter_extension takes 2
  instead
  local c100 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local v108 word
  local h_r15
  local h_rax
  local h_rcx
  local h_rdx
  local h_rsi
  local s2f2d0
  local s2f30b
  local s2f35d
  local s2f39b
  local s2f3cd
  local s2f3fa
  local s2f41a
  local s2f455
  local s2f480
  local s2f5fa
  variable gdd0 word 2316
  place p2f1a8
  place p2f1e4
  place p2f217
  set h_rsi to addr c118
  set h_rcx to -6
  set h_rdx to arg 1
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c138
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c128
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c148
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rdx to sym eti_null
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rax to global half 1774
  if h_rax is not global half 1770
    give up
  end
  place p2f28d
  set h_rax to addr gdd0
  set v108 to addr gdd0
  set h_rsi to 3
  set h_r15 to 0
  place p2f2b0
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 4
  call bspush_ca h_rsi
  set h_rax to answer
  set h_rsi to addr c118
  set h_rdx to 4
  call lpta_loadp h_rsi
  call setscan_l h_rdx
