rule find_lang_potential_phrase takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local h_rax
  local h_rcx
  local h_rdx
  place p3783
  place p37c1
  place p3821
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c110 h_rdx h_rcx
  set h_rax to answer
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c100 h_rdx h_rcx
  set h_rax to answer
  set h_rcx to -4
  set h_rdx to arg 3
  call get_parm addr cf0 h_rdx h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to global half 3630
  set h_rcx to addr c110
  set h_rcx to cell c110 value
  if h_rax is not global half 3626
    go to p38de
  end
  place p3887
  set global word 760 to h_rcx
  set h_rax to cell c100 value
  set global word 768 to h_rax
  set h_rax to cell cf0 field
  set global half 4166 to h_rax
  call find_eng_potential_phrase
  set h_rax to answer
  set h_rcx to global word 760
  set cell c110 value to h_rcx
  set h_rdx to global word 768
  set cell c100 value to h_rdx
  set h_rax to global half 4166
  set cell cf0 field to h_rax
  go to p38ec
  place p38de
  set h_rdx to cell c100 value
  set h_rax to cell cf0 field
  place p38ec
  put h_rcx into arg 1 at 4
  put h_rdx into arg 2 at 4
  put h_rax into arg 3 at 2 half
  match
end

