# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule tok_dict takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  place p121b
  place p1254
  place p12b2
  call get_parm addr c100 arg 1 -6
  call get_parm addr cf0 arg 2 -6
  call fence 0 sym eti_null
  if global half 3630 is not global half 3626
    match
  end
  place p12f8
  call starttest_e 2
  call bspush_ca_boa 3
  call eng_tok_dict addr c100 addr cf0
  if answer is 0
    set unwind to 1
  end
  if answer is not 0
    set unwind to 0
  end
  backtrack
  place p136a
  place t136a_3 on 3
  call bspop_boa
  give up
  place tm_1 on 1
  place tm_2 on 2
  match
end

