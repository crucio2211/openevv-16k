  end
  if answer is not 0
    set unwind to 0
  end
  backtrack
  place p14f6
  place t14f6_1 on 1
  place t14f6_2 on 2
  put cell c120 value into arg 2 at 4
  put cell c110 value into arg 3 at 4
  put cell c100 value into arg 4 at 4
  match
  place p1530
  place t1530_3 on 3
  call bspop_boa
  give up
end

