  set h_r12 to unwind
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to 2
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r12
  if h_rax is not 0
