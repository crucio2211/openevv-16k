  end
  place pd0905
  go to pd097b
  place pd0907
  place td0907_20 on 20
  set h_r12 to unwind
  set h_rsi to 20
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  set h_rsi to 21
