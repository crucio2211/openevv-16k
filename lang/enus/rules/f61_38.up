# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule adjust_eng_accents takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local c158 bytes 8
  local v118 word
  local h_rcx
  local h_rdx
  variable gc9c word 2064
  place pcfd58
  place pcfd93
  place pcfdf3
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c158 h_rdx h_rcx
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c148 h_rdx h_rcx
  call push_ptr_init addr c100
  call push_ptr_init addr c110
  call push_ptr_init addr c138
  call push_ptr_init addr c128
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_1bdb00
  call fence 1 h_rdx
  call startloop 1
  call lpta_loadpn addr c158
  call lpta_mover 4
  call lpta_storep addr c100
  call lpta_loadpn addr c148
  call lpta_mover 4
  call lpta_storep addr c138
  set v118 to addr gc9c
  place pcfefc
  place tcfefc_13 on 13
  set h_rdx to addr c138
  call forall_to_test addr c100 h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pcff1a
  place tcff1a_14 on 14
  call bspush_ca 3
  set h_rdx to 4
  call lpta_loadp addr c100
  call setscan_r h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pcff3f
  set h_rdx to 7
  call npush_fld 4 h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pcff55
  call npush_v addr gc9c
  call if_testeq
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pcff74
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pcff84
  place tcff84_4 on 4
  set h_rdx to addr c110
  call savescptr 4 h_rdx
  place pcff96
  place tcff96_2 on 2
  call starttest 5
  call lpta_loadp addr c110
  call setscan_nof_l 4
  if answer is 0
    go to pd0017
  end
  place pcffca
  place tcffca_5 on 5
  set h_rdx to addr c110
  call is_minor_phrase_break addr c100 h_rdx
  if answer is not 0
    go to pd01c5
  end
  place pcffe8
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 11
  set h_rcx to 20
  call mark_i 4 h_rdx h_rcx 0
  go to pd01c5
  place pd0017
  place td0017_6 on 6
  set h_rdx to addr c128
  call savescptr 6 h_rdx
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd0035
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd0041
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd004d
  call lpta_loadp addr c128
  call setscan_nof_r 4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd0076
  call bspush_ca_scan 7
  set h_rdx to 1
  set h_rcx to 17
  go to pd0175
  place pd00c0
  place td00c0_3 on 3
  set h_rcx to addr c138
  set h_rdx to 2
  set h_rcx to 14
  call forto_adv_upto_r 1 h_rdx h_rcx 4 addr c100 addr c138
  if answer is not 0
    set unwind to 0
    backtrack
  end
  match
  place pd00f1
  place td00f1_9 on 9
  call bspush_ca_scan 10
  set h_rdx to 1
  set h_rcx to 14
  call testFldeq 4 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd0111
  go to pd016a
  place pd0113
  place td0113_11 on 11
  set h_rdx to 1
  set h_rcx to 5
  call testFldeq 4 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd012c
  set h_rdx to 2
  set h_rcx to 32
  go to pd0175
  place pd0139
  place td0139_7 on 7
  call bspush_ca_scan 9
  set h_rdx to 1
  set h_rcx to 4
  go to pd0176
  place pd0152
  place td0152_10 on 10
  call bspush_ca_scan 11
  set h_rdx to 1
  set h_rcx to 19
  go to pd0175
  place pd016a
  set h_rdx to 2
  set h_rcx to 31
  place pd0175
  place pd0176
  call testFldeq 4 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd0183
  place td0183_8 on 8
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd0193
  set h_rdx to addr c110
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rdx to 11
  set h_rcx to 10
  call mark_i 4 h_rdx h_rcx 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pd01c5
  place td01c5_12 on 12
  call lpta_loadpn addr c110
  call lpta_mover 4
  call lpta_storep addr c128
  set h_rdx to 2
  set h_rcx to addr c100
  call forall_cont_from 1 h_rdx 0 h_rcx addr c128
  go to pcfefc
  place tm_1 on 1
  match
end

rule is_minor_phrase_break takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_r12
  local h_r15
  local h_rax
  local h_rcx
  local h_rdx
  local h_rsi
  local sd0564
  place pd0260
  set h_r12 to arg 1
  place pd029b
  place pd02fb
  set h_r15 to addr c120
  set h_rsi to addr c120
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c110
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rdx to sym eti_null
  set h_r12 to 0
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rdx to sym eti_s_1bdb00
  set h_rsi to 1
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rdx to 4
  set h_rsi to addr c120
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to pd0399
  end
  place pd0383
  call advance_tok
  set h_rax to answer
  set h_r15 to 0
  set h_r12 to 0
  if h_rax is 0
    go to pd0513
  end
  place pd0399
  place td0399_1 on 1
  set h_r12 to unwind
  set h_r15 to h_r12
  set h_rsi to 5
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  set h_rdx to 4
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to pd03cd
  end
  place pd03bd
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to pd04ee
  end
  place pd03cd
  set h_rsi to 10
  call starttest h_rsi
  set h_rax to answer
  set h_rax to cell c110 value
  call lpta_loadp addr c110
  set h_rsi to 4
  call setscan_nof_l h_rsi
  set h_rax to answer
  set h_r12 to h_r15
  set h_rcx to h_r15
  if h_rax is 0
    go to pd08c9
  end
  place pd040b
  set h_r15 to h_rcx
  set h_rsi to 19
  call starttest h_rsi
  set h_rax to answer
  set h_rax to cell c110 value
  call lpta_loadp addr c110
  set h_rsi to 4
  call setscan_nof_l h_rsi
  set h_rax to answer
  set h_r12 to h_r15
  set h_rcx to h_r15
  if h_rax is 0
    go to pd0907
  end
  place pd044c
  set h_r12 to h_rcx
  set h_rsi to 26
  call starttest h_rsi
  set h_rax to answer
  set h_rax to cell c120 value
  call lpta_loadp addr c120
  set h_rsi to 4
  call setscan_nof_r h_rsi
  set h_rax to answer
  set h_r15 to h_r12
  if h_rax is 0
    go to pd0ac1
  end
  place pd048a
  place td048a_26 on 26
  set h_r12 to unwind
  set h_rsi to 34
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c120
  set h_rdx to 4
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place pd04af
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to 10
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    go to pd04e6
  end
  place pd04c4
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    go to pd04e6
  end
  place pd04d0
  set h_rsi to addr c110
  set h_rdx to 4
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pd0501
  end
  place pd04e6
  set h_r15 to h_r12
  go to pd0b43
  place pd04ee
  set h_rsi to 6
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to h_r15
  go to pd0953
  place pd0501
  set h_rcx to 10
  set h_rsi to 35
  go to pd0b1d
  place pd0510
  place td0510_2 on 2
  set h_r12 to unwind
  set h_r15 to h_r12
  place pd0513
  set h_rsi to 2
  set h_rdx to 1
  call chstream h_rsi h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to pd0b43
  end
  place pd0529
  set h_rcx to sym eti_s_1bdba3
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_r12 to h_r15
  if h_rax is not 0
    go to pd0b43
  end
  place pd0548
  place td0548_3 on 3
  set h_r12 to unwind
  set h_r15 to h_r12
  set h_rsi to 3
  set h_rdx to 4
  call chstream h_rsi h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to pd0b43
  end
  place pd0561
  call advance_tok
  set sd0564 to answer
  set h_rax to sd0564
  place pd0569
  if h_rax is not 0
    go to pd0b43
  end
  give up
  place pd05a8
  place td05a8_6 on 6
  set h_r12 to unwind
  set h_rsi to 8
  call bspush_ca_scan h_rsi
  set h_rax to answer
  go to pd05c4
  place pd05b5
  place td05b5_8 on 8
  set h_r12 to unwind
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd05c4
  place td05c4_9 on 9
  set h_r12 to unwind
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r12
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd05d6
  go to pd0953
  place pd05db
  place td05db_12 on 12
  set h_r12 to unwind
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rcx to 1
  set h_rdx to 1
  go to pd05fe
  place pd05f3
  place td05f3_14 on 14
  set h_r12 to unwind
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to 0
  place pd05fe
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rcx to h_r12
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd0611
  go to pd097b
  place pd0616
  place td0616_16 on 16
  set h_r12 to unwind
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to 2
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd0632
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r12
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd0648
  go to pd09c3
  place pd064d
  place td064d_17 on 17
  set h_r12 to unwind
  set h_rsi to 4
  set h_rdx to 2
  set h_rcx to 7
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rcx to h_r12
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd066c
  go to pd09fd
  place pd0671
  place td0671_21 on 21
  set h_r12 to unwind
  set h_rsi to 23
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rcx to 1
  set h_rdx to 1
  go to pd0694
  place pd0689
  place td0689_23 on 23
  set h_r12 to unwind
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to 0
  place pd0694
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rcx to h_r12
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd06a7
  go to pd0a3a
  place pd06ac
  place td06ac_25 on 25
  set h_r12 to unwind
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to 2
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd06c8
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r12
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd06de
  go to pd0a82
  place pd06e3
  place td06e3_28 on 28
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  call advance_tok
  set h_rax to answer
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pd06fe
  set h_rax to cell c100 value
  call lpta_loadp addr c100
  set h_rsi to 4
  call setscan_nof_l h_rsi
  set h_rax to answer
  go to pd0773
  place pd0725
  place td0725_30 on 30
  set h_r12 to unwind
  set h_rsi to 32
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to 3
  go to pd0757
  place pd073a
  place td073a_32 on 32
  set h_r12 to unwind
  set h_rsi to 4
  set h_rdx to 2
  set h_rcx to 18
  go to pd0757
  place pd0744
  place td0744_33 on 33
  set h_r12 to unwind
  set h_rsi to 30
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rdx to 1
  set h_rcx to 2
  place pd0757
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r12
