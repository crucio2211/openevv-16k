    backtrack
  end
  place pd077e
  place td077e_29 on 29
  set h_r12 to unwind
  set h_rsi to 33
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rdx to 2
  set h_rcx to 31
  call testFldeq h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to h_r12
  if h_rax is not 0
