  place pd08c9
  place td08c9_11 on 11
  set h_r12 to unwind
  set h_rsi to 11
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  set h_rsi to 12
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
