    backtrack
  end
  place pd0810
  place td0810_36 on 36
  set h_r12 to unwind
  set h_rsi to 37
  call bspush_ca_scan h_rsi
  set h_rax to answer
  place pd081b
  place td081b_38 on 38
  set h_r12 to unwind
  set h_rsi to 39
  call bspush_ca_scan h_rsi
  set h_rax to answer
  place pd0826
  place td0826_40 on 40
  set h_r12 to unwind
  set h_rsi to 41
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rdx to 1
