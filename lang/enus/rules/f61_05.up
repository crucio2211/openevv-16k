# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule run_filters takes 3
  instead
  local ce0 bytes 8
  local ce4 bytes 8
  local h_rax
  local nd9c8_0
  local nda02_0
  local nda07_0
  local nda61_0
  variable g1330 word 3372
  place pd8af
  place pd8e8
  place pd942
  call get_parm addr ce0 arg 1 -4
  set h_rax to answer
  call get_parm addr ce4 arg 2 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set global half 3374 to 5
  call if_testneq_v_i addr g1330 50
  set h_rax to answer
  if h_rax is not 0
    go to pd9eb
  end
  place pd99a
  if cell ce0 field is at least 6
    go to pd9ab
  end
  place pd9a4
  go to pd9d5
  place pd9ab
  place td9ab_2 on 2
  call starttest 1
  set h_rax to answer
  call bspush_ca 4
  set h_rax to answer
  set h_rax to global half 1170
  place pd9c8
  set nd9c8_0 to h_rax
  and 65535 into nd9c8_0
  if nd9c8_0 is not cell ce0 field
    set unwind to 0
    backtrack
  end
  place pd9d5
  place td9d5_5 on 5
  call size_filter addr ce0 addr ce4
  set h_rax to answer
  place pd9eb
  place td9eb_1 on 1
  place td9eb_3 on 3
  place td9eb_6 on 6
  set h_rax to global half 2926
  if h_rax is not global half 2918
    go to pda23
  end
  place pd9fb
  set h_rax to cell ce0 field
  set nda02_0 to h_rax
  shift left 16 into nda02_0
  shift right 16 into nda02_0
  if nda02_0 is at most 0
    go to pda23
  end
  place pda07
  set nda07_0 to h_rax
  shift left 16 into nda07_0
  shift right 16 into nda07_0
  if nda07_0 is more than 5
    go to pda23
  end
  place pda0d
  call filter_by_range addr ce0 addr ce4
  set h_rax to answer
  place pda23
  place tda23_7 on 7
  set global half 3374 to 3
  call if_testeq_v_i addr g1330 8000
  set h_rax to answer
  if h_rax is not 0
    go to pdaf2
  end
  place pda44
  call starttest_l 8
  set h_rax to answer
  call bspush_ca 9
  set h_rax to answer
  set h_rax to global half 1146
  place pda61
  set nda61_0 to h_rax
  and 65535 into nda61_0
  if nda61_0 is cell ce0 field
    go to pdadc
  end
  set unwind to 0
  backtrack
  place pda9f
  place tda9f_4 on 4
  set h_rax to global half 1174
  go to pd9c8
  place pdaab
  place tdaab_9 on 9
  call bspush_ca 11
  set h_rax to answer
  set h_rax to global half 1150
  go to pda61
  place pdabf
  place tdabf_11 on 11
  call bspush_ca 12
  set h_rax to answer
  set h_rax to global half 1166
  go to pda61
  place pdad3
  place tdad3_12 on 12
  set h_rax to global half 1170
  go to pda61
  place pdadc
  place tdadc_10 on 10
  call eightkHz_filter addr ce0 addr ce4
  set h_rax to answer
  place pdaf2
  place tdaf2_8 on 8
  set h_rax to cell ce4 field
  put h_rax into arg 2 at 2 half
  match
end

rule size_filter takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
  local h_rcx
  local h_xmm0
  local ndc1a_0
  local ndd02_0
  variable g1330 word 3372
  place pdb40
  place pdb7b
  place pdbdb
  set h_rcx to -4
  call get_parm addr cf4 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf0 arg 2 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  set ndc1a_0 to h_rax
  shift left 16 into ndc1a_0
  shift right 16 into ndc1a_0
  if ndc1a_0 is at most 5
    go to pdc6d
  end
  place pdc20
  if global half 1174 is not h_rax
    go to pdc97
  end
  place pdc29
  set global half 3374 to 5
  call if_testge_v_i addr g1330 40
  set h_rax to answer
  if h_rax is not 0
    go to pdd12
  end
  place pdc4c
  set h_rax to global half 2922
  if h_rax is not global half 2918
    go to pdd12
  end
  place pdc60
  shift left 3 into cell cf0 field
  go to pdd12
  place pdc6d
  set h_rax to cell cf0 field
  set h_rcx to global signed half 3350
  multiply h_rax into h_rcx
  set h_xmm0 to h_rcx
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf0 field to h_rax
  go to pdd12
  place pdc97
  if global half 1170 is not h_rax
    go to pdd12
  end
  place pdca0
  set global half 3374 to 4
  call if_testneq_v_i addr g1330 0
  set h_rax to answer
  if h_rax is not 0
    go to pdd12
  end
  place pdcc1
  set global half 3374 to 5
  call if_testge_v_i addr g1330 40
  set h_rax to answer
  set h_rcx to cell cf0 field
  if h_rax is not 0
    go to pdd02
  end
  place pdce3
  set h_rax to h_rcx
  shift left 4 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set h_rcx to h_rax
  set cell cf0 field to h_rax
  place pdd02
  set ndd02_0 to h_rcx
  shift left 16 into ndd02_0
  shift right 16 into ndd02_0
  if ndd02_0 is less than 3001
    go to pdd12
  end
  place pdd09
  set cell cf0 field to 3000
  place pdd12
  set h_rax to cell cf0 field
  put h_rax into arg 2 at 2 half
  match
end

rule filter_by_range takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
  local h_rcx
  local h_xmm0
  local nde1c_0
  local nde26_0
  local nde30_0
  local nde5c_1
  local nde69_1
  local ndf57_0
  local ndf69_0
  local ndfe2_0
  local ndffc_0
  local ne029_0
  local ne02f_0
  local ne035_0
  place pdd32
  place pdd6d
  place pddcd
  set h_rcx to -4
  call get_parm addr cf4 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf0 arg 2 h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  if global half 1138 is not h_rax
    go to pde4c
  end
  place pde15
  set h_rax to cell cf0 field
  set nde1c_0 to h_rax
  shift left 16 into nde1c_0
  shift right 16 into nde1c_0
  if nde1c_0 is at most 350
    go to pe04a
  end
  place pde26
  set nde26_0 to h_rax
  shift left 16 into nde26_0
  shift right 16 into nde26_0
  if nde26_0 is at most 500
    go to pdf3e
  end
  place pde30
  set nde30_0 to h_rax
  shift left 16 into nde30_0
  shift right 16 into nde30_0
  if nde30_0 is more than 650
    go to pdfac
  end
  place pde3a
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11800 over 10000
  go to pe066
  place pde4c
  place pde5a
  set h_rcx to h_rax
  set nde5c_1 to h_rax
  and 65535 into nde5c_1
  if global half 1142 is nde5c_1
    go to pe022
  end
  place pde69
  set nde69_1 to h_rax
  and 65535 into nde69_1
  if global half 1146 is nde69_1
    go to pe00d
  end
  place pde76
  place tde76_12 on 12
  call starttest 13
  set h_rax to answer
  set h_rax to global half 1150
  if h_rax is not cell cf4 field
    go to pdeab
  end
  place pde91
  call bspush_ca 14
  set h_rax to answer
  if global signed half 3290 is at most 0
    set unwind to 0
    backtrack
  end
  place pdea6
  go to pdf62
  place pdeab
  place tdeab_13 on 13
  call starttest 6
  set h_rax to answer
  set h_rax to global half 1154
  if h_rax is not cell cf4 field
    go to pe071
  end
  place pdeca
  call bspush_ca 19
  set h_rax to answer
  if global signed half 3298 is more than 0
    go to pdf50
  end
  set unwind to 0
  backtrack
  place pdf0e
  place tdf0e_14 on 14
  if global signed half 3294 is at most 0
    set unwind to 0
    backtrack
  end
  place pdf18
  go to pdf62
  place pdf1a
  place tdf1a_19 on 19
  if global signed half 3302 is at most 0
    set unwind to 0
    backtrack
  end
  place pdf24
  go to pdf50
  place pdf26
  place tdf26_7 on 7
  set h_rax to cell cf4 field
  go to pde69
  place pdf32
  place tdf32_1 on 1
  set h_rax to cell cf4 field
  go to pde5a
  place pdf3e
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11000 over 10000
  go to pe066
  place pdf50
  place tdf50_20 on 20
  set h_rax to cell cf0 field
  set ndf57_0 to h_rax
  shift left 16 into ndf57_0
  shift right 16 into ndf57_0
  if ndf57_0 is at most 2700
    go to pdf6f
  end
  place pdf5d
  go to pdffa
  place pdf62
  place tdf62_15 on 15
  set h_rax to cell cf0 field
  set ndf69_0 to h_rax
  shift left 16 into ndf69_0
  shift right 16 into ndf69_0
  if ndf69_0 is more than 3000
    go to pdfe0
  end
  place pdf6f
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12000 over 10000
  go to pe066
  place pdf81
  place tdf81_18 on 18
  place tdf81_23 on 23
  set h_rax to cell cf0 field
  go to pe059
  place pdf8d
  place tdf8d_2 on 2
  set h_rax to cell cf0 field
  go to pde26
  place pdf99
  place tdf99_4 on 4
  set h_rax to cell cf0 field
  go to pde30
  place pdfa5
  place tdfa5_5 on 5
  set h_rax to cell cf0 field
  place pdfac
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12500 over 10000
  go to pe066
  place pdfbe
  place tdfbe_8 on 8
  set h_rax to cell cf0 field
  go to pe02f
  place pdfc7
  place tdfc7_10 on 10
  set h_rax to cell cf0 field
  go to pe035
  place pdfd0
  place tdfd0_11 on 11
  set h_rax to cell cf0 field
  go to pe03b
  place pdfd9
  place tdfd9_16 on 16
  set h_rax to cell cf0 field
  place pdfe0
  set h_rcx to h_rax
  set ndfe2_0 to h_rax
  shift left 16 into ndfe2_0
  shift right 16 into ndfe2_0
  if ndfe2_0 is less than 3651
    go to pe059
  end
  place pdfe8
  set cell cf0 field to 4200
  go to pe071
  place pdff3
  place tdff3_21 on 21
  set h_rax to cell cf0 field
  place pdffa
  set h_rcx to h_rax
  set ndffc_0 to h_rax
  shift left 16 into ndffc_0
  shift right 16 into ndffc_0
  if ndffc_0 is less than 4000
    go to pe059
  end
  place pe002
  set cell cf0 field to 4600
  go to pe071
  place pe00d
  set h_rax to cell cf0 field
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11900 over 10000
  go to pe066
  place pe022
  set h_rax to cell cf0 field
  set ne029_0 to h_rax
  shift left 16 into ne029_0
  shift right 16 into ne029_0
  if ne029_0 is at most 1100
    go to pe04a
  end
  place pe02f
  set ne02f_0 to h_rax
  shift left 16 into ne02f_0
  shift right 16 into ne02f_0
  if ne02f_0 is at most 1300
    go to pe059
  end
  place pe035
  set ne035_0 to h_rax
  shift left 16 into ne035_0
  shift right 16 into ne035_0
  if ne035_0 is at most 1700
    go to pe08c
  end
  place pe03b
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 12100 over 10000
  go to pe066
  place pe04a
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10700 over 10000
  go to pe066
  place pe059
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11500 over 10000
  place pe066
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf0 field to h_rax
  place pe071
  place te071_3 on 3
  place te071_6 on 6
  place te071_9 on 9
  place te071_17 on 17
  place te071_22 on 22
  set h_rax to cell cf0 field
  put h_rax into arg 2 at 2 half
  match
  place pe08c
  shift left 16 into h_rax
  shift right 16 into h_rax
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 11700 over 10000
  go to pe066
end

rule eightkHz_filter takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rax
  local h_rcx
  local h_rdx
  local h_xmm0
  local ne1e7_0
  local ne21a_0
  local ne282_0
  local ne2fd_0
  local ne31a_0
  local ne32c_0
  local scratch
  local fe335
  variable g1330 word 3372
  place pe0fc
  place pe137
  place pe197
  set h_rdx to arg 1
  set h_rcx to -4
  call get_parm addr cf4 h_rdx h_rcx
  set h_rax to answer
  set h_rdx to arg 2
  set h_rcx to -4
  call get_parm addr cf0 h_rdx h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to cell cf4 field
  set h_rcx to cell cf0 field
  if global half 1146 is not h_rax
    go to pe20b
  end
  place pe1e7
  set ne1e7_0 to h_rcx
  shift left 16 into ne1e7_0
  shift right 16 into ne1e7_0
  if ne1e7_0 is at most 3600
    go to pe20b
  end
  place pe1ee
  set cell cf0 field to 3600
  set h_rcx to 3600
  set h_rdx to 3600
  if global half 1150 is not h_rax
    go to pe22a
  end
  place pe206
  go to pe343
  place pe20b
  if global half 1150 is not h_rax
    go to pe22a
  end
  place pe214
  set h_rax to 3900
  set h_rdx to h_rcx
  set ne21a_0 to h_rcx
  shift left 16 into ne21a_0
  shift right 16 into ne21a_0
  if ne21a_0 is at least 3901
    go to pe33a
  end
  place pe225
  go to pe343
  place pe22a
  set h_rdx to h_rcx
  if global half 1170 is not h_rax
    go to pe292
  end
  place pe235
  set h_rax to h_rdx
  set scratch to h_rax
  multiply 15 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 100000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set cell cf0 field to h_rax
  set global half 3374 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1330 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pe308
  end
  place pe275
  set h_rcx to cell cf0 field
  set h_rax to 3000
  set h_rdx to h_rcx
  set ne282_0 to h_rcx
  shift left 16 into ne282_0
  shift right 16 into ne282_0
  if ne282_0 is at least 3001
    go to pe33a
  end
  place pe28d
  go to pe343
  place pe292
  if global half 1166 is not h_rax
    go to pe343
  end
  place pe29f
  set h_rax to global half 2926
  if h_rax is not global half 2918
    go to pe343
  end
  place pe2b3
  set global half 3374 to 5
  set h_rdx to 30
  call if_testgt_v_i addr g1330 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pe30e
  end
  place pe2d5
  set global half 3374 to 5
  set h_rdx to 40
  call if_testge_v_i addr g1330 h_rdx
  set h_rax to answer
  set h_rcx to cell cf0 field
  if h_rax is 0
    go to pe325
  end
  place pe2f7
  set h_rax to h_rcx
  add h_rax to h_rax
  set h_rcx to h_rax
  set ne2fd_0 to h_rax
  and 65535 into ne2fd_0
  set h_rcx to 500
  set fe335 to 0
  if ne2fd_0 is less than 500
    set fe335 to 1
  end
  go to pe335
  place pe308
  set h_rax to 1000
  go to pe33a
  place pe30e
  set h_rax to cell cf0 field
  shift left 3 into h_rax
  set h_rcx to h_rax
  set ne31a_0 to h_rax
  and 65535 into ne31a_0
  set h_rcx to 3000
  set fe335 to 0
  if ne31a_0 is less than 3000
    set fe335 to 1
  end
  go to pe335
  place pe325
  set h_rax to h_rcx
  shift left 2 into h_rax
  set h_rcx to h_rax
  set ne32c_0 to h_rax
  shift left 16 into ne32c_0
  shift right 16 into ne32c_0
  set h_rcx to 1000
  set fe335 to 0
  if ne32c_0 is less than 1000
    set fe335 to 1
  end
  place pe335
  if fe335 is not 0
    set h_rcx to h_rax
  end
  set h_rax to h_rcx
  place pe33a
  set cell cf0 field to h_rax
  set h_rdx to h_rax
  place pe343
  put h_rdx into arg 2 at 2 half
  match
end

rule set_word_default_acoustic_vals takes 1
  instead
  local h_rax
  local h_rcx
  local h_rdx
  local h_xmm0
  local h_xmm1
  local se5be
  local scratch
  variable g1330 word 3372
  place pe35c
  place pe38d
  place pe3e9
  call fence 0 sym eti_null
  set global half 3374 to 4
  set h_rdx to 1
  call if_testeq_v_i addr g1330 h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pe4bc
  end
  place pe417
  set global half 3374 to 4
  set h_rdx to 0
  call if_testeq_v_i addr g1330 h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to pe5a8
  end
  place pe435
  set h_rax to global signed half 3388
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  scale h_xmm0 by 430000 over 10000
  add 560000 to h_xmm0
  set h_rcx to h_xmm0
  add 1 to h_rcx
  if h_rcx is less than 1
    subtract 2 from h_rcx
  end
  truncate h_rcx by 1 over 10000
  set global half 3046 to h_rcx
  if global half 3354 is not 0
    go to pe487
  end
  place pe46d
  set scratch to h_rax
  multiply 35 into scratch
  set h_rcx to scratch
  set h_xmm0 to h_rcx
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rcx to h_xmm0
  add 1 to h_rcx
  if h_rcx is less than 1
    subtract 2 from h_rcx
  end
  truncate h_rcx by 1 over 10000
  set global half 3250 to h_rcx
  place pe487
  if global half 3358 is not 0
    go to pe5a8
  end
  place pe495
  set scratch to h_rax
  multiply 20 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  add 340000 to h_xmm0
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 3246 to h_rax
  go to pe5a8
  place pe4bc
  set h_rax to 100
  set h_rcx to global half 2830
  set h_rdx to 85
  if h_rcx is not 4
    set h_rdx to 100
  end
  set h_rax to 70
  if h_rcx is not 3
    set h_rax to h_rdx
  end
  set global half 3046 to h_rax
  if global half 3354 is not 0
    go to pe50c
  end
  place pe4eb
  set h_rax to global signed half 3388
  set scratch to h_rax
  multiply 36 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 3250 to h_rax
  place pe50c
  if global half 3358 is not 0
    go to pe537
  end
  place pe516
  set h_rax to global signed half 3388
  set scratch to h_rax
  multiply 50 into scratch
  set h_rax to scratch
  set h_xmm0 to h_rax
  multiply 10000 into h_xmm0
  scale h_xmm0 by 10000 over 1000000
  set h_rax to h_xmm0
  add 1 to h_rax
  if h_rax is less than 1
    subtract 2 from h_rax
  end
  truncate h_rax by 1 over 10000
  set global half 3246 to h_rax
  place pe537
  set global half 3374 to 3
  set h_rdx to 8000
  call if_testeq_v_i addr g1330 h_rdx
