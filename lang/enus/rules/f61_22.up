# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule token_to_number takes 3
  instead
  local cf0 bytes 8
  local c110 bytes 9
  local c128 bytes 9
  local h_rax
  place p46ddc
  place p46e1b
  place p46e7e
  set c110 to through arg 1 word 0
  set cell c110 word 0 to through arg 1 word 4
  set cell c110 byte 4 to through arg 1 byte 8
  set c110 to -65535
  call get_parm addr cf0 arg 2 -4
  set h_rax to answer
  and 0 into cell c128 word 0
  set cell c128 byte 4 to 0
  set c128 to -65535
  call fence 0 sym eti_null
  set h_rax to answer
  call starttest 1
  set h_rax to answer
  call settvar_s addr c128 53
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is 0
    go to p47129
  end
  place p46f0c
  set unwind to 0
  backtrack
  place p46f4f
  place t46f4f_1 on 1
  call starttest 3
  set h_rax to answer
  call settvar_s addr c128 54
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p46f7a
  go to p47152
  place p46f7f
  place t46f7f_3 on 3
  call starttest 4
  set h_rax to answer
  call settvar_s addr c128 55
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p46fae
  go to p47161
  place p46fb3
  place t46fb3_4 on 4
  call starttest 5
  set h_rax to answer
  call settvar_s addr c128 56
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p46fe2
  go to p47170
  place p46fe7
  place t46fe7_5 on 5
  call starttest 6
  set h_rax to answer
  call settvar_s addr c128 57
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p47016
  go to p4717f
  place p4701b
  place t4701b_6 on 6
  call starttest 7
  set h_rax to answer
  call settvar_s addr c128 58
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4704a
  go to p4718e
  place p4704f
  place t4704f_7 on 7
  call starttest 8
  set h_rax to answer
  call settvar_s addr c128 59
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4707e
  go to p4719d
  place p47083
  place t47083_8 on 8
  call starttest 9
  set h_rax to answer
  call settvar_s addr c128 60
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p470b2
  go to p471ac
  place p470b7
  place t470b7_9 on 9
  call starttest 10
  set h_rax to answer
  call settvar_s addr c128 61
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p470e6
  go to p471be
  place p470eb
  place t470eb_10 on 10
  call starttest 11
  set h_rax to answer
  call settvar_s addr c128 62
  set h_rax to answer
  call testeq_tvars addr c128 addr c110
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4711a
  set cell cf0 field to 9
  set h_rax to 9
  go to p47133
  place p47129
  and 0 into cell cf0 field
  set h_rax to 0
  place p47133
  put h_rax into arg 2 at 2 half
  match
  place p47149
  place t47149_2 on 2
  set h_rax to cell cf0 field
  go to p47133
  place p47152
  set cell cf0 field to 1
  set h_rax to 1
  go to p47133
  place p47161
  set cell cf0 field to 2
  set h_rax to 2
  go to p47133
  place p47170
  set cell cf0 field to 3
  set h_rax to 3
  go to p47133
  place p4717f
  set cell cf0 field to 4
  set h_rax to 4
  go to p47133
  place p4718e
  set cell cf0 field to 5
  set h_rax to 5
  go to p47133
  place p4719d
  set cell cf0 field to 6
  set h_rax to 6
  go to p47133
  place p471ac
  set cell cf0 field to 7
  set h_rax to 7
  go to p47133
  place p471be
  set cell cf0 field to 8
  set h_rax to 8
  go to p47133
end

rule string_to_short takes 4
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local v100 word
  local h_r15
  local h_rax
  local h_rcx
  local scratch
  place p47200
  set v100 to arg 3
  place p47242
  place p472a2
  set h_rcx to -6
  call get_parm addr c120 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c110 arg 2 h_rcx
  set h_rax to answer
  set h_rcx to -4
  call get_parm addr cf4 arg 3 h_rcx
  set h_rax to answer
  set h_r15 to addr cf0
  set cell cf0 kind to 65532
  call push_ptr_init addr c130
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into cell cf0 field
  and 0 into cell cf4 field
  set h_rax to addr c110
  set h_rax to cell c110 value
  set cell c130 value to h_rax
  call startloop 1
  set h_rax to answer
  set h_r15 to 1
  place p47352
  place t47352_6 on 6
  call bspush_ca 1
  set h_rax to answer
  call lpta_loadpn addr c130
  set h_rax to answer
  call rpta_loadpn addr c120
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p47383
  call testneq
  set h_rax to answer
  if h_rax is 0
    go to p473bd
  end
  set unwind to 0
  backtrack
  place p473bd
  place t473bd_2 on 2
  call token_to_digit addr c130 addr cf0
  set h_rax to answer
  place p473cf
  place t473cf_3 on 3
  set h_rax to h_r15
  multiply cell cf0 field into h_rax
  add h_rax to cell cf4 field
  set h_rax to h_r15
  set scratch to h_rax
  multiply 10 into scratch
  set h_rax to scratch
  set h_r15 to h_rax
  call lpta_loadp addr c130
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p47421
  end
  place p473fc
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r15
  if h_rax is not 0
    go to p47421
  end
  place p4740b
  go to p47410
  place p4740d
  place t4740d_5 on 5
  set h_rcx to h_r15
  place p47410
  set h_r15 to h_rcx
  call savescptr 5 addr c130
  set h_rax to answer
  place p47421
  place t47421_4 on 4
  call while_iterate 1 2
  set h_rax to answer
  go to p47352
  place p47434
  place t47434_1 on 1
  set h_rax to cell cf4 field
  set h_rcx to arg 3
  put h_rax into arg 3 at 2 half
  match
end

rule token_to_digit takes 3
  instead
  local c100 bytes 8
  local c104 bytes 8
  local h_rax
  place p47474
  place p474b7
  place p474ea
  call get_parm addr c100 arg 1 -6
  set h_rax to answer
  call get_parm addr c104 arg 2 -4
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p47556
  end
  place p4753a
  call test_string_s 1 1 sym eti_s_1b91b3
  set h_rax to answer
  if h_rax is 0
    go to p47716
  end
  place p47556
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p47588
  end
  place p4756c
  call test_string_s 1 1 sym eti_s_1b91b4
  set h_rax to answer
  if h_rax is 0
    go to p4771a
  end
  place p47588
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p475ba
  end
  place p4759e
  call test_string_s 1 1 sym eti_s_1b91b5
  set h_rax to answer
  if h_rax is 0
    go to p47720
  end
  place p475ba
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p475ec
  end
  place p475d0
  call test_string_s 1 1 sym eti_s_1b91b6
  set h_rax to answer
  if h_rax is 0
    go to p47726
  end
  place p475ec
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p4761e
  end
  place p47602
  call test_string_s 1 1 sym eti_s_1b91b7
  set h_rax to answer
  if h_rax is 0
    go to p4772c
  end
  place p4761e
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p47650
  end
  place p47634
  call test_string_s 1 1 sym eti_s_1b91b8
  set h_rax to answer
  if h_rax is 0
    go to p47732
  end
  place p47650
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p47682
  end
  place p47666
  call test_string_s 1 1 sym eti_s_1b91b9
  set h_rax to answer
  if h_rax is 0
    go to p47738
  end
  place p47682
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p476b4
  end
  place p47698
  call test_string_s 1 1 sym eti_s_1b91ba
  set h_rax to answer
  if h_rax is 0
    go to p4773e
  end
  place p476b4
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p476e2
  end
  place p476ca
  call test_string_s 1 1 sym eti_s_1b91bb
  set h_rax to answer
  if h_rax is 0
    go to p47744
  end
  place p476e2
  call lpta_loadp addr c100
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p476f8
  call test_string_s 1 1 sym eti_s_1b91bc
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p47710
  set h_rax to 9
  go to p47748
  place p47716
  set h_rax to 0
  go to p47748
  place p4771a
  set h_rax to 1
  go to p47748
  place p47720
  set h_rax to 2
  go to p47748
  place p47726
  set h_rax to 3
  go to p47748
  place p4772c
  set h_rax to 4
  go to p47748
  place p47732
  set h_rax to 5
  go to p47748
  place p47738
  set h_rax to 6
  go to p47748
  place p4773e
  set h_rax to 7
  go to p47748
  place p47744
  set h_rax to 8
  place p47748
  set cell c104 field to h_rax
  put h_rax into arg 2 at 2 half
  match
end

rule string_to_number takes 4
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local vf8 word
  local h_r15
  local h_rax
  local h_rcx
  local scratch
  place p4778c
  set vf8 to arg 3
  place p477ce
  place p4782e
  set h_rcx to -6
  call get_parm addr c128 arg 1 h_rcx
  set h_rax to answer
  set h_rcx to -6
  call get_parm addr c118 arg 2 h_rcx
  set h_rax to answer
  set h_rcx to -3
  call get_parm addr c108 arg 3 h_rcx
  set h_rax to answer
  set h_r15 to addr cf0
  set cell cf0 kind to 65532
  call push_ptr_init addr c138
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rax to answer
  and 0 into cell cf0 field
  set cell c108 value to 0
  set h_rax to addr c118
  set h_rax to cell c118 value
  set cell c138 value to h_rax
  call startloop 1
  set h_rax to answer
  set h_r15 to 1
  place p478db
  place t478db_6 on 6
  call bspush_ca 1
  set h_rax to answer
  call lpta_loadpn addr c138
  set h_rax to answer
  call rpta_loadpn addr c128
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4790c
  call testneq
  set h_rax to answer
  if h_rax is 0
    go to p47946
  end
  set unwind to 0
  backtrack
  place p47946
  place t47946_2 on 2
  call token_to_digit addr c138 addr cf0
  set h_rax to answer
  place p47958
  place t47958_3 on 3
  set h_rax to cell cf0 field
  multiply h_r15 into h_rax
  add h_rax to cell c108 value
  set scratch to h_r15
  multiply 10 into scratch
  set h_r15 to scratch
  call lpta_loadp addr c138
  call setscan_l 1
  set h_rax to answer
  if h_rax is not 0
    go to p479a6
  end
  place p47981
  call advance_tok
  set h_rax to answer
  set h_rcx to h_r15
  if h_rax is not 0
    go to p479a6
  end
  place p47990
  go to p47995
  place p47992
  place t47992_5 on 5
  set h_rcx to h_r15
  place p47995
  set h_r15 to h_rcx
  call savescptr 5 addr c138
  set h_rax to answer
  place p479a6
  place t479a6_4 on 4
  call while_iterate 1 2
  set h_rax to answer
  go to p478db
  place p479b9
  place t479b9_1 on 1
  set h_rax to cell c108 value
  set h_rcx to arg 3
  put h_rax into arg 3 at 4
  match
end

rule absval takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local h_rcx
  place p479f8
  place p47a3b
  place p47a6a
  set h_rcx to -4
  call get_parm addr cf4 arg 1 h_rcx
  set h_rcx to -4
  call get_parm addr cf0 arg 2 h_rcx
  call fence 0 sym eti_null
  set h_rcx to cell cf4 field
  negate h_rcx
  if h_rcx is less than 0
    set h_rcx to cell cf4 field
  end
  set cell cf0 field to h_rcx
  put h_rcx into arg 2 at 2 half
  match
end

rule find_last_syll takes 4
  instead
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local vf8 word
  local v100 word
  local h_r12
  local h_r14
  local h_r15
  local h_rcx
  local h_rsi
  local s47c21
  local s47cbe
  local s47ccd
  local s47ce6
  local s47d6a
  place p47b04
  set v100 to arg 3
  set vf8 to arg 2
  place p47b4a
  place p47baa
  set h_r14 to addr c130
  set h_r12 to -6
  set h_rsi to addr c130
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c110
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rsi to addr c120
  set h_rcx to -6
  call get_parm h_rsi arg 3 h_rcx
  set h_r12 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to addr c130
  call lpta_loadp h_rsi
  call setscan_l 2
  set s47c21 to answer
  set h_rcx to 0
  if s47c21 is not 0
    go to p47d0f
  end
  place p47c31
  go to p47c38
  place p47c38
  set h_r14 to h_rcx
  set h_rsi to 2
  call bspush_ca_scan h_rsi
  set h_rsi to 3
  call bspush_ca_scan_boa h_rsi
  set h_rsi to 2
  set h_r15 to 1
  set h_rcx to 1
  call testFldeq h_rsi 1 h_rcx
  if answer is 0
    set h_r14 to 1
  end
  set h_rcx to h_r14
  place p47c6f
  set h_r12 to 1
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place p47cb2
  place t47cb2_2 on 2
  set h_r15 to unwind
  set h_rsi to 2
  set h_rcx to 1
  call testFldeq h_rsi 1 h_rcx
  set s47cbe to answer
  set h_rsi to h_r15
  if s47cbe is not 0
    set unwind to h_rsi
    backtrack
  end
  place p47cca
  call advance_tok
  set s47ccd to answer
  set h_rsi to h_r15
  if s47ccd is not 0
    set unwind to h_rsi
    backtrack
  end
  place p47cd9
  go to p47cfa
  place p47cdb
  place t47cdb_3 on 3
  set h_r15 to unwind
  call bspop_boa
  call advance_tok
  set s47ce6 to answer
  set h_rcx to h_r15
  set h_rsi to h_r15
  if s47ce6 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p47cf5
  go to p47c38
  place p47cfa
  place t47cfa_5 on 5
  set h_r15 to unwind
  set h_rsi to 5
  call savescptr h_rsi addr c110
  place p47d0c
  place t47d0c_1 on 1
  set h_r15 to unwind
  set h_r12 to h_r15
  place p47d0f
  set h_r14 to h_r12
  set h_rsi to 6
  call starttest h_rsi
  call lpta_loadp addr c110
  set h_rsi to 7
  call lpta_tstctxtl h_rsi
  if answer is not 0
    go to p47d8c
  end
  place p47d46
  set h_rsi to 7
  call setscan_r h_rsi
  if answer is not 0
    go to p47d8c
  end
  place p47d55
  set h_rsi to 7
  call savescptr h_rsi addr c110
  call advance_tok
  set s47d6a to answer
  set h_rcx to h_r14
  if s47d6a is not 0
    go to p47c6f
  end
  place p47d7a
  place t47d7a_8 on 8
  set h_r15 to unwind
  set h_rsi to 8
  call savescptr h_rsi addr c120
  place p47d8c
  place t47d8c_6 on 6
  set h_r15 to unwind
  set h_rcx to arg 2
  put cell c110 value into arg 2 at 4
  set h_rcx to arg 3
  put cell c120 value into arg 3 at 4
  match
  place p47dbf
  place t47dbf_4 on 4
  set h_r15 to unwind
  set h_rcx to h_r15
  go to p47c38
  place p47dc7
  place t47dc7_7 on 7
  set h_r15 to unwind
  set h_r14 to h_r15
  go to p47d55
end

rule get_numRootSylls takes 5
  instead
  local cf0 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local c160 bytes 8
  local vf8 word
  local v100 word
  place p47dec
  place p47e38
  place p47e70
  call get_parm addr c140 arg 1 -6
  call get_parm addr c130 arg 2 -6
  set vf8 to arg 3
  call get_parm addr cf0 arg 3 -4
  set v100 to arg 4
  call get_parm addr c110 arg 4 -6
  call push_ptr_init addr c120
  call push_ptr_init addr c160
  call push_ptr_init addr c150
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  call find_last_syll addr c130 addr c120 addr c110
  place p47f4b
  place t47f4b_1 on 1
  call startloop 2
  call copyvar addr c160 addr c140
  call copyvar addr c150 addr c110
  call forall_to_test addr c160 addr c150
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p47f8c
  place t47f8c_5 on 5
  call bspush_ca 4
  call lpta_loadp addr c160
  call setscan_r 7
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p47fa9
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p47fb5
  place t47fb5_3 on 3
  call c_assvar addr cf0
  increment cell cf0 field
  place p47fcb
  place t47fcb_4 on 4
  call forto_adv_r 2 3 5 7 addr c160 addr c150
  if answer is 0
    go to p4801e
  end
  set unwind to 0
  backtrack
  place p4801e
  place t4801e_2 on 2
  put cell cf0 field into arg 3 at 2 half
  put cell c110 value into arg 4 at 4
  match
end

rule mark_syll_stress takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  place p4808c
  place p480d2
  place p48105
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call get_parm addr cf0 arg 3 -4
  call fence 0 sym eti_null
  call lpta_rpta_loadp addr c110 addr c100
  call mark_v 7 0 addr cf0 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p4818d
  call lpta_rpta_loadp addr c110 addr c100
  call mark_v 2 7 addr cf0 0
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
