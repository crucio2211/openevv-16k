# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule compounds takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  place p6aa10
  place p6aa4f
  place p6aa7e
  call get_parm addr c120 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call push_ptr_init addr c100
  call fence 0 sym eti_null
  call starttest 2
  call lpta_rpta_loadp addr c120 addr c110
  call actd_lookup 6 addr c100 0
  if answer is 0
    go to p6ab28
  end
  give up
  place p6ab28
  place p6ab32
  place t6ab32_3 on 3
  call actd_goto
  set unwind to 0
  backtrack
  place p6ab65
  place t6ab65_1 on 1
  place t6ab65_4 on 4
  place t6ab65_6 on 6
  call insert_compound addr c100
  match
  place tm_5 on 5
  match
end

rule nonlex_prefixes takes 4
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local v108 word
  local h_rax
  local h_rcx
  local h_rdx
  local s6b9b2
  variable g218 word 280
  variable g228 word 288
  place p6aba0
  place p6abe2
  place p6ac45
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c100 h_rdx h_rcx
  set h_rax to answer
  set v108 to arg 1
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c138 h_rdx h_rcx
  set h_rax to answer
  set h_rcx to -4
  set h_rdx to arg 3
  call get_parm addr cf0 h_rdx h_rcx
  set h_rax to answer
  call push_ptr_init addr c128
  set h_rax to answer
  call push_ptr_init addr c118
  set h_rax to answer
  call fence 0 sym eti_null
  call starttest 114
  set h_rax to answer
  set h_rdx to addr c138
  call lpta_rpta_loadp addr c100 h_rdx
  set h_rax to answer
  set h_rax to 0
  set h_rcx to 0
  set h_rdx to 0
  call actd_lookup 7 h_rdx h_rcx
  set h_rax to answer
  if h_rax is 0
    go to p6acf4
  end
  give up
  place p6acf4
  place p6ad10
  place t6ad10_115 on 115
  set h_rdx to addr c100
  call copyvar addr g218 h_rdx
  set h_rax to answer
  set h_rdx to addr c138
  call copyvar addr g228 h_rdx
  set h_rax to answer
  call actd_goto
  set h_rax to answer
  set unwind to 0
  backtrack
  place p6ad63
  place t6ad63_1 on 1
  set h_rdx to addr g228
  call lpta_rpta_loadp addr g218 h_rdx
  set h_rax to answer
  set h_rcx to sym eti_s_1b9a73
