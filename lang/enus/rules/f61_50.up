# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule eng_symbolic_rules takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p1750e0
  place p175123
  place p175156
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call fence 1 sym eti_s_1beeee
  call init_eng_symbolic_vars
  call analyze_morphs2 addr c110 addr c100
  call generate_diaphones addr c110 addr c100
  call pre_syll_phone_adjustments addr c110 addr c100
  call create_eng_syllables addr c110 addr c100
  call assign_eng_stress addr c110 addr c100
  call post_syll_adjustments addr c110 addr c100
  call break_into_phones addr c110 addr c100
  match
end

