  set h_r14 to arg 2
  set h_r15 to arg 1
  set h_r13 to 94
  place p6d72a
  place p6d759
  set h_r12 to addr c110
  set h_r13 to -6
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm addr c110 h_rdx h_rcx
  set h_rax to answer
  set h_r15 to addr c100
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c100 h_rdx h_rcx
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rdx to addr c100
  call lpta_rpta_loadp addr c110 h_rdx
  set h_rax to answer
  set h_rax to 0
  set h_rcx to 0
  set h_rdx to 0
  call actd_lookup 11 h_rdx h_rcx
  set h_rax to answer
  if h_rax is 0
    go to p6d7ee
  end
  give up
  place p6d7ee
  set h_r13 to 5
  set h_rax to 0
  set h_r12 to 0
  place p6d7f6
  call starttest 276
  set h_rax to answer
  if global half 2698 is 1
    match
  end
  place p6d811
  set h_r14 to h_r13
  set h_r15 to h_r12
  call actd_goto
  set h_rax to answer
  set unwind to 0
