# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule eng_funct_words takes 5
  instead
  local cf0 bytes 8
  local c104 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local c158 bytes 8
  local vf8 word
  local v100 word
  local v110 word
  local v118 word
  local h_rcx
  variable g528 word 756
  variable g538 word 764
  variable g588 word 804
  variable g598 word 812
  variable g678 word 924
  place pb0d50
  set h_rcx to 94
  place pb0d9c
  place pb0dd4
  set h_rcx to -6
  call get_parm addr c138 arg 1 h_rcx
  set h_rcx to -6
  call get_parm addr c128 arg 2 h_rcx
  set h_rcx to -6
  call get_parm addr c158 arg 3 h_rcx
  set h_rcx to -6
  call get_parm addr c148 arg 4 h_rcx
  set cell cf0 kind to 65532
  set c104 to 65532
  call fence 0 sym eti_null
  set global word 760 to cell c138 value
  set global word 768 to cell c148 value
  set global word 920 to cell c128 value
  set global word 928 to cell c158 value
  call fence 1 sym eti_s_1bd842
  set cell cf0 field to global half 2066
  set vf8 to addr g528
  set v100 to addr g538
  call in_quotes addr g528 addr g538
  if answer is 0
    give up
  end
  place pb0ee2
  set v110 to addr g678
  set v118 to addr g588
  place pb0f11
  place tb0f11_1 on 1
  call mark_eng_prepositions addr cf0
  if answer is 0
    go to pb0f7a
  end
  place pb0f24
  place tb0f24_2 on 2
  call mark_eng_conjunctions
  if answer is 0
    go to pb0f6c
  end
  place pb0f30
  place tb0f30_4 on 4
  call mark_eng_wh_words addr cf0
  if answer is 0
    go to pb0f7a
  end
  place pb0f43
  place tb0f43_5 on 5
  call mark_eng_refl_pronouns
  if answer is 0
    go to pb0f7a
  end
  place pb0f4f
  place tb0f4f_6 on 6
  call mark_eng_interjections
  if answer is 0
    go to pb0f7a
  end
  place pb0f5b
  place tb0f5b_7 on 7
  call mark_eng_quantifiers
  if answer is 0
    go to pb0f7a
  end
  place pb0f67
  give up
  place pb0f6c
  set cell cf0 field to global half 2074
  place pb0f7a
  place tb0f7a_3 on 3
  if global half 2066 is cell cf0 field
    go to pb109d
  end
  place pb0f8e
  place tb0f8e_9 on 9
  call starttest 11
  call lpta_loadp addr g528
  call setscan_r 4
  if answer is not 0
    go to pb1025
  end
  place pb0faf
  call bspush_ca_scan 12
  set h_rcx to 1
  place pb0fc5
  call testFldeq 4 10 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb0fcf
  place tb0fcf_13 on 13
  call advance_tok
  if answer is 0
    go to pb109d
  end
  set unwind to 0
  backtrack
  place pb100d
  place tb100d_12 on 12
  call bspush_ca_scan 14
  set h_rcx to 2
  go to pb0fc5
  place pb1025
  place tb1025_11 on 11
  call lpta_loadp addr g588
  call setscan_r 4
  if answer is not 0
    go to pb106d
  end
  place pb103b
  call advance_tok
  if answer is not 0
    go to pb106d
  end
  place pb1047
  call lpta_loadp addr g598
  call test_ptr
  if answer is 0
    go to pb109d
  end
  place pb106d
  place tb106d_15 on 15
  call followed_by_hyphen addr g528 addr g538
  if answer is 0
    go to pb109d
  end
  place pb1087
  place tb1087_16 on 16
  call mark_word_stress addr g528 addr cf0
  place pb109d
  place tb109d_10 on 10
  call lpta_loadpn addr g678
  call rpta_loadpn addr g538
  call compare_ptas
  if answer is not 0
    go to pb1145
  end
  place pb10c7
  call testneq
  if answer is not 0
    go to pb1145
  end
  place pb10d3
  call starttest 17
  call move_i addr c104 0
  set h_rcx to addr g538
  call assign_s_clitic_category addr g528 addr g678 h_rcx addr c104
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb1133
  go to pb1145
  place pb1135
  place tb1135_14 on 14
  set h_rcx to 3
  go to pb0fc5
  place pb1145
  place tb1145_17 on 17
  call analyze_morphs1
  match
  place tm_18 on 18
  match
end

rule mark_eng_prepositions takes 2
  instead
  local cf0 bytes 8
  local vf8 word
  local v100 word
  local h_rdx
  variable g528 word 756
  variable g538 word 764
  variable g678 word 924
  variable gca4 word 2072
  variable gcac word 2080
  place pb11cc
  place pb120c
  place pb123f
  set v100 to arg 1
  set h_rdx to arg 1
  call get_parm addr cf0 h_rdx -4
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_1bd842
  call fence 1 h_rdx
  call starttest 1
  set h_rdx to addr g678
  set vf8 to addr g678
  call lpta_rpta_loadp addr g528 h_rdx
  set h_rdx to 248
  call setd_lookup 1 h_rdx
  if answer is 0
    go to pb1378
  end
  go to pb12c5
  place tb12c5_1 on 1
  place pb12c5
  call starttest 3
  set h_rdx to addr g678
  call lpta_rpta_loadp addr g528 h_rdx
  set h_rdx to 249
  call setd_lookup 1 h_rdx
  if answer is not 0
    go to pb12ff
  end
  place pb12f6
  set h_rdx to addr gca4
  go to pb1369
  go to pb12ff
  place tb12ff_3 on 3
  place pb12ff
  call starttest 4
  set h_rdx to addr g678
  call lpta_rpta_loadp addr g528 h_rdx
  set h_rdx to 250
  call setd_lookup 1 h_rdx
  if answer is not 0
    give up
  end
  place pb1334
  set h_rdx to addr g538
  call lpta_rpta_loadp addr g528 h_rdx
  set h_rdx to 2
  call mark_s 4 h_rdx 9 0
  if answer is not 0
    give up
  end
  place pb1362
  set h_rdx to addr gcac
  place pb1369
  call copyvar addr cf0 h_rdx
  place pb1378
  place pb1386
  place tb1386_2 on 2
  set h_rdx to addr g538
  call lpta_rpta_loadp addr g528 h_rdx
  set h_rdx to 1
  call mark_s 4 h_rdx 13 0
  if answer is 0
    go to pb1412
  end
  set unwind to 0
  backtrack
  place pb1412
  put cell cf0 field into arg 1 at 2 half
  match
end

rule mark_eng_conjunctions takes 1
  instead
  local h_r14
  local h_rsi
  local sb1556
  local sb1571
  variable g528 word 756
  variable g538 word 764
  variable g678 word 924
  place pb142e
  place pb1467
  place pb149a
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_r14 to 1
  set h_rsi to 1
  call fence h_rsi sym eti_s_1bd842
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  set h_rsi to addr g528
  call lpta_rpta_loadp h_rsi addr g678
  set h_rsi to 1
  call setd_lookup h_rsi 252
  set h_rsi to 0
  if answer is 0
    set h_rsi to 1
  end
  set unwind to h_rsi
  backtrack
  place pb1539
  place tb1539_1 on 1
  set h_r14 to unwind
  set h_rsi to addr g528
  call lpta_rpta_loadp h_rsi addr g538
  set h_rsi to 4
  call mark_s h_rsi 1 5 0
  set sb1556 to answer
  set h_rsi to h_r14
  if sb1556 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb1562
  set h_rsi to 4
  call mark_s h_rsi 2 32 0
  set sb1571 to answer
  set h_rsi to h_r14
  if sb1571 is not 0
    set unwind to h_rsi
    backtrack
  end
  match
  place pb158e
  place tb158e_2 on 2
  set h_r14 to unwind
  call bspop_boa
  give up
end

rule mark_eng_wh_words takes 2
  instead
  local cf0 bytes 8
  local vf8 word
  local v100 word
  local h_r12
  local h_rax
  local h_rcx
  local h_rsi
  local kb16ec_0
  local kb17a6_0
  variable g528 word 756
  variable g538 word 764
  variable g678 word 924
  place pb15c8
  set vf8 to arg 1
  place pb1604
  place pb1664
  set h_rsi to addr cf0
  set h_rcx to -4
  call get_parm h_rsi arg 1 h_rcx
  set h_rax to answer
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_rsi to 1
  call fence h_rsi sym eti_s_1bd842
  set h_rax to answer
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr g528
  set v100 to addr g678
  call lpta_rpta_loadp h_rsi addr g678
  set h_rax to answer
  set h_rsi to 1
  call setd_lookup h_rsi 253
  set h_rax to answer
  set h_rcx to 0
  set kb16ec_0 to h_rax
  set h_rax to 0
  if kb16ec_0 is 0
    set h_rax to 1
  end
  set h_rcx to h_rax
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place pb1735
  place tb1735_1 on 1
  set h_r12 to unwind
  set h_rsi to addr g528
  call lpta_rpta_loadp h_rsi addr g538
  set h_rax to answer
  set h_rsi to 4
  set h_rcx to 19
  call mark_s h_rsi 1 h_rcx 0
  set h_rax to answer
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb175e
  set h_rsi to 3
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 4
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr g678
  call lpta_loadp h_rsi
  call setscan_l 1
  set h_rax to answer
  set h_rsi to h_r12
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb1791
  set h_rsi to 1
  set h_rcx to sym eti_s_1bd843
  call test_string_s h_rsi 4 h_rcx
  set h_rax to answer
  set kb17a6_0 to h_rax
  set h_rax to 1
  if kb17a6_0 is 0
    set h_r12 to 1
  end
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place pb17b7
  place tb17b7_2 on 2
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  give up
  place pb17c4
  place tb17c4_3 on 3
  set h_r12 to unwind
  set h_rax to cell cf0 field
  go to pb17e3
  place pb17cd
  place tb17cd_4 on 4
  set h_r12 to unwind
  call bspop_boa
  set h_rax to answer
  set h_rax to global half 2074
  set cell cf0 field to h_rax
  place pb17e3
  set h_rcx to arg 1
  put h_rax into arg 1 at 2 half
  match
end

rule mark_eng_refl_pronouns takes 1
  instead
  local vf8 word
  local h_r15
  local h_rsi
  local sb197e
  local sb1999
  local sb1a21
  variable g528 word 756
  variable g538 word 764
  variable g678 word 924
  place pb1814
  place pb1849
  place pb18a9
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call fence h_rsi sym eti_s_1bd842
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  set h_rsi to addr g528
  set vf8 to addr g678
  call lpta_rpta_loadp h_rsi addr g678
  set h_rsi to 1
  call setd_lookup h_rsi 254
  set h_rsi to 0
  if answer is 0
    set h_rsi to 1
  end
  set unwind to h_rsi
  backtrack
  place pb1961
  place tb1961_1 on 1
  set h_r15 to unwind
  set h_rsi to addr g528
  call lpta_rpta_loadp h_rsi addr g538
  set h_rsi to 4
  call mark_s h_rsi 1 14 0
  set sb197e to answer
  set h_rsi to h_r15
  if sb197e is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb198a
  set h_rsi to 4
  call mark_s h_rsi 2 28 0
  set sb1999 to answer
  set h_rsi to h_r15
  if sb1999 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb19a5
  set h_rsi to 3
  call starttest h_rsi
  set h_rsi to addr g678
  call lpta_loadp h_rsi
  call setscan_l 1
  if answer is not 0
    go to pb1a04
  end
  place pb19c6
  set h_rsi to 1
  call test_string_s h_rsi 1 sym eti_s_1bd847
  if answer is not 0
    go to pb1a04
  end
  place pb19de
  set h_rsi to addr g528
  call lpta_rpta_loadp h_rsi addr g538
  set h_rsi to 4
  call mark_s h_rsi 5 1 0
  if answer is 0
    match
  end
  place pb1a04
  place tb1a04_3 on 3
  set h_r15 to unwind
  set h_rsi to addr g528
  call lpta_rpta_loadp h_rsi addr g538
  set h_rsi to 4
  call mark_s h_rsi 5 2 0
  set sb1a21 to answer
  set h_rsi to h_r15
  if sb1a21 is not 0
    set unwind to h_rsi
    backtrack
  end
  match
  place pb1a40
  place tb1a40_2 on 2
  set h_r15 to unwind
  call bspop_boa
  give up
  place tm_4 on 4
  match
end

rule mark_eng_interjections takes 1
  instead
  local h_r14
  local sb1b5a
  variable g528 word 756
  variable g538 word 764
  variable g678 word 924
  place pb1a64
  place pb1a99
  place pb1af9
  call fence 0 sym eti_null
  set h_r14 to 1
  call fence 1 sym eti_s_1bd842
  call starttest 1
  call bspush_ca_boa 2
  call lpta_rpta_loadp addr g528 addr g678
  call setd_lookup 1 255
  set sb1b5a to answer
  set h_r14 to 0
  set h_r14 to 0
  if sb1b5a is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place pb1b98
  place tb1b98_1 on 1
  set h_r14 to unwind
  call lpta_rpta_loadp addr g528 addr g538
  call mark_s 4 1 8 0
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  match
  place pb1bd6
  place tb1bd6_2 on 2
  set h_r14 to unwind
  call bspop_boa
  give up
end

rule mark_eng_quantifiers takes 1
  instead
  local h_r14
  local sb1cde
  variable g528 word 756
  variable g538 word 764
  variable g678 word 924
  place pb1be8
  place pb1c1d
  place pb1c7d
  call fence 0 sym eti_null
  set h_r14 to 1
  call fence 1 sym eti_s_1bd842
  call starttest 1
  call bspush_ca_boa 2
  call lpta_rpta_loadp addr g528 addr g678
  call setd_lookup 1 256
  set sb1cde to answer
  set h_r14 to 0
  set h_r14 to 0
  if sb1cde is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place pb1d1c
  place tb1d1c_1 on 1
  set h_r14 to unwind
  call lpta_rpta_loadp addr g528 addr g538
  call mark_s 4 1 16 0
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  match
  place pb1d5a
  place tb1d5a_2 on 2
  set h_r14 to unwind
  call bspop_boa
  give up
end

rule assign_s_clitic_category takes 5
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local h_r12
  local h_r14
  local h_rsi
  local sb1ee7
  local sb1fe5
  local sb2007
  place pb1d6c
  set h_r14 to arg 4
  set h_r12 to arg 1
  place pb1db5
  place pb1e19
  set h_rsi to addr c110
  set h_r12 to -6
  call get_parm h_rsi arg 1 -6
  set h_rsi to addr c120
  call get_parm h_rsi arg 2 -6
  set h_rsi to addr c100
  call get_parm h_rsi arg 3 -6
  set h_rsi to addr cf0
  call get_parm h_rsi arg 4 -4
  set h_r14 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  set h_rsi to addr c120
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    go to pb1ef7
  end
  place pb1eb1
  set h_rsi to 1
  call test_string_s h_rsi 2 sym eti_s_1bd848
  if answer is not 0
    go to pb1ef7
  end
  place pb1eca
  call lpta_loadp addr c100
  call test_ptr
  set sb1ee7 to answer
  set h_r14 to 0
  set h_r14 to 0
  if sb1ee7 is 0
    set h_r14 to 1
  end
  place pb1ef7
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place pb1f37
  place tb1f37_1 on 1
  set h_r12 to unwind
  if cell cf0 field is not 1
    go to pb1f76
  end
  place pb1f41
  set h_rsi to addr c110
  call lpta_rpta_loadp h_rsi addr c100
  set h_r14 to 0
  set h_rsi to 4
  call mark_s h_rsi 2 40 0
  if answer is 0
    match
  end
  place pb1f76
  place tb1f76_3 on 3
  set h_r12 to unwind
  set h_rsi to 5
  call starttest h_rsi
  if cell cf0 field is not 2
    go to pb1fc0
  end
  place pb1f8b
  set h_rsi to addr c110
  call lpta_rpta_loadp h_rsi addr c100
  set h_r14 to 0
  set h_rsi to 4
  call mark_s h_rsi 2 41 0
  if answer is 0
    match
  end
  place pb1fc0
  place tb1fc0_5 on 5
  set h_r12 to unwind
  set h_rsi to addr c110
  call lpta_rpta_loadp h_rsi addr c100
  set h_rsi to 4
  call mark_s h_rsi 2 3 0
  set sb1fe5 to answer
  set h_rsi to h_r12
  if sb1fe5 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pb1ff5
  set h_r14 to 0
  set h_rsi to 4
  call mark_s h_rsi 3 2 0
  set sb2007 to answer
  set h_rsi to h_r12
  if sb2007 is not 0
    set unwind to h_rsi
    backtrack
  end
  match
  place pb201c
  place tb201c_2 on 2
  set h_r12 to unwind
  call bspop_boa
  give up
  place tm_4 on 4
  match
end

rule mark_eng_content_word takes 5
  instead
  local c118 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local c158 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local h_rcx
  local h_rdx
  variable g528 word 756
  variable g538 word 764
  variable g678 word 924
  variable g6c8 word 964
  variable g6d8 word 972
  place pb204c
  set h_rcx to 94
  place pb2098
  place pb20d0
  set h_rcx to -6
  set h_rdx to arg 1
  call get_parm addr c138 h_rdx h_rcx
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm addr c128 h_rdx h_rcx
  set h_rdx to arg 3
  set h_rcx to -6
  call get_parm addr c158 h_rdx h_rcx
  set h_rdx to arg 4
  set h_rcx to -6
  call get_parm addr c148 h_rdx h_rcx
  call push_ptr_init addr c118
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_1bd842
  call fence 1 h_rdx
  set global word 760 to cell c138 value
  set global word 768 to cell c148 value
  set global word 920 to cell c128 value
  set h_rcx to addr g678
  set vf8 to addr g678
  set global word 928 to cell c158 value
  call analyze_morphs1
  set v108 to addr g6d8
  set v100 to addr g6c8
  go to pb21e1
  place tb21e1_1 on 1
  place pb21e1
  call starttest 2
  set h_rdx to 4
  call lpta_loadp addr g528
  call setscan_r h_rdx
  if answer is 0
    go to pb2219
  end
  go to pb21fe
  place tb21fe_2 on 2
  place pb21fe
  set h_rdx to addr g538
  call in_quotes addr g528 h_rdx
  if answer is not 0
    go to pb22c6
  end
  place pb2214
  match
  place pb2219
  set h_rdx to 2
  set h_rcx to 45
  call testFldeq 4 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb2232
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place pb2242
  call starttest 3
  set h_rdx to 3
  call lpta_loadp addr g538
