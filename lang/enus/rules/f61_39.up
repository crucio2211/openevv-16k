# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule analyze_morphs1 takes 1
  instead
  local c118 bytes 8
  local c128 bytes 8
  local c140 bytes 8
  local vf8 word
  local v100 word
  local v108 word
  local h_rcx
  local h_rdx
  local s10282a
  variable g528 word 756
  variable g538 word 764
  variable g668 word 916
  variable g678 word 924
  place p1025d0
  place p102609
  place p10266f
  set cell c140 byte 2 to 0
  and 0 into cell c140 half 0
  set c140 to -65533
  call push_ptr_init addr c128
  call push_ptr_init addr c118
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rdx to sym eti_s_1bdffe
  call fence 1 h_rdx
  call init_eng_morph_vars
  set v108 to addr g528
  set vf8 to addr g668
  set v100 to addr g538
  place p10270e
  place t10270e_1 on 1
  set h_rdx to addr g678
  call eng_words_dict_lookup addr g528 h_rdx
  if answer is 0
    go to p102a15
  end
  place p102728
  place t102728_2 on 2
  set h_rdx to addr g678
  call eng_roots_dict_lookup addr g668 h_rdx
  if answer is 0
    go to p102a15
  end
  place p102742
  place t102742_4 on 4
  set h_rdx to addr g678
  call one_eng_syllable addr g668 h_rdx
  if answer is 0
    go to p1027e4
  end
  place p10275c
  place t10275c_5 on 5
  call strip_nonlex_prefixes
  place p102764
  place t102764_7 on 7
  if global half 4178 is 1
    go to p102a15
  end
  place p102772
  place t102772_8 on 8
  set h_rdx to addr g678
  call eng_roots_dict_lookup addr g668 h_rdx
  if answer is 0
    go to p102a15
  end
  place p10278c
  place t10278c_9 on 9
  call strip_s
  if answer is 0
    go to p102a15
  end
  place p10279c
  place t10279c_10 on 10
  call starttest 3
  call bspush_ca 11
  set h_rdx to 1
  call lpta_loadp addr g678
  call setscan_l h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1027c4
  call bspush_ca_scan 12
  set h_rdx to 3
  set h_rcx to sym eti_s_1bdfff
  go to p102977
  place p1027e4
  call starttest 6
  call strip_s
  place p1027f7
  place t1027f7_6 on 6
  set h_rdx to addr g678
  call lpta_rpta_loadp addr g668 h_rdx
  set h_rdx to 2
  call settvar_s addr c140 h_rdx
  set h_rcx to 0
  set h_rdx to addr c140
  call insert_2ptv 3 h_rdx h_rcx
  set s10282a to answer
  set h_rcx to 0
  if s10282a is 0
    match
  end
  set unwind to 0
  backtrack
  place p102868
  place t102868_11 on 11
  set h_rdx to 1
  call lpta_loadp addr g678
  call setscan_l h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p10287a
  place t10287a_17 on 17
  set h_rdx to addr c128
  call savescptr 17 h_rdx
  set h_rdx to 2
  set h_rcx to sym eti_s_1be006
  call test_string_s 1 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1028a5
  set h_rdx to 1
  call lpta_loadp addr c128
  call setscan_r h_rdx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1028bf
  place t1028bf_18 on 18
  set h_rdx to 1
  set h_rcx to sym eti_s_1bdffe
  call test_synch 18 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1028dc
  go to p102967
  place p1028e1
  place t1028e1_12 on 12
  call bspush_ca_scan 14
  set h_rdx to 2
  set h_rcx to sym eti_s_1be002
  go to p10290e
  place p1028fe
  place t1028fe_14 on 14
  set h_rdx to 1
  set h_rcx to sym eti_s_1be004
  place p10290e
  call test_string_s 1 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p10291b
  go to p102947
  place p10291d
  place t10291d_22 on 22
  set h_rcx to 3
  set h_rdx to 0
  call testFldeq 3 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p102935
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p102945
  go to p1029bb
  place p102947
  place t102947_15 on 15
  set h_rdx to 1
  set h_rcx to sym eti_s_1be005
  go to p102977
  place p102959
  place t102959_23 on 23
  set h_rdx to 1
  set h_rcx to 2
  go to p1029dc
  place p102967
  set h_rdx to 1
  set h_rcx to sym eti_s_1be008
  place p102977
  call test_string_s 1 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p102984
  place t102984_13 on 13
  place t102984_16 on 16
  set cell c118 value to global word 920
  call break_into_morphs
  place p10299a
  place t10299a_19 on 19
  call starttest 20
  set h_rdx to 3
  call lpta_loadp addr g538
  call setscan_l h_rdx
  if answer is not 0
    go to p102a07
  end
  place p1029bb
  place t1029bb_21 on 21
  call bspush_ca_scan 22
  call bspush_ca_scan 23
  set h_rcx to 3
  set h_rdx to 1
  place p1029dc
  call testFldeq 3 h_rdx h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1029e9
  place t1029e9_24 on 24
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1029f9
  place t1029f9_25 on 25
  set h_rdx to addr g678
  call savescptr 25 h_rdx
  place p102a07
  place t102a07_20 on 20
  set global word 920 to cell c118 value
  place p102a15
  place t102a15_3 on 3
  set h_rcx to 0
  match
end

rule eng_words_dict_lookup takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  variable g176c word 4228
  place p102a90
  place p102ad3
  place p102b06
  call get_parm addr c100 arg 1 -6
  call get_parm addr c110 arg 2 -6
  call fence 0 sym eti_null
  call user_rootdict addr c100 addr c110
  if answer is 0
    match
  end
  place p102b62
  call eng_words addr c100 addr c110
  if answer is 0
    go to p102b96
  end
  place p102b7c
  call eng_homog_words addr c100 addr c110
  if answer is not 0
    give up
  end
  place p102b96
  call insert_dict_root addr c100 addr c110 addr g176c
  match
end

rule eng_roots_dict_lookup takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local h_r13
  local h_rsi
  local s102d6d
  local s102d84
  local s102dd3
  place p102be8
  place p102c23
  place p102c83
  set h_rsi to addr c110
  call get_parm h_rsi arg 1 -6
  set h_rsi to addr c100
  call get_parm h_rsi arg 2 -6
  set h_rsi to 0
  call fence h_rsi sym eti_null
  if global half 4170 is 0
    give up
  end
  place p102ccc
  set h_rsi to 2
  set h_r13 to 0
  place p102ce1
  and 0 into global half 4170
  call starttest h_rsi
  set h_rsi to 3
  call bspush_ca h_rsi
  set h_rsi to h_r13
  if global signed half 2682 is more than 0
    go to p102df1
  end
  set unwind to h_rsi
  backtrack
  place p102d43
  place t102d43_3 on 3
  set h_r13 to unwind
  set h_rsi to 5
  call bspush_ca h_rsi
  set h_rsi to h_r13
  if global signed half 2686 is less than 2
    set unwind to h_rsi
    backtrack
  end
  place p102d5b
  go to p102df1
  place p102d60
  place t102d60_5 on 5
  set h_r13 to unwind
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_r 3
  set s102d6d to answer
  set h_rsi to h_r13
  if s102d6d is not 0
    set unwind to h_rsi
    backtrack
  end
  place p102d79
  set h_rsi to 3
  call testFldeq h_rsi 0 3
  set s102d84 to answer
  set h_rsi to h_r13
  if s102d84 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p102d90
  set h_rsi to 6
  call bspush_ca_scan_boa h_rsi
  set h_rsi to 3
  call testFldeq h_rsi 1 1
  if answer is 0
    set h_r13 to 1
  end
  set h_rsi to h_r13
  set unwind to h_rsi
  backtrack
  place p102dc8
  place t102dc8_6 on 6
  set h_r13 to unwind
  call bspop_boa
  call advance_tok
  set s102dd3 to answer
  set h_rsi to h_r13
  if s102dd3 is not 0
    set unwind to h_rsi
    backtrack
  end
  place p102de3
  go to p102df1
  place p102de5
  place t102de5_1 on 1
  set h_r13 to unwind
  set h_rsi to 2
  go to p102ce1
  place p102df1
  place t102df1_4 on 4
  set h_r13 to unwind
  set h_rsi to addr c110
  call user_rootdict h_rsi addr c100
  if answer is 0
    match
  end
  place p102e0b
  place t102e0b_2 on 2
  set h_r13 to unwind
  set h_rsi to addr c110
  call eng_internal_dict_lookup h_rsi addr c100
  if answer is not 0
    give up
  end
  match
end

