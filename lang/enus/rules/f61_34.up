# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule find_eng_nucleus takes 1
  instead
  local h_rcx
  variable g300 word 420
  variable g320 word 436
  variable g330 word 444
  place p95ed0
  place p95efd
  place p95f51
  call fence 0 sym eti_null
  call fence 1 sym eti_s_1bd69b
  call starttest 1
  call lpta_loadp addr g300
  call setscan_r 2
  if answer is not 0
    go to p96006
  end
  place p95f95
  go to p95f9c
  place p95f9c
  place t95f9c_2 on 2
  call bspush_ca_scan 3
  call bspush_ca_scan 4
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p95fc2
  place t95fc2_4 on 4
  call savescptr 4 addr g320
  set h_rcx to 1
  call testFldeq 2 1 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p95fe8
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p95ff4
  place t95ff4_5 on 5
  call savescptr 5 addr g330
  place p96006
  place t96006_1 on 1
  call starttest 6
  if global half 2462 is not global half 2458
    match
  end
  place p96025
  call lpta_loadp addr g330
  call setscan_r 2
  if answer is not 0
    match
  end
  place p9603f
  call bspush_ca_scan 7
  set h_rcx to 5
  place p96052
  call testFldeq 2 4 h_rcx
  if answer is 0
    go to p960af
  end
  set unwind to 0
  backtrack
  place p96094
  place t96094_3 on 3
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p960a0
  go to p95f9c
  place p960a5
  place t960a5_7 on 7
  set h_rcx to 3
  go to p96052
  place p960af
  place t960af_8 on 8
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p960bb
  call bspush_ca_scan 9
  set h_rcx to 3
  call testFldeq 2 4 h_rcx
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p960db
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p960eb
  place t960eb_9 on 9
  call savescptr 9 addr g330
  match
  place tm_6 on 6
  match
end

rule assign_eng_nuc_durs takes 1
  instead
  place p96130
  place p96163
  place p96192
  call fence 0 sym eti_null
  call start_dur
  call phrase_medial_dur
  if answer is 0
    go to p961c3
  end
  place p961bb
  call phrase_final_dur
  place p961c3
  call dur_adjustments
  call distribute_nucdur
  match
end

