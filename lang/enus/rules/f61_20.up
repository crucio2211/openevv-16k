rule print_between_word_chars takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  variable g4d8 word 716
  place p42e4c
  place p42e8f
  place p42ec2
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call print_after_word_chars addr c110 addr c100
  call lpta_loadpn addr c110
  call rpta_loadpn addr g4d8
  call compare_ptas
  if answer is not 0
    go to p42f5d
  end
  place p42f3f
  call testneq
  if answer is not 0
    go to p42f5d
  end
  place p42f4b
  call print_lit 8 sym eti_s_1b5b62
  place p42f5d
  match
end

