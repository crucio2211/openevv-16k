# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule print_spr takes 1
  instead
  local c100 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c150 bytes 8
  local v108 word
  local v110 word
  local v118 word
  local h_r14
  local h_rax
  local h_rcx
  local h_rsi
  local s429d5
  local s42a81
  local s42a9d
  local s42c6e
  local s42ca5
  local s42cd4
  local s42cfb
  local s42d0e
  local k42a1c_0
  variable g4c8 word 708
  variable g4d8 word 716
  variable g578 word 796
  variable g628 word 884
  variable g638 word 892
  place p42850
  place p42885
  place p428e5
  set h_rax to addr c130
  and 0 into cell c130 half 0
  set c130 to -65529
  set h_r14 to addr c150
  set h_rsi to addr c150
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c140
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_rsi to 1
  call startloop h_rsi
  set h_rax to answer
  set h_rsi to addr g578
  set v118 to addr g578
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 2
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr g628
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to addr g4d8
  set v110 to addr g4d8
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 2
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c150
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rax to addr g4c8
  set v108 to addr g4c8
  set h_rax to 4
  set h_r14 to 0
  place p429c8
