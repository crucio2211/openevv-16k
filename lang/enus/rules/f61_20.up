  call print_lit h_rsi sym eti_s_1b5b6b
  set h_rax to answer
  set h_rsi to 18
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr g638
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to 4
  call lpta_mover h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call lpta_storep h_rsi
  set h_rax to answer
  set h_rsi to addr g638
  call print_between_word_chars h_rsi addr c100
  set s42c6e to answer
  set h_rax to s42c6e
  set h_rsi to h_r14
  if h_rax is not 0
    set unwind to h_rsi
