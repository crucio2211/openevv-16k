  place p42c83
  place t42c83_12 on 12
  set h_r14 to unwind
  set h_rsi to 12
  call savescptr h_rsi addr c100
  set h_rax to answer
  place p42c95
  place t42c95_13 on 13
  set h_r14 to unwind
  set h_rsi to 13
  set h_rcx to sym eti_s_1b9193
  call test_synch h_rsi 1 h_rcx
  set s42ca5 to answer
  set h_rax to s42ca5
  set h_rsi to h_r14
