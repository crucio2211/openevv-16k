    go to p42a25
  end
  place p42a01
  set h_rsi to 4
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  set h_rsi to 2
  set h_rcx to 51
  call testFldeq h_rsi 0 h_rcx
  set h_rax to answer
  set k42a1c_0 to h_rax
  set h_rax to 1
  if k42a1c_0 is 0
    set h_r14 to 1
  end
  place p42a25
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place p42a61
  place t42a61_3 on 3
  set h_r14 to unwind
  set h_rcx to addr c150
  set h_rsi to 1
  set h_rcx to 21
  call forto_adv_upto_r h_rsi 2 h_rcx 2 addr g628 addr c150
  set s42a81 to answer
  set h_rax to s42a81
  set h_rsi to h_r14
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  match
  place p42a92
  place t42a92_4 on 4
  set h_r14 to unwind
  call bspop_boa
  set h_rax to answer
  call advance_tok
  set s42a9d to answer
  set h_rax to s42a9d
  set h_rsi to h_r14
