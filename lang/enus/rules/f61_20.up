rule print_after_word_chars takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local h_r12
  local h_rax
  local h_rcx
  local h_rdx
  local h_rsi
  local s43588
  local s435da
  local s43649
  local s4366a
  local s4369d
  local s43874
  local s438a4
  place p43420
  set h_r12 to arg 1
  place p4345b
  place p434bb
  set h_rsi to addr c130
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_r12 to addr c140
  set h_rsi to addr c140
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  call push_ptr_init h_rsi
  set h_rax to answer
