# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule set_eng_global_constants takes 1
  instead
  place p4ca03
  place p4ca36
  place p4ca65
  call fence 0 sym eti_null
  and 0 into global half 2462
  set global half 2474 to 1
  set global half 4226 to 1
  set global half 4230 to 2
  match
end

rule init_eng_vars takes 1
  instead
  place p4cabf
  place p4caf2
  place p4cb21
  call fence 0 sym eti_null
  and 0 into global half 2698
  set global half 3626 to global half 3630
  set global half 2458 to global half 2462
  match
end

rule reset_eng_sent_vars takes 1
  instead
  place p4cb7c
  place p4cbaf
  place p4cbde
  call fence 0 sym eti_null
  match
end

rule init_eng_symbolic_vars takes 1
  instead
  local h_r12
  local h_rax
  variable g528 word 756
  place p4cc15
  place p4cc4a
  place p4ccaa
  call fence 0 sym eti_null
  call init_eng_morph_vars
  set h_rax to answer
  go to p4cccc
  place t4cccc_1 on 1
  set h_r12 to 1
  place p4cccc
  call starttest 2
  set h_rax to answer
  call bspush_ca 3
  set h_rax to answer
  call lpta_loadp addr g528
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4ccf4
  call testFldeq 4 4 3
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4cd09
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4cd15
  set h_r12 to 1
  go to p4cd89
  go to p4cd4f
  place t4cd4f_3 on 3
  set h_r12 to 1
  place p4cd4f
  call lpta_loadp addr g528
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4cd61
  call testFldeq 4 4 4
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4cd76
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4cd82
  go to p4cd89
  go to p4cd84
  place t4cd84_2 on 2
  set h_r12 to 1
  place p4cd84
  set h_rax to 0
  set h_r12 to 0
  go to p4cd89
  place t4cd89_4 on 4
  set h_r12 to 1
  place p4cd89
  set global half 4186 to h_r12
  go to p4cd91
  place t4cd91_5 on 5
  set h_r12 to 1
  place p4cd91
  and 0 into global half 2718
  and 0 into global half 2710
  and 0 into global half 4206
  set global word 2704 to 0
  and 0 into global half 4210
  and 0 into global half 4242
  call starttest 6
  set h_rax to answer
  call lpta_loadp addr g528
  call setscan_r 4
  set h_rax to answer
  if h_rax is 0
    go to p4ce26
  end
  go to p4cdde
  place t4cdde_6 on 6
  set h_r12 to 1
  place p4cdde
  call starttest 8
  set h_rax to answer
  call lpta_loadp addr g528
  call setscan_r 4
  set h_rax to answer
  if h_rax is not 0
    go to p4ce58
  end
  place p4cdfb
  call testFldeq 4 4 2
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4ce14
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4ce24
  go to p4ce70
  place p4ce26
  call testFldeq 4 4 1
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4ce3f
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p4ce4f
  set h_rax to global half 3634
  go to p4ce77
  go to p4ce58
  place t4ce58_8 on 8
  set h_r12 to 1
  place p4ce58
  set h_rax to 0
  place p4ce5a
  set global half 4234 to h_rax
  match
  place p4ce70
  set h_rax to global half 3638
  place p4ce77
  go to p4ce5a
  place tm_7 on 7
  match
end

rule init_eng_morph_vars takes 1
  instead
  place p4cea4
  place p4cedb
  place p4cf0a
  call fence 0 sym eti_null
  and 0 into global half 2682
  and 0 into global half 4202
  set global half 2686 to 1
  set global half 4170 to 1
  and 0 into global half 2726
  and 0 into global half 4178
  and 0 into global half 4174
  set global half 4182 to 1
  and 0 into global half 4222
  match
end

