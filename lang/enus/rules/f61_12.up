# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule process_annotation takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c128 bytes 8
  local v118 word
  local h_r14
  local h_rcx
  local h_rsi
  local s1a11e
  local s1a13d
  local s1a196
  local s1a254
  local s1a37c
  local s1a39f
  local s1a3c2
  local s1a3e5
  local s1a408
  local s1a4af
  local s1a4dd
  place p1a027
  set h_r14 to arg 1
  place p1a066
  place p1a0c9
  set h_rsi to addr c110
  set h_rcx to -6
  call get_parm h_rsi arg 1 h_rcx
  set h_rsi to addr c128
  set h_rcx to -6
  call get_parm h_rsi arg 2 h_rcx
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  call fence 0 sym eti_null
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r 1
  set s1a11e to answer
  set h_r14 to 0
  if s1a11e is not 0
    go to p1a165
  end
  place p1a12e
  set h_rcx to sym eti_s_1b9069
  set h_rsi to 1
  call test_string_s h_rsi 1 h_rcx
  set s1a13d to answer
  set h_r14 to 0
  if s1a13d is not 0
    go to p1a165
  end
  place p1a149
  set v118 to arg 2
  set h_rcx to 2
  go to p1a1a6
  place p1a15a
  place t1a15a_1 on 1
  set h_r14 to unwind
  place p1a165
  set v118 to arg 2
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p1a186
  set h_rcx to sym eti_s_1b906a
  set h_rsi to 1
  call test_string_s h_rsi 2 h_rcx
  set s1a196 to answer
  set h_rcx to 5
  if s1a196 is not 0
    give up
  end
  place p1a1a6
  set h_rsi to h_rcx
  place p1a1bb
  call savescptr h_rsi addr c100
  place p1a1c3
  place t1a1c3_3 on 3
  set h_r14 to unwind
  set h_rsi to addr c110
  call is_afterslash_char h_rsi addr c128
  if answer is 0
    go to p1a593
  end
  place p1a1dd
  place t1a1dd_6 on 6
  set h_r14 to unwind
  set h_rsi to addr c110
  set h_rcx to addr c128
  call SPR_anno h_rsi addr c100 h_rcx
  if answer is 0
    go to p1a593
  end
  place p1a1fe
  place t1a1fe_8 on 8
  set h_r14 to unwind
  set h_rsi to addr c100
  call emphasis_anno h_rsi addr c128
  if answer is 0
    go to p1a593
  end
  place p1a218
  place t1a218_9 on 9
  set h_r14 to unwind
  set h_rsi to addr c110
  set h_rcx to addr c128
  call phr_final_anno h_rsi addr c100 h_rcx
  if answer is 0
    go to p1a593
  end
  place p1a239
  place t1a239_10 on 10
  set h_r14 to unwind
  set h_rsi to 11
  call starttest h_rsi
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_r 1
  set s1a254 to answer
  set h_rcx to h_r14
  if s1a254 is not 0
    go to p1a325
  end
  place p1a264
  set h_r14 to h_rcx
  place p1a26e
  set h_rsi to 12
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to 1
  call testFldeq h_rsi 3 h_rcx
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p1a28e
  call advance_tok
  if answer is 0
    go to p1a26e
  end
  place p1a29a
  set unwind to h_r14
  backtrack
  place p1a29c
  place t1a29c_13 on 13
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p1a264
  place p1a2da
  place t1a2da_12 on 12
  set h_r14 to unwind
  set h_rsi to 14
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to 2
  call testFldeq h_rsi 3 h_rcx
  if answer is not 0
    set unwind to h_r14
    backtrack
  end
  place p1a2fa
  call advance_tok
  if answer is 0
    go to p1a2da
  end
  place p1a306
  set unwind to h_r14
  backtrack
  place p1a308
  place t1a308_16 on 16
  place t1a308_17 on 17
  set h_r14 to unwind
  go to p1a506
  place p1a310
  place t1a310_14 on 14
  set h_r14 to unwind
  set h_rsi to 14
  call savescptr h_rsi addr c128
  place p1a31e
  place t1a31e_11 on 11
  set h_r14 to unwind
  place p1a325
  set h_rsi to addr c128
  call lpta_loadpn h_rsi
  set h_rsi to addr c100
  call rpta_loadpn h_rsi
  call compare_ptas
  if answer is not 0
    go to p1a369
  end
  place p1a352
  call testeq
  if answer is 0
    go to p1a41d
  end
  place p1a362
  place p1a369
  set h_rsi to addr c110
  set h_rcx to addr c128
  call phr_prediction_anno h_rsi addr c100 h_rcx
  set s1a37c to answer
  set h_rcx to h_r14
  if s1a37c is 0
    go to p1a506
  end
  place p1a38c
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call pause_anno h_rsi addr c100 h_rcx
  set s1a39f to answer
  set h_rcx to h_r14
  if s1a39f is 0
    go to p1a506
  end
  place p1a3af
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call textnorm_anno h_rsi addr c100 h_rcx
  set s1a3c2 to answer
  set h_rcx to h_r14
  if s1a3c2 is 0
    go to p1a506
  end
  place p1a3d2
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call environment_anno h_rsi addr c100 h_rcx
  set s1a3e5 to answer
  set h_rcx to h_r14
  if s1a3e5 is 0
    go to p1a506
  end
  place p1a3f5
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call voice_anno h_rsi addr c100 h_rcx
  set s1a408 to answer
  set h_rcx to h_r14
  if s1a408 is not 0
    go to p1a49c
  end
  place p1a418
  go to p1a506
  place p1a41d
  set h_rsi to addr c110
  call single_chars h_rsi addr c128
  go to p1a506
  place p1a43b
  place t1a43b_15 on 15
  set h_r14 to unwind
  go to p1a362
  place p1a447
  place t1a447_18 on 18
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p1a38c
  place p1a459
  place t1a459_19 on 19
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p1a3af
  place p1a46b
  place t1a46b_20 on 20
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p1a3d2
  place p1a47d
  place t1a47d_21 on 21
  set h_r14 to unwind
  set h_rcx to h_r14
  go to p1a3f5
  place p1a48f
  place t1a48f_22 on 22
  set h_r14 to unwind
  set h_rcx to h_r14
  place p1a49c
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call word_accent_anno h_rsi addr c100 h_rcx
  set s1a4af to answer
  set h_rcx to h_r14
  if s1a4af is not 0
    go to p1a4ca
  end
  place p1a4bb
  go to p1a506
  place p1a4bd
  place t1a4bd_23 on 23
  set h_r14 to unwind
  set h_rcx to h_r14
  place p1a4ca
  set h_r14 to h_rcx
  set h_rsi to addr c110
  set h_rcx to addr c128
  call dict_anno h_rsi addr c100 h_rcx
  set s1a4dd to answer
  set h_rcx to h_r14
  if s1a4dd is not 0
    go to p1a4f1
  end
  place p1a4e9
  go to p1a506
  place p1a4eb
  place t1a4eb_24 on 24
  set h_r14 to unwind
  set h_rcx to h_r14
  place p1a4f1
  set h_r14 to h_rcx
  set h_rsi to addr c110
  call handle_invalid_anno h_rsi addr c128
  place p1a506
  set h_rsi to 7
  call starttest h_rsi
  set h_rsi to 25
  call bspush_ca_boa h_rsi
  set h_rsi to addr c128
  call legal_end_of_anno h_rsi
  if answer is 0
    set h_r14 to 1
  end
  set unwind to h_r14
  backtrack
  place p1a539
  place t1a539_2 on 2
  set h_r14 to unwind
  set h_rsi to 2
  go to p1a1bb
  place p1a548
  place t1a548_5 on 5
  set h_r14 to unwind
  set h_rcx to 5
  go to p1a1a6
  place p1a559
  place t1a559_25 on 25
  set h_r14 to unwind
  call bspop_boa
  call lpta_loadp addr c128
  set h_rcx to sym eti_s_1b906c
  set h_rsi to 1
  call insert_r h_rsi 2 h_rcx 0
  place p1a593
  place t1a593_7 on 7
  set h_r14 to unwind
  set h_rcx to arg 2
  put cell c128 value into arg 2 at 4
  set h_r14 to 0
  match
end

rule is_afterslash_char takes 3
  instead
  local c100 bytes 8
  local c110 bytes 8
  place p1a614
  place p1a657
  place p1a68a
  call get_parm addr c110 arg 1 -6
  call get_parm addr c100 arg 2 -6
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c110
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p1a6e1
  call testFldeq 1 2 0
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1a6f5
  call advance_tok
  if answer is 0
    go to p1a725
  end
  set unwind to 0
  backtrack
  place p1a725
  call single_chars_to_punct addr c110 addr c100
  place p1a73b
  place t1a73b_2 on 2
  place t1a73b_3 on 3
  put cell c100 value into arg 2 at 4
  match
end

rule SPR_anno takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  variable gb00 word 1652
  place p1a77b
  place p1a7c1
  place p1a7f4
  call get_parm addr c110 arg 1 -6
  call get_parm addr c130 arg 2 -6
  call get_parm addr c100 arg 3 -6
  call push_ptr_init addr c120
  call fence 0 sym eti_null
  call lpta_loadp addr c130
  call setscan_r 1
  if answer is not 0
    give up
  end
  place p1a867
  call test_string_s 1 1 sym eti_s_1b9091
  if answer is not 0
    give up
  end
  place p1a87f
  call savescptr 2 addr c120
  call handle_SPR addr c110 addr c120 addr c100 addr gb00
  if answer is 0
    go to p1a8d0
  end
  place p1a8b8
  call handle_invalid_anno addr c110 addr c100
  go to p1a8de
  place p1a8d0
  set global half 1642 to global half 1662
  place p1a8de
  put cell c100 value into arg 3 at 4
  match
end

rule emphasis_anno takes 3
  instead
  local cf0 bytes 8
  local c100 bytes 8
  local c110 bytes 8
  local h_rax
  local h_rdx
  local h_rsi
  variable g7b8 word 1084
  variable gc98 word 2060
  variable gc9c word 2064
  variable gca4 word 2072
  variable gcac word 2080
  variable gcb0 word 2084
  variable gcb4 word 2088
  variable ged0 word 2532
  place p1a91e
  place p1a959
  place p1a9b9
  set h_rsi to addr c110
  set h_rdx to arg 1
  call get_parm h_rsi h_rdx -6
  set h_rax to answer
  set h_rsi to addr c100
  set h_rdx to arg 2
  call get_parm h_rsi h_rdx -6
  set h_rax to answer
  set cell cf0 kind to 65532
  call fence 0 sym eti_null
  and 0 into cell cf0 field
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rdx to 1
  set h_rsi to addr c110
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to p1ac25
  end
  place p1aa24
  set h_rsi to 1
  set h_rdx to 3
  call testFldeq h_rsi h_rdx 2
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p1aa3d
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p1aa4d
  set h_rsi to addr g7b8
  call savetok h_rsi
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p1aa64
  go to p1aa6b
  place p1aa6b
  place t1aa6b_2 on 2
  set h_rsi to 2
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx sym eti_s_1b906e
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place p1aa99
  set h_rsi to addr g7b8
  set h_rdx to addr cf0
  call token_to_number h_rsi h_rdx
  set h_rax to answer
  set h_rax to cell cf0 field
  if h_rax is above 4
    go to p1ab54
  end
  place p1aac1
  if h_rax is 0
    go to p1ab35
  end
  if h_rax is 1
    go to p1aad1
  end
  if h_rax is 2
    go to p1aaea
  end
  if h_rax is 3
    go to p1ab03
  end
  if h_rax is 4
    go to p1ab1c
  end
  give up
  place p1aad1
  set h_rsi to addr ged0
  set global half 2534 to 7
  set h_rdx to addr gc9c
  go to p1ab4c
  place p1aaea
  set h_rsi to addr ged0
  set global half 2534 to 7
  set h_rdx to addr gc98
  go to p1ab4c
  place p1ab03
  set h_rsi to addr ged0
  set global half 2534 to 7
  set h_rdx to addr gcb0
  go to p1ab4c
  place p1ab1c
  set h_rsi to addr ged0
  set global half 2534 to 7
  set h_rdx to addr gcb4
  go to p1ab4c
  place p1ab35
  place t1ab35_3 on 3
  set h_rsi to addr ged0
  set global half 2534 to 7
  set h_rdx to addr gca4
  place p1ab4c
  call copyvar h_rsi h_rdx
  set h_rax to answer
  place p1ab54
  place t1ab54_4 on 4
  place t1ab54_5 on 5
  place t1ab54_6 on 6
  place t1ab54_7 on 7
  place t1ab54_8 on 8
  set global half 2534 to 7
  set h_rsi to addr ged0
  call npush_v h_rsi
  set h_rax to answer
  set h_rsi to addr gc98
  call npush_v h_rsi
  set h_rax to answer
  call if_testlt
  set h_rax to answer
  if h_rax is not 0
    go to p1ace5
  end
  place p1ab8e
  set h_rsi to 1
  call npush_s h_rsi
  set h_rax to answer
  set global half 2534 to 9
  set h_rsi to addr ged0
  call npop h_rsi
  set h_rax to answer
  set h_rax to global half 3626
  if global half 3638 is h_rax
    go to p1ace5
  end
  place p1abc1
  if global half 3658 is h_rax
    go to p1ace5
  end
  place p1abce
  set global half 2534 to 7
  set h_rsi to addr ged0
  call npush_v h_rsi
  set h_rax to answer
  set h_rsi to addr gcb0
  call npush_v h_rsi
  set h_rax to answer
  call if_testlt
  set h_rax to answer
  if h_rax is not 0
    go to p1ace5
  end
  place p1ac01
  set h_rsi to 3
  call npush_s h_rsi
  set h_rax to answer
  set global half 2534 to 8
  set h_rsi to addr ged0
  call npop h_rsi
  set h_rax to answer
  go to p1ad48
  place p1ac25
  place t1ac25_1 on 1
  set h_rsi to 11
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p1ac4a
  set h_rsi to 1
  set h_rdx to 2
  call test_string_s h_rsi h_rdx sym eti_s_1b906f
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place p1ac67
  place t1ac67_12 on 12
  set h_rsi to 12
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  set h_rax to answer
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx sym eti_s_1b906e
  set h_rax to answer
  if h_rax is 0
    go to p1acc6
  end
  set unwind to 0
  backtrack
  place p1acc6
  set h_rsi to addr ged0
  set global half 2534 to 7
  set h_rdx to addr gcac
  call copyvar h_rsi h_rdx
  set h_rax to answer
  place p1ace5
  place t1ace5_9 on 9
  place t1ace5_10 on 10
  set global half 2534 to 10
  set h_rsi to addr ged0
  call npush_v h_rsi
  set h_rax to answer
  set h_rsi to 0
  call ncompare_s h_rsi
  set h_rax to answer
  call testeq
  set h_rax to answer
  if h_rax is 0
    go to p1ad4c
  end
  place p1ad16
  place t1ad16_13 on 13
  set global half 2534 to 10
  set h_rsi to addr ged0
  call npush_v h_rsi
  set h_rax to answer
  set h_rsi to 2
  call ncompare_s h_rsi
  set h_rax to answer
  call testeq
  set h_rax to answer
  if h_rax is not 0
    go to p1ad6d
  end
  place p1ad48
  set h_rax to 3
  go to p1ad4e
  place p1ad4c
  set h_rax to 1
  place p1ad4e
  set h_rsi to h_rax
  call npush_s h_rsi
  set h_rax to answer
  set global half 2534 to 10
  set h_rsi to addr ged0
  call npop h_rsi
  set h_rax to answer
  place p1ad6d
  place t1ad6d_14 on 14
  set h_rax to cell c100 value
  put h_rax into arg 2 at 4
  match
end

rule phr_final_anno takes 4
  instead
  local c100 bytes 8
  local c110 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local h_r12
  local h_r15
  local h_rax
  local h_rcx
  local h_rdx
  local h_rsi
  variable gdd0 word 2316
  place p1add4
  set h_r15 to arg 2
  set h_r12 to arg 1
  place p1ae16
  place p1ae79
  set h_rsi to addr c140
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_r12 to addr c130
  set h_rsi to addr c130
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c100
  set h_rdx to arg 3
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c110
  call push_ptr_init h_rsi
  set h_rax to answer
  call fence 0 sym eti_null
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rdx to 1
  set h_rsi to addr c130
  call lpta_loadp h_rsi
  call setscan_r h_rdx
  set h_rax to answer
  set h_r15 to 0
  if h_rax is 0
    go to p1af0b
  end
  place p1af05
  go to p1af5c
  place p1af0b
  set h_rcx to sym eti_s_1b9071
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    go to p1af5c
  end
  place p1af27
  set h_rsi to 2
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rcx to sym eti_s_1b9071
  set h_rdx to 1
  set h_rsi to 1
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rdx to 0
  set h_rsi to 0
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p1af52
  go to p1b006
  go to p1af5c
  place t1af5c_1 on 1
  set h_rax to unwind
  set h_r12 to unwind
  set h_r15 to unwind
  set h_rcx to unwind
  set h_rdx to unwind
