rule phrase_level_printouts takes 1
  instead
  variable g588 word 804
  variable g598 word 812
  place p21ef4
  place p21f21
  place p21f75
  call fence 0 sym eti_null
  if global half 2398 is not 3
    match
  end
  place p21f87
  call print_normalized_inp addr g588 addr g598
  match
end

rule init_gcat_vars takes 1
  instead
  place p21fae
  place p21fdb
  place p2202f
  call fence 0 sym eti_null
  and 0 into global half 2102
  if global half 3630 is not global half 3626
    match
  end
  place p2204f
  set global half 2694 to 1
  set global half 2698 to 1
  match
end

rule reset_gcat_vars takes 1
  instead
  place p22072
  place p220a3
  place p220ff
  call fence 0 sym eti_null
  call starttest 1
  call bspush_ca 2
  if global half 3630 is not global half 3626
    go to p22165
  end
  place p2212d
  place t2212d_3 on 3
  call init_word_ptrs
  place p22135
  place t22135_1 on 1
  if global half 3630 is not global half 3626
    match
  end
  place p22145
  set global half 2694 to 2
  and 0 into global half 2698
  match
  place p22165
  set unwind to 0
  backtrack
  place p2219e
  place t2219e_2 on 2
  if global half 3638 is not global half 3626
    set unwind to 0
    backtrack
  end
  place p221ae
  go to p2212d
  place tm_4 on 4
  match
end

rule print_normalized_inp takes 3
  instead
