# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule noun_cmpnd1 takes 6
  instead
  local c104 bytes 8
  local c128 bytes 8
  local c138 bytes 8
  local c148 bytes 8
  local c158 bytes 8
  local vf8 word
  local v100 word
  local v110 word
  local v118 word
  local h_rdx
  variable g218 word 280
  variable g228 word 288
  place p51367
  set v110 to arg 4
  place p513b6
  set vf8 to state
  place p513fb
  set v118 to arg 5
  set h_rdx to arg 1
  call get_parm addr c158 h_rdx -6
  set h_rdx to arg 2
  call get_parm addr c148 h_rdx -6
  set h_rdx to arg 3
  call get_parm addr c138 h_rdx -6
  set h_rdx to arg 4
  call get_parm addr c128 h_rdx -6
  set h_rdx to arg 5
  call get_parm addr c104 h_rdx -4
  call fence 0 sym eti_null
  call starttest 38
  set h_rdx to addr c148
  call lpta_rpta_loadp addr c158 h_rdx
  set h_rdx to 0
  call actd_lookup 0 h_rdx 0
  if answer is 0
    go to p5150d
  end
  give up
  place p5150d
  set v100 to addr g228
  place p51537
  place t51537_39 on 39
  set h_rdx to addr c138
  call copyvar addr g218 h_rdx
  set h_rdx to addr c128
  call copyvar addr g228 h_rdx
  call actd_goto
  set unwind to 0
  backtrack
  place p515ab
  place t515ab_1 on 1
  set h_rdx to addr g228
  call lpta_rpta_loadp addr g218 h_rdx
  set h_rdx to 7
  go to p51a3a
  place p515cb
  place t515cb_2 on 2
  set h_rdx to addr g228
  call lpta_rpta_loadp addr g218 h_rdx
  set h_rdx to 8
  go to p51a3a
