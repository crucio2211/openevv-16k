  set h_rdx to 39
  go to p51a3a
  place p519c8
  place t519c8_34 on 34
  set h_rdx to addr g228
  call lpta_rpta_loadp addr g218 h_rdx
  set h_rdx to 40
  go to p51a3a
  place p519e5
  place t519e5_35 on 35
  set h_rdx to addr g228
  call lpta_rpta_loadp addr g218 h_rdx
  set h_rdx to 41
  go to p51a3a
  place p51a02
  place t51a02_36 on 36
  set h_rdx to addr g228
  call lpta_rpta_loadp addr g218 h_rdx
  set h_rdx to 42
  go to p51a3a
  place p51a1f
  place t51a1f_37 on 37
  set h_rdx to addr g228
  call lpta_rpta_loadp addr g218 h_rdx
  set h_rdx to 43
  place p51a3a
  call setd_lookup 1 h_rdx
  if answer is not 0
    go to p51a5b
  end
  place p51a52
  place t51a52_40 on 40
  place t51a52_42 on 42
  place t51a52_43 on 43
  place t51a52_45 on 45
  place t51a52_47 on 47
  place t51a52_49 on 49
  place t51a52_51 on 51
  place t51a52_53 on 53
  place t51a52_55 on 55
