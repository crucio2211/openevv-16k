  set h_rax to answer
  set h_rsi to addr c110
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_r14 to 0
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rax to answer
  set h_rsi to 1
  call starttest h_rsi
  set h_rax to answer
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  set h_rax to answer
  set h_rsi to addr c100
  call lpta_loadp h_rsi
  call setscan_l 4
  set h_rax to answer
