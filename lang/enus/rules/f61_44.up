  set h_r14 to unwind
  call advance_tok
  set s14627f to answer
  set h_rax to s14627f
  set h_rsi to h_r14
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p14628f
  set h_rsi to addr c100
  call lpta_rpta_loadp h_rsi addr c110
  set h_rax to answer
  set h_rsi to 5
