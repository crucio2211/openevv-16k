  set h_rax to answer
  go to p1461c8
  place p146164
  place t146164_4 on 4
  set h_r14 to unwind
  call bspush_nboa
  set h_rax to answer
  set h_rsi to 8
  call bspush_ca_scan_boa h_rsi
  set h_rax to answer
  place p146177
  place t146177_9 on 9
  set h_r14 to unwind
  set h_rsi to 9
  set h_rcx to sym eti_s_1be6b8
  call test_synch h_rsi 1 h_rcx
  set s146187 to answer
  set h_rax to s146187
  go to p146220
  place p146191
  place t146191_6 on 6
  set h_r14 to unwind
  call bspop_boa
  set h_rax to answer
  set h_rsi to 4
  set h_rcx to 1
  call testFldeq h_rsi 1 h_rcx
  set s1461a5 to answer
  set h_rax to s1461a5
  set h_rsi to h_r14
  if h_rax is not 0
    set unwind to h_rsi
    backtrack
  end
  place p1461b5
  call advance_tok
  set s1461b8 to answer
  set h_rax to s1461b8
  set h_rsi to h_r14
  if h_rax is not 0
