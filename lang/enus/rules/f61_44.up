  call setscan_r 4
  if answer is not 0
    give up
  end
  place p1524b6
  call testFldeq 4 1 13
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p1524cb
  call advance_tok
  if answer is 0
    go to p1524f6
  end
  set unwind to 0
  backtrack
  place p1524f6
  place t1524f6_2 on 2
  call savescptr 2 addr c100
  call is_noun_phrase addr c100 addr c110
  if answer is 0
    match
  end
  give up
end
