# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule eng_non_phrasal_comma takes 2
  instead
  local c100 bytes 8
  local c110 bytes 8
  variable g6c8 word 964
  variable g6e8 word 980
  variable g6f8 word 988
  place p145844
  place p14587c
  place p1458e0
  call get_parm addr c100 arg 1 -6
  call push_ptr_init addr c110
  call fence 0 sym eti_null
  call starttest 1
  call lpta_loadp addr c100
  call setscan_l 4
  if answer is not 0
    go to p1459f6
  end
  place p145939
  place p145955
  place t145955_2 on 2
  call savescptr 2 addr c110
  call advance_tok
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p14596f
  place t14596f_3 on 3
  call savescptr 3 addr g6c8
  call lpta_loadp addr c110
  call setscan_r 4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p14598f
  call advanc
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p14599b
  place t14599b_4 on 4
  call savescptr 4 addr g6e8
  call advance_tok
  if answer is 0
    go to p1459e4
  end
  set unwind to 0
  backtrack
  place p1459e4
  place t1459e4_5 on 5
  call savescptr 5 addr g6f8
  place p1459f6
  place t1459f6_1 on 1
  call misc_non_phrasal_comma addr c100 addr g6e8 addr g6f8
  if answer is 0
    match
  end
  place p145a1e
  place t145a1e_6 on 6
  call prenom_adj_series addr c100
  if answer is 0
    match
  end
  place p145a31
  place t145a31_8 on 8
  call city_state addr g6c8 addr c100 addr g6e8 addr g6f8
  if answer is not 0
    give up
  end
  match
  place tm_7 on 7
  match
end

