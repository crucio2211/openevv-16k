  set h_r14 to unwind
  call bspop_boa
  set h_rax to answer
  place p146236
  place t146236_10 on 10
  set h_r14 to unwind
  set h_rsi to 10
  call savescptr h_rsi addr c110
  set h_rax to answer
  set h_rsi to 11
  call bspush_ca_scan h_rsi
  set h_rax to answer
  set h_rsi to 4
  set h_rcx to 10
  go to p14626c
  place p146261
