  set h_r14 to h_rax
  place p1460b6
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place p1460f9
  place t1460f9_1 on 1
  set h_r14 to unwind
  set h_rsi to 3
  call starttest h_rsi
  set h_rax to answer
