# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule split_final_compound takes 1
  instead
  local c100 bytes 8
  local v108 word
  local h_r12
  local h_rcx
  local h_rdx
  local h_rsi
  local sac0b4
  local sac1a6
  local sac1b9
  local sac1cc
  local sac1f9
  local sac269
  local sac295
  local sac2a8
  variable g668 word 916
  variable g678 word 924
  place pabfd4
  place pac009
  place pac069
  set h_rsi to addr c100
  call push_ptr_init h_rsi
  set h_rdx to sym eti_null
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rdx to sym eti_s_1bd6df
  set h_rsi to 1
  call fence h_rsi h_rdx
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  call potential_compound
  set sac0b4 to answer
  set h_rcx to 0
  set h_rcx to 0
  if sac0b4 is 0
    set h_rcx to 1
  end
  set v108 to addr g668
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place pac116
  place tac116_1 on 1
  set h_r12 to unwind
  set h_rsi to addr g668
  set h_rdx to addr g678
  call compounds h_rsi h_rdx
  if answer is 0
    match
  end
  place pac130
  place tac130_4 on 4
  set h_r12 to unwind
  set h_rsi to 5
  call starttest h_rsi
  set h_rsi to addr g678
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  if answer is not 0
    give up
  end
  place pac151
  call advance_tok
  if answer is not 0
    give up
  end
  place pac161
  call advance_tok
  if answer is 0
    go to pac17d
  end
  give up
  place pac172
  set h_rsi to 6
  call bspush_ca_scan h_rsi
  place pac17d
  place tac17d_7 on 7
  set h_r12 to unwind
  call advance_tok
  if answer is 0
    go to pac172
  end
  place pac189
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place pac191
  place tac191_6 on 6
  set h_r12 to unwind
  set h_rsi to 6
  set h_rdx to addr c100
  call savescptr h_rsi h_rdx
  call advance_tok
  set sac1a6 to answer
  set h_rsi to h_r12
  if sac1a6 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac1b6
  call advance_tok
  set sac1b9 to answer
  set h_rsi to h_r12
  if sac1b9 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac1c9
  call advance_tok
  set sac1cc to answer
  set h_rsi to h_r12
  if sac1cc is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac1dc
  set h_rsi to addr c100
  set h_rdx to addr g678
  call lpta_rpta_loadp h_rsi h_rdx
  set h_rsi to 1
  set h_rdx to 361
  call setd_lookup h_rsi h_rdx
  set sac1f9 to answer
  set h_rsi to h_r12
  if sac1f9 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac209
  set h_rsi to 8
  call starttest h_rsi
  set h_rsi to addr c100
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  if answer is not 0
    go to pac2c5
  end
  place pac22e
  call bspush_boa
  go to pac27e
  place pac238
  place tac238_9 on 9
  set h_r12 to unwind
  set h_rsi to 1
  set h_rdx to 0
  set h_rcx to 73
  go to pac294
  place pac244
  place tac244_11 on 11
  set h_r12 to unwind
  call bspush_nboa
  call lpta_loadp addr g668
  call test_ptr
  set sac269 to answer
  set h_rsi to h_r12
  if sac269 is not 0
    set unwind to h_rsi
    backtrack
  end
  give up
  place pac27e
  place tac27e_12 on 12
  set h_r12 to unwind
  set h_rsi to 9
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rdx to 4
  set h_rcx to 2
  place pac294
  call testFldeq h_rsi h_rdx h_rcx
  set sac295 to answer
  set h_rsi to h_r12
  if sac295 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac2a5
  place tac2a5_10 on 10
  set h_r12 to unwind
  call advance_tok
  set sac2a8 to answer
  set h_rsi to h_r12
  if sac2a8 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac2b8
  set h_rsi to 11
  call bspush_ca_scan h_rsi
  go to pac27e
  place pac2c5
  place tac2c5_8 on 8
  set h_r12 to unwind
  set h_rsi to addr c100
  call insert_compound h_rsi
  match
  place pac2e3
  place tac2e3_2 on 2
  set h_r12 to unwind
  call bspop_boa
  give up
  place tm_3 on 3
  place tm_13 on 13
  match
end

rule potential_compound takes 1
  instead
  local h_r12
  variable g668 word 916
  variable g678 word 924
  place pac32c
  place pac361
  place pac3c1
  set h_r12 to 0
  call fence 0 sym eti_null
  call fence 1 sym eti_s_1bd6df
  if global half 4182 is 0
    give up
  end
  place pac3f6
  go to pac404
  place tac404_1 on 1
  set h_r12 to unwind
  place pac404
  call starttest 2
  call bspush_ca_boa 3
  call lpta_loadp addr g668
  call setscan_r 1
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  place pac42c
  call advance_tok
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  place pac438
  call advance_tok
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  place pac444
  call advance_tok
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  place pac450
  call advance_tok
  if answer is not 0
    set unwind to h_r12
    backtrack
  end
  place pac45c
  call advance_tok
  if answer is 0
    set h_r12 to 1
  end
  set unwind to h_r12
  backtrack
  go to pac4a7
  place tac4a7_2 on 2
  set h_r12 to unwind
  place pac4a7
  call one_eng_syllable addr g668 addr g678
  if answer is 0
    give up
  end
  go to pac4c1
  place tac4c1_4 on 4
  set h_r12 to unwind
  place pac4c1
  call lpta_rpta_loadp addr g668 addr g678
  call setd_lookup 1 364
  if answer is 0
    give up
  end
  match
  go to pac4fa
  place tac4fa_3 on 3
  set h_r12 to unwind
  place pac4fa
  call bspop_boa
  give up
  place tm_5 on 5
  match
end

rule insert_compound takes 2
  instead
  local c100 bytes 8
  variable g668 word 916
  variable g678 word 924
  place pac520
  place pac558
  place pac5b8
  call get_parm addr c100 arg 1 -6
  call fence 0 sym eti_null
  set global half 2686 to 2
  set global half 4170 to 1
  call insert_root addr c100 addr g678
  set global half 4170 to 1
  and 0 into global half 4178
  set global word 928 to cell c100 value
  call eng_roots_dict_lookup addr g668 addr g678
  if answer is 0
    match
  end
  place pac645
  call strip_s
  if answer is 0
    go to pac665
  end
  place pac651
  call strip_er
  if answer is 0
    go to pac665
  end
  place pac65d
  call strip_ing
  place pac665
  call insert_root addr g668 addr g678
  match
end

rule split_initial_compound takes 1
  instead
  local c108 bytes 8
  local vf8 word
  local h_r14
  local h_rcx
  local h_rsi
  local sac76c
  local sac843
  local sac883
  local sac896
  local sac8b3
  local sac8c6
  local sac8d9
  local sac8ec
  local sac91d
  variable g668 word 916
  place pac688
  place pac6bd
  place pac71d
  set h_rsi to addr c108
  call push_ptr_init h_rsi
  set h_rsi to 0
  call fence h_rsi sym eti_null
  set h_rsi to 1
  call fence h_rsi sym eti_s_1bd6df
  set h_rsi to 1
  call starttest h_rsi
  set h_rsi to 2
  call bspush_ca_boa h_rsi
  call potential_compound
  set sac76c to answer
  set h_rcx to 0
  set h_rcx to 0
  if sac76c is 0
    set h_rcx to 1
  end
  set vf8 to addr g668
  set h_rsi to h_rcx
  set unwind to h_rsi
  backtrack
  place pac7c7
  place tac7c7_1 on 1
  set h_r14 to unwind
  set h_rsi to 4
  call starttest h_rsi
  set h_rsi to addr g668
  call lpta_loadp h_rsi
  call setscan_r 1
  if answer is not 0
    go to pac92f
  end
  place pac7ec
  call advance_tok
  if answer is not 0
    go to pac92f
  end
  place pac7fc
  call advance_tok
  if answer is 0
    go to pac818
  end
  place pac808
  go to pac92f
  place pac80d
  set h_rsi to 5
  call bspush_ca_scan h_rsi
  place pac818
  place tac818_6 on 6
  set h_r14 to unwind
  call advance_tok
  if answer is 0
    go to pac80d
  end
  place pac824
  set h_rsi to h_r14
  set unwind to h_rsi
  backtrack
  place pac82c
  place tac82c_5 on 5
  set h_r14 to unwind
  set h_rsi to 5
  call savescptr h_rsi addr c108
  go to pac853
  place pac840
  place tac840_8 on 8
  set h_r14 to unwind
  call advance_tok
  set sac843 to answer
  set h_rsi to h_r14
  if sac843 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac853
  place tac853_7 on 7
  set h_r14 to unwind
  set h_rsi to 8
  call bspush_ca_scan h_rsi
  set h_rsi to 9
  call bspush_ca_scan h_rsi
  set h_rsi to 1
  set h_rcx to 1
  go to pac883
  place pac877
  place tac877_9 on 9
  set h_r14 to unwind
  set h_rsi to 1
  set h_rcx to 3
  place pac883
  call testFldeq h_rsi 4 h_rcx
  set sac883 to answer
  set h_rsi to h_r14
  if sac883 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac893
  place tac893_10 on 10
  set h_r14 to unwind
  call advance_tok
  set sac896 to answer
  set h_rsi to h_r14
  if sac896 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac8a6
  set h_rsi to addr c108
  call lpta_loadp h_rsi
  call setscan_r 1
  set sac8b3 to answer
  set h_rsi to h_r14
  if sac8b3 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac8c3
  call advance_tok
  set sac8c6 to answer
  set h_rsi to h_r14
  if sac8c6 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac8d6
  call advance_tok
  set sac8d9 to answer
  set h_rsi to h_r14
  if sac8d9 is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac8e9
  call advance_tok
  set sac8ec to answer
  set h_rsi to h_r14
  if sac8ec is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac8fc
  set h_rsi to addr g668
  call lpta_rpta_loadp h_rsi addr c108
  set h_rsi to 1
  call setd_lookup h_rsi 362
  set sac91d to answer
  set h_rsi to h_r14
  if sac91d is not 0
    set unwind to h_rsi
    backtrack
  end
  place pac92d
  go to pac946
  place pac92f
  place tac92f_4 on 4
  set h_r14 to unwind
  set h_rsi to addr c108
  call splitCompoundAtUppercase h_rsi
  if answer is not 0
    give up
  end
  place pac946
  place tac946_3 on 3
  set h_r14 to unwind
  set h_rsi to addr c108
  call insert_compound h_rsi
  match
  place pac964
  place tac964_2 on 2
  set h_r14 to unwind
  call bspop_boa
  give up
  place tm_12 on 12
  match
end

rule splitCompoundAtUppercase takes 2
  instead
  local c100 bytes 8
  local apple_pointer_cell bytes 8
  local h_rax
  local h_rcx
  local h_rdx
  variable g668 word 916
  place pac9a8
  place pac9e4
  place paca17
  set h_rcx to -6
  set h_rdx to arg 1
  call get_parm addr c100 h_rdx h_rcx
  set h_rax to answer
  set h_rdx to sym eti_null
  call fence 0 h_rdx
  set h_rax to answer
  set h_rdx to sym eti_s_1bd6df
  call fence 1 h_rdx
  set h_rax to answer
  call starttest 1
  set h_rax to answer
  set h_rdx to 1
  call lpta_loadp addr g668
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place paca7b
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place paca8b
  set h_rcx to 1
  set h_rdx to 1
  call testFldeq 1 h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place paca9e
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacaaa
  place tacaaa_3 on 3
  go to pacabf
  place pacab4
  call bspush_ca_scan 2
  set h_rax to answer
  place pacabf
  set h_rdx to 1
  set h_rcx to 1
  call testFldeq 1 h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacad4
  call advance_tok
  set h_rax to answer
  if h_rax is 0
    go to pacab4
  end
  set unwind to 0
  backtrack
  place pacb16
  place tacb16_2 on 2
  set h_rdx to addr c100
  call savescptr 2 h_rdx
  set h_rax to answer
  set h_rdx to 1
  set h_rcx to 2
  call testFldeq 1 h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacb3c
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacb48
  set h_rcx to 1
  set h_rdx to 1
  call testFldeq 1 h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacb5b
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacb6b
  set h_rcx to 1
  set h_rdx to 1
  call testFldeq 1 h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacb82
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacb92
  place tacb92_4 on 4
  call starttest 5
  set h_rax to answer
  set h_rdx to 1
  call lpta_loadp addr g668
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pacbe9
  end
  place pacbaf
  place tacbaf_5 on 5
  call starttest 9
  set h_rax to answer
  set h_rdx to 1
  call lpta_loadp addr c100
  call setscan_r h_rdx
  set h_rax to answer
  if h_rax is not 0
    go to pacccb
  end
  place pacbd4
  place tacbd4_12 on 12
  call bspush_ca_scan 10
  set h_rax to answer
  set h_rdx to 4
  set h_rcx to 2
  go to pacc48
  place pacbe9
  place tacbe9_8 on 8
  call bspush_ca_scan 6
  set h_rax to answer
  set h_rdx to 4
  set h_rcx to 2
  go to pacc05
  place pacbfe
  place tacbfe_6 on 6
  set h_rdx to 0
  set h_rcx to 73
  place pacc05
  call testFldeq 1 h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacc16
  place tacc16_7 on 7
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacc26
  call bspush_ca_scan 8
  set h_rax to answer
  set h_rax to cell c100 value
  go to pacc82
  place pacc41
  place tacc41_10 on 10
  set h_rdx to 0
  set h_rcx to 73
  place pacc48
  call testFldeq 1 h_rdx h_rcx
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacc59
  place tacc59_11 on 11
  call advance_tok
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  place pacc69
  call bspush_ca_scan 12
  set h_rax to answer
  set h_rax to global word 928
  place pacc82
  set cell apple_pointer_cell value to h_rax
  call lpta_loadp addr apple_pointer_cell
  call test_ptr
  set h_rax to answer
  if h_rax is not 0
    set unwind to 0
    backtrack
  end
  give up
  place pacccb
  place tacccb_9 on 9
  set h_rax to cell c100 value
  put h_rax into arg 1 at 4
  match
end

rule compound_destress takes 4
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c108 bytes 8
  local c120 bytes 8
  local c130 bytes 8
  local c140 bytes 8
  local c170 bytes 8
  local c180 bytes 8
  local v110 word
  local v148 word
  local v150 word
  local v158 word
  local v160 word
  local h_r12
  local h_r14
  local h_rax
  local h_rcx
  local h_rdx
  local h_rsi
  variable g528 word 756
  variable g538 word 764
  variable gca4 word 2072
  variable gdd0 word 2316
  place pacd14
  set v150 to arg 3
  place pacd5a
  place pacd8d
  set h_r12 to addr c108
  set h_r14 to -6
  set h_rsi to addr c108
  set h_rdx to arg 1
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr c140
  set h_rdx to arg 2
  set h_rcx to -6
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set h_rsi to addr cf0
  set h_rcx to -4
  set h_rdx to arg 3
  call get_parm h_rsi h_rdx h_rcx
  set h_rax to answer
  set cell cf4 kind to 65532
  set h_rsi to addr c120
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c170
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rsi to addr c180
  call push_ptr_init h_rsi
  set h_rax to answer
  set h_rdx to sym eti_null
  set h_rsi to 0
  call fence h_rsi h_rdx
  set h_rax to answer
  set h_rdx to sym eti_s_1bd6e0
  set h_rsi to 1
  call fence h_rsi h_rdx
  set h_rax to answer
  and 0 into cell cf4 field
  set h_rsi to addr c108
  call lpta_loadpn h_rsi
  set h_rax to answer
  set h_rsi to addr gdd0
  set v160 to addr gdd0
  call rpta_loadpn h_rsi
  set h_rax to answer
  call compare_ptas
  set h_rax to answer
  if h_rax is not 0
    give up
  end
  place pace78
  call testneq
  set h_rax to answer
  if h_rax is 0
    go to paceb5
  end
  give up
  place paceb5
  set h_rsi to 2
  call startloop h_rsi
  set h_rax to answer
  set h_rax to addr g528
  set v110 to addr g528
  set h_rax to addr g538
  set v158 to addr g538
  set h_rax to addr gca4
  set v148 to addr gca4
  set h_r12 to 0
  place pacef1
  place tacef1_3 on 3
  place tacef1_43 on 43
  place tacef1_44 on 44
  set h_r12 to unwind
  set h_rax to global word 760
  set cell c120 value to h_rax
  set h_rax to global word 768
  set cell c130 value to h_rax
  set h_rsi to 4
  call starttest_l h_rsi
  set h_rax to answer
  set h_rsi to addr c130
  set h_rdx to 1
  call lpta_loadp h_rsi
  call setscan_l h_rdx
  set h_rax to answer
  if h_rax is 0
    go to pacf6c
  end
  place pacf2e
  place tacf2e_4 on 4
  set h_r12 to unwind
  set h_r14 to h_r12
  set h_rsi to addr c108
  set h_rdx to addr c140
  set h_rcx to addr c120
  call special_compounds h_rsi h_rdx h_rcx addr c130
  set h_rax to answer
  set h_r12 to addr g528
  set h_rsi to 13
  if h_rax is not 0
    go to pad227
  end
  place pacf67
  go to pad8e3
  place pacf6c
  set h_rsi to 5
  call bspush_ca_scan h_rsi
  set h_rax to answer
  place pacf77
  place tacf77_6 on 6
  set h_r12 to unwind
  set h_r14 to h_r12
  place pacf7a
  set h_rsi to 1
  set h_rdx to 1
  set h_rcx to sym eti_s_1bd6e7
  call test_string_s h_rsi h_rdx h_rcx
  set h_rax to answer
