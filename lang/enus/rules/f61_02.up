# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule init_platform takes 1
  instead
  local cf0 bytes 8
  local c108 bytes 8
  local c120 bytes 9
  local h_r15
  local s5f7f
  place p5e93
  place p5ec8
  place p5f28
  set cell c120 byte 4 to 0
  and 0 into cell c120 word 0
  and 0 into cell c108 half 0
  set c120 to -65535
  set c108 to -65536
  set cf0 to 65532
  call fence 0 sym eti_null
  call starttest 1
  call bspush_ca_boa 2
  call initializeIO
  set s5f7f to answer
  set h_r15 to 0
  set h_r15 to 0
  if s5f7f is 0
    set h_r15 to 1
  end
  set unwind to h_r15
  backtrack
  place p5fcb
  place t5fcb_1 on 1
  set h_r15 to unwind
  call turnLazyWriteOn
  place p5fd3
  place t5fd3_3 on 3
  set h_r15 to unwind
  call starttest 4
  call move_i addr cf0 2
  call setNonSequential addr cf0 addr c120 addr c108
  if answer is not 0
    set unwind to h_r15
    backtrack
  end
  place p600c
  place t600c_4 on 4
  set h_r15 to unwind
  call open_input 6
  place p6017
  place t6017_5 on 5
  set h_r15 to unwind
  call open_output 8
  place p6022
  place t6022_6 on 6
  set h_r15 to unwind
  call open_output 11
  match
  place p603c
  place t603c_2 on 2
  set h_r15 to unwind
  call bspop_boa
  give up
  place tm_7 on 7
  match
end

rule DeltaProc_flush takes 1
  instead
  place p606c
  place p609f
  place p60ce
  call fence 0 sym eti_null
  call init_delta
  and 0 into global half 1472
  call read_end
  match
end

rule read_end takes 1
  instead
  local h_r12
  local h_rsi
  local s61f6
  variable g9f8 word 1444
  place p611d
  place p6152
  place p61b2
  call fence 0 sym eti_null
  set h_rsi to 1
  call startloop h_rsi
  set h_r12 to 0
  place p61d7
  place t61d7_2 on 2
  place t61d7_3 on 3
  set h_r12 to unwind
  set h_rsi to 3
  call starttest h_rsi
  set h_rsi to 4
  call bspush_ca_boa h_rsi
  set h_rsi to 6
  call read_tvar h_rsi addr g9f8
  set s61f6 to answer
  set h_rsi to 1
  if s61f6 is 0
    set unwind to h_rsi
    backtrack
  end
  place p6202
  set h_rsi to h_r12
  set unwind to h_rsi
  backtrack
  place p623b
  place t623b_4 on 4
  set h_r12 to unwind
  call bspop_boa
  set h_rsi to addr g9f8
  call settvar_s h_rsi 90
  match
  place tm_1 on 1
  match
end

rule close_platform takes 1
  instead
  place p6265
  place p6298
  place p62c7
  call fence 0 sym eti_null
  call closeIO
  match
end

rule print_prompt takes 1
  instead
  place p6306
  place p6339
  place p6368
  call fence 0 sym eti_null
  match
end

rule PhonemeIndex takes 3
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local c118 bytes 9
  local c138 bytes 18
  local c148 bytes 8
  local c158 bytes 8
  local v100 word
  variable g4e8 word 724
  variable gef0 word 2552
  place p639f
  place p63de
  place p6441
  call get_parm addr c158 arg 1 -6
  call get_parm addr c148 arg 2 -6
  set cell c138 word 0 to 0
  set cell c138 word 4 to 0
  set cell c138 word 6 to 0
  set cell c138 word 10 to 0
  set c138 to -65534
  and 0 into cell c118 word 0
  set cell cf4 kind to 65532
  set cf0 to 65532
  set cell c118 byte 4 to 0
  set c118 to -65535
  call fence 0 sym eti_null
  and 0 into cell cf4 field
  set global half 2554 to 3
  call copyvar addr cf4 addr gef0
  call lpta_loadp addr c158
  call setscan_r 2
  if answer is not 0
    go to p6511
  end
  place p64f6
  call advance_tok
  if answer is not 0
    go to p6511
  end
  place p6502
  call savetok addr c138
  place p6511
  set v100 to addr g4e8
  place p6534
  place t6534_1 on 1
  call starttest 2
  call move_i addr cf0 0
  call placePhoneme addr c138 addr cf0 addr cf4
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p6569
  place t6569_2 on 2
  call lpta_loadpn addr c148
  call rpta_loadpn addr g4e8
  call compare_ptas
  if answer is not 0
    match
  end
  place p659a
  call testeq
  if answer is not 0
    match
  end
  place p65aa
  call settvar_s addr c118 197
  call starttest 3
  call move_i addr cf0 0
  call placePhonemeText addr c118 addr cf0 addr cf4
  if answer is 0
    match
  end
  set unwind to 0
  backtrack
  place tm_3 on 3
  match
end

rule DeltaProc_registerLanguages takes 1
  instead
  local cf0 bytes 8
  local cf4 bytes 8
  local cf8 bytes 8
  local cfc bytes 8
  local c10c bytes 8
  local c110 bytes 8
  local c114 bytes 8
  local c118 bytes 8
  local c11c bytes 8
  local v108 word
  local v128 word
  local v130 word
  variable g158 word 184
  variable g168 word 192
  place p6635
  place p666a
  place p66ca
  set cf4 to 65532
  set cf0 to 65532
  set cfc to 65532
  set cf8 to 65532
  set c10c to 65532
  set c11c to 65532
  set c118 to 65532
  set c114 to 65532
  set c110 to 65532
  call fence 0 sym eti_null
  call set_voice_param_constants
  set v130 to addr g158
  set v128 to addr g168
  set v108 to state
  place p6753
  place t6753_1 on 1
  call register_SAPI_voices
  place p675b
  place t675b_2 on 2
  set cell cfc field to 6
  set cell cf8 field to 1
  call setup_lang_reg addr cf4 addr cf0
  place p6783
  place t6783_3 on 3
  call starttest 4
  call move_i addr c10c 1
  call move_i addr c11c 1
  call move_i addr c118 1
  call move_i addr c114 1
  call move_i addr c110 1
  call registerLanguage addr cf4 addr cf0 addr cfc addr cf8 addr g158 addr g168 addr c10c addr c11c addr c118 addr c114 addr c110
  if answer is 0
    go to p6887
  end
  set unwind to 0
  backtrack
  place p6887
  place t6887_4 on 4
  call initdelta 9 sym eti_s_1b9000
  call register_voices addr cf4 addr cf0 addr cfc addr cf8
  place p68bd
  place t68bd_5 on 5
  and 0 into global half 2498
  call register_eng_phones addr cf4 addr cf0
  place p68db
  place t68db_6 on 6
  call initdelta 9 sym eti_s_1b9000
  match
end

