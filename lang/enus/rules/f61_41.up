# The rules of enus, lifted by tools/rules/lift64.py out of ETI
# Eloquence 6.1 as Apple ships it, by tools/module/lift61.py. Each says
# `instead' because it is written afresh rather than re-expressed from one of
# IBM's: nothing of IBM's is under it.

rule convert_eng_digits_to_words takes 3
  instead
  local c100 bytes 8
  local c104 bytes 8
  local c108 bytes 8
  local c118 bytes 8
  local v120 word
  place p10b76b
  place p10b7aa
  place p10b80d
  call get_parm addr c118 arg 1 -6
  set v120 to arg 2
  call get_parm addr c100 arg 2 -6
  set c108 to 65532
  set c104 to 65532
  call fence 0 sym eti_null
  call convert_eng_date addr c118 addr c100
  if answer is 0
    go to p10bada
  end
  place p10b877
  place p10b887
  place t10b887_1 on 1
  call convert_eng_day_of_month addr c118 addr c100
  if answer is 0
    go to p10bada
  end
  place p10b8a5
  place t10b8a5_3 on 3
  call convert_eng_time addr c118 addr c100
  if answer is 0
    go to p10bada
  end
  place p10b8c3
  place t10b8c3_4 on 4
  call starttest 5
  call move_i addr c108 0
  call move_i addr c104 0
  call convert_eng_monetary_exp addr c118 addr c100 addr c108 addr c104
  if answer is 0
    go to p10bada
  end
  set unwind to 0
  backtrack
  place p10b951
  place t10b951_5 on 5
  call convert_eng_phone_number addr c118 addr c100
  if answer is 0
    go to p10bada
  end
  place p10b96f
  place t10b96f_6 on 6
  if global half 2462 is not global half 2458
    go to p10b99d
  end
  place p10b97f
  call convert_SSN addr c118 addr c100
  if answer is 0
    go to p10bada
  end
  place p10b99d
  place t10b99d_7 on 7
  call starttest 8
  call lpta_loadp addr c118
  call setscan_r 1
  if answer is not 0
    go to p10ba0c
  end
  place p10b9be
  call test_string_s 1 1 sym eti_s_1be0f8
  if answer is not 0
    go to p10ba0c
  end
  place p10b9d7
  place t10b9d7_10 on 10
  call bspush_ca_scan 9
  call testFldeq 1 3 2
  if answer is not 0
    set unwind to 0
    backtrack
  end
  place p10b9fb
  call advance_tok
  if answer is 0
    go to p10b9d7
  end
  place p10ba07
  set unwind to 0
  backtrack
  place p10ba0c
  place t10ba0c_8 on 8
  call identify_eng_year addr c118 addr c100
  if answer is 0
    go to p10ba7c
  end
  place p10ba26
  place t10ba26_12 on 12
  call convert_digits addr c118 addr c100
  go to p10ba7c
  place p10ba47
  place t10ba47_9 on 9
  call savescptr 9 addr c100
  call single_chars addr c118 addr c100
  place p10ba6e
  place t10ba6e_11 on 11
  set global half 1642 to global half 1670
  place p10ba7c
  place t10ba7c_2 on 2
  if global half 1874 is global half 1850
    go to p10bada
  end
  place p10ba8c
  place t10ba8c_13 on 13
  call trailing_suffix addr c100 addr c100
  if answer is 0
    go to p10bada
  end
  place p10baa2
  place t10baa2_15 on 15
  if global half 1882 is global half 1850
    go to p10bada
  end
  place p10bab2
  place t10bab2_16 on 16
  call add_eng_point_digits addr c100 addr c100
  if answer is 0
    go to p10bada
  end
  place p10bac8
  place t10bac8_17 on 17
  call convert_eng_fraction addr c100 addr c100
  place p10bada
  place t10bada_14 on 14
  put cell c100 value into arg 2 at 4
  match
end

